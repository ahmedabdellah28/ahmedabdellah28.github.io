---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SkillProof from '../../components/SkillProof.astro';
import CTA from '../../components/CTA.astro';
import { SITE_CONFIG, UI_LABELS } from '../../config/site';
import { ENGINEERING_STRENGTHS } from '../../config/skills';

export function getStaticPaths() {
  return [{ params: { locale: 'ar' } }, { params: { locale: 'en' } }];
}

const { locale } = Astro.params as { locale: 'ar' | 'en' };
const t = UI_LABELS[locale];

// Strictly filter published projects only (never expose draft or private)
const allPublished = (await getCollection('projects', ({ data }) => data.visibility === 'published')).sort(
  (a, b) => a.data.featuredOrder - b.data.featuredOrder
);

const featuredProjects = allPublished.filter((p) => p.data.featured);
const secondaryProjects = allPublished.filter((p) => !p.data.featured);

const projectTitlesMap: Record<string, { ar: string; en: string }> = {};
for (const p of allPublished) {
  projectTitlesMap[p.data.slug] = { ar: p.data.titleAr, en: p.data.titleEn };
}

const specializations = [
  {
    badge: '01 · AI & Media Compilers',
    titleAr: 'خطوط إنتاج الذكاء الاصطناعي والمترجمات الرسومية',
    titleEn: 'AI Production Pipelines & Graphics Compilers',
    descAr: 'بناء أنظمة تحوّل النصوص ولوحات القصة إلى فيديوهات ومخرجات متزامنة عبر عقود برمجية صارمة وبوابات فحص جودة آلية.',
    descEn: 'Contract-driven pipelines translating scripts and storyboards into GPU-rendered video with word-level Whisper sync and automated QA gates.',
    proofRef: 'AION Studio V6 (13 Stages / 10-Stage ECGC)',
  },
  {
    badge: '02 · Mathematical Optimization',
    titleAr: 'الاستمثال الرياضي (CP-SAT) والأنظمة الحتمية',
    titleEn: 'Mathematical Optimization (OR-Tools CP-SAT)',
    descAr: 'صياغة وحل معضلات الجدولة وتوزيع الموارد بصفر تعارضات حتمية مع تشخيص رياضي مسبق وإصلاح موضعي ذكي.',
    descEn: 'Linear-gap constraint programming solving complex 600-period schedules in seconds with zero hard conflicts and causal smart repair.',
    proofRef: 'School Timetable Engine (0% Conflicts / 36 Pytest)',
  },
  {
    badge: '03 · On-Device Computer Vision',
    titleAr: 'الرؤية الحاسوبية الفورية وأتمتة الأنظمة',
    titleEn: 'Zero-GC Computer Vision & Device Automation',
    descAr: 'تطوير محركات مطابقة قوالب (ZNCC) وOCR عالية السرعة تعمل على الهواتف وسطح المكتب بدون استنزاف للذاكرة وبعزل كامل للجلسات.',
    descEn: 'Thread-local zero-GC ZNCC template matching, anchor-based multi-resolution scaling, and isolated multi-slot browser automation.',
    proofRef: 'Phone Commander + RoK Universal + Multi-Slot Suite',
  },
  {
    badge: '04 · Resilient Full-Stack & Mobile',
    titleAr: 'تطبيقات الويب والموبايل المحصنة أمنيًا',
    titleEn: 'Hardened Full-Stack & Offline-First Mobile Apps',
    descAr: 'معماريات Flutter وReact 19/TypeScript تدعم العمل دون اتصال (Offline Outbox)، وفحص البايتات السحرية (Magic Bytes)، وحوكمة RLS.',
    descEn: 'Multi-app Flutter monorepos with offline outbox sync and jittered backoff, plus React 19/Express storefronts with Magic-Byte upload security.',
    proofRef: 'Enaya Healthcare Monorepo + SOLE Marketplace',
  },
];

const methodologySteps = [
  {
    num: '01',
    titleAr: 'التشخيص الجنائي وفحص الجدوى أولًا',
    titleEn: 'Forensic Discovery & Pre-Solve Feasibility',
    bodyAr: 'لا أبدأ بكتابة كود سطحي؛ أفحص حدود النظام ومواضع الفشل المحتملة (مثل فخ الاستحالة في القيود أو تسرب حالة الجلسة) وأبني حواجز وقائية قبل التنفيذ.',
    bodyEn: 'Every system starts with identifying structural bottlenecks — mathematical infeasibility traps, session state leaks, or protocol anomalies — before writing feature code.',
  },
  {
    num: '02',
    titleAr: 'عقود بيانات صارمة وعزل للمسؤوليات',
    titleEn: 'Strict Contracts & Boundary Isolation',
    bodyAr: 'كل مرحلة في النظام تخضع لعقد واضح (Schema Contract) مع عزل مجلدات التشغيل أو الجلسات بحيث لا يؤدي فشل جزئي إلى إتلاف البيانات المعتمدة.',
    bodyEn: 'Pipeline stages, browser contexts, and public/admin APIs are separated by explicit contracts and immutable run ledgers so partial faults never corrupt master state.',
  },
  {
    num: '03',
    titleAr: 'التحقق المستقل بدون ثقة مسبقة (Zero-Trust QA)',
    titleEn: 'Independent Zero-Trust Verification',
    bodyAr: 'لا أثق بمخرجات الخوارزمية أو الرندر تلقائيًا؛ أبني مدققات مستقلة تفحص النتيجة النهائية (ScheduleValidator، audit_scene_graph، واختبارات البايتات السحرية).',
    bodyEn: 'Outputs are verified by independent validators (`ScheduleValidator`, `audit_scene_graph`, Magic-Byte unit tests) rather than trusting upstream execution blindly.',
  },
];

const pageTitle =
  locale === 'ar'
    ? `${SITE_CONFIG.ownerNameAr} — بورتفوليو الأنظمة الذكية والأتمتة`
    : `${SITE_CONFIG.ownerNameEn} — Evidence-Driven Engineering Portfolio`;
const pageDesc = locale === 'ar' ? SITE_CONFIG.heroSubheadingAr : SITE_CONFIG.heroSubheadingEn;
---

<BaseLayout title={pageTitle} description={pageDesc} locale={locale} currentPath={`/${locale}/`}>
  <!-- 2027 Hero Section with Studio Portrait & Floating Telemetry -->
  <section class="relative bg-[#0B1220] text-[#F5F7FA] border-b border-[#182438] overflow-hidden">
    <!-- Subtle Ambient Background Gradients Matching Portrait Lighting -->
    <div
      class="pointer-events-none absolute -top-32 start-0 w-[520px] h-[520px] rounded-full bg-[#2663EB]/20 blur-[130px] animate-pulse-glow"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute -bottom-32 end-0 w-[480px] h-[480px] rounded-full bg-amber-500/15 blur-[130px] animate-pulse-glow"
      aria-hidden="true"
    ></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 lg:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <!-- Hero Text Column (7 Cols) -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-[#182438]/90 border border-[#2663EB]/40 text-xs font-mono text-[#18B8A7] shadow-sm">
            <span class="w-2 h-2 rounded-full bg-[#18B8A7]" aria-hidden="true"></span>
            <span>
              {locale === 'ar'
                ? 'أحمد عبد الله · بورتفوليو هندسي موثق بالأدلة (Graph-First 2027)'
                : 'Ahmed Abdellah · Graph-First Verified Engineering Portfolio'}
            </span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white leading-[1.18]">
            {locale === 'ar' ? SITE_CONFIG.heroHeadingAr : SITE_CONFIG.heroHeadingEn}
          </h1>

          <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl">
            {locale === 'ar' ? SITE_CONFIG.heroSubheadingAr : SITE_CONFIG.heroSubheadingEn}
          </p>

          <!-- Audience Quick-Start Pills (Client / HR / CTO) -->
          <div class="pt-1 flex flex-wrap items-center gap-2 text-xs font-mono text-slate-300">
            <span class="text-slate-400">
              {locale === 'ar' ? 'اختر زاوية الاستعراض:' : 'Tailor view for:'}
            </span>
            <a
              href="#audience-lens-bar"
              data-jump-lens="client"
              class="px-3 py-1 rounded-lg bg-[#182438] hover:bg-[#2663EB] text-white border border-slate-700 transition-colors"
            >
              {locale === 'ar' ? '💼 صاحب مشروع / عميل' : '💼 Client / Founder'}
            </a>
            <a
              href="#audience-lens-bar"
              data-jump-lens="hr"
              class="px-3 py-1 rounded-lg bg-[#182438] hover:bg-[#2663EB] text-white border border-slate-700 transition-colors"
            >
              {locale === 'ar' ? '🎯 مسؤولو التوظيف (HR)' : '🎯 HR & Recruiters'}
            </a>
            <a
              href="#audience-lens-bar"
              data-jump-lens="engineering"
              class="px-3 py-1 rounded-lg bg-[#182438] hover:bg-[#2663EB] text-white border border-slate-700 transition-colors"
            >
              {locale === 'ar' ? '⚙️ شركة تقنية / CTO' : '⚙️ CTO / Engineering'}
            </a>
          </div>

          <div class="pt-2 flex flex-wrap items-center gap-3.5">
            <a
              href="#featured-projects"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl bg-gradient-to-r from-[#2663EB] to-blue-600 hover:from-blue-600 hover:to-[#2663EB] text-white font-bold text-sm shadow-lg shadow-blue-600/25 transition-all"
            >
              <span>{t.heroPrimaryCta}</span>
            </a>
            <a
              href={`/${locale}/expertise`}
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl bg-[#182438] hover:bg-slate-800 text-slate-100 font-semibold text-sm border border-slate-700 transition-colors"
            >
              <span>{t.heroSecondaryCta}</span>
            </a>
          </div>
        </div>

        <!-- Hero Portrait & Floating Telemetry Column (5 Cols) -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="relative w-full max-w-[380px] sm:max-w-[410px]">
            <!-- Dual-Tone Studio Rim Glow Behind Portrait -->
            <div
              class="absolute -inset-2 rounded-[32px] bg-gradient-to-tr from-[#2663EB]/45 via-[#18B8A7]/25 to-amber-500/40 blur-xl opacity-80"
              aria-hidden="true"
            ></div>

            <!-- Main Glassmorphic Portrait Card -->
            <div class="relative rounded-[28px] bg-[#182438] border-2 border-slate-700/80 p-2.5 shadow-2xl overflow-hidden">
              <div class="relative rounded-[22px] overflow-hidden aspect-square bg-[#0B1220]">
                <img
                  src="/media/profile/ahmed-abdellah.webp"
                  alt={
                    locale === 'ar'
                      ? 'أحمد عبد الله — مهندس برمجيات ومعماري أنظمة ذكية'
                      : 'Ahmed Abdellah — Systems Architect & Creative AI Engineer'
                  }
                  width="800"
                  height="800"
                  loading="eager"
                  decoding="async"
                  class="w-full h-full object-cover object-top hover:scale-[1.02] transition-transform duration-500"
                />
                <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-[#0B1220] via-[#0B1220]/70 to-transparent"></div>

                <!-- Bottom Identity Overlay Inside Frame -->
                <div class="absolute bottom-3.5 inset-x-4 flex items-end justify-between gap-2">
                  <div>
                    <span class="block font-extrabold text-white text-base sm:text-lg leading-tight">
                      {locale === 'ar' ? 'أحمد عبد الله' : 'Ahmed Abdellah'}
                    </span>
                    <span class="text-xs font-mono text-[#18B8A7]">
                      {locale === 'ar'
                        ? 'معماري أنظمة ذكية وأتمتة (Full-Stack & AI)'
                        : 'Systems Architect · AI & Automation'}
                    </span>
                  </div>
                  <span class="px-2.5 py-1 rounded-full bg-emerald-950/90 text-[#18B8A7] border border-[#18B8A7]/40 font-mono text-[11px] font-bold">
                    {locale === 'ar' ? 'متاح للتعاون' : 'Available'}
                  </span>
                </div>
              </div>
            </div>

            <!-- Floating Telemetry Chip 1 (Top-Start) -->
            <div class="animate-float-slow hidden sm:flex items-center gap-2.5 absolute -top-4 -start-5 px-3.5 py-2 rounded-2xl bg-[#0B1220]/95 border border-[#2663EB]/50 shadow-xl backdrop-blur-md">
              <span class="w-2.5 h-2.5 rounded-full bg-[#2663EB]" aria-hidden="true"></span>
              <div class="text-xs">
                <strong class="font-mono text-white block">60,137 AST Nodes</strong>
                <span class="text-[10px] text-slate-400">
                  {locale === 'ar' ? 'مفهرسة عبر 7 أنظمة' : 'Indexed Across 7 Systems'}
                </span>
              </div>
            </div>

            <!-- Floating Telemetry Chip 2 (Bottom-End) -->
            <div
              style="animation-delay: 1.8s"
              class="animate-float-slow hidden sm:flex items-center gap-2.5 absolute -bottom-4 -end-4 px-3.5 py-2 rounded-2xl bg-[#0B1220]/95 border border-[#18B8A7]/50 shadow-xl backdrop-blur-md"
            >
              <span class="w-2.5 h-2.5 rounded-full bg-[#18B8A7]" aria-hidden="true"></span>
              <div class="text-xs">
                <strong class="font-mono text-[#18B8A7] block">24 Verified Proofs</strong>
                <span class="text-[10px] text-slate-400">
                  {locale === 'ar' ? 'إثبات بالملف والسطر' : 'File & Line Traceable'}
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Verified Engineering Metrics Strip -->
      <div class="mt-14 pt-8 border-t border-[#182438] grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="reveal-item bg-[#182438]/75 rounded-2xl p-5 border border-slate-800 hover:border-[#18B8A7]/50 transition-colors">
          <div class="font-mono text-2xl sm:text-3xl font-extrabold text-[#18B8A7]">7</div>
          <div class="text-xs sm:text-sm text-slate-300 mt-1">
            {locale === 'ar'
              ? 'أنظمة برمجية مفحوصة وموثقة بالكامل'
              : 'Audited Codebases with Traceable Proofs'}
          </div>
        </div>
        <div class="reveal-item bg-[#182438]/75 rounded-2xl p-5 border border-slate-800 hover:border-[#60A5FA]/50 transition-colors">
          <div class="font-mono text-2xl sm:text-3xl font-extrabold text-[#60A5FA]">60,137</div>
          <div class="text-xs sm:text-sm text-slate-300 mt-1">
            {locale === 'ar'
              ? 'عقدة برمجية (AST & Knowledge Graph) مفهرسة'
              : 'Indexed AST & Knowledge-Graph Nodes'}
          </div>
        </div>
        <div class="reveal-item bg-[#182438]/75 rounded-2xl p-5 border border-slate-800 hover:border-[#18B8A7]/50 transition-colors">
          <div class="font-mono text-2xl sm:text-3xl font-extrabold text-[#18B8A7]">24</div>
          <div class="text-xs sm:text-sm text-slate-300 mt-1">
            {locale === 'ar'
              ? 'ادعاءً هندسيًا مثبتًا بالملف والسطر (EXTRACTED)'
              : 'Verified File/Line Evidence Claims'}
          </div>
        </div>
        <div class="reveal-item bg-[#182438]/75 rounded-2xl p-5 border border-slate-800 hover:border-[#60A5FA]/50 transition-colors">
          <div class="font-mono text-2xl sm:text-3xl font-extrabold text-[#60A5FA]">13</div>
          <div class="text-xs sm:text-sm text-slate-300 mt-1">
            {locale === 'ar'
              ? 'قصة تحدٍ وإصلاح هندسي موثقة بالبرهان'
              : 'Documented Engineering Challenge Stories'}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Smart 3-Audience Lens Switcher (Fits Regular Clients, HR Recruiters, and Tech Companies/CTOs) -->
  <section id="audience-lens-bar" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12">
    <div class="bg-white rounded-3xl border border-slate-200 p-5 sm:p-7 shadow-sm">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-5 border-b border-slate-100">
        <div>
          <span class="font-mono text-xs uppercase tracking-wider text-[#2663EB] font-bold">
            {locale === 'ar' ? 'تجربة قراءة ذكية تناسب هدفك' : 'Interactive Perspective Lens'}
          </span>
          <h2 class="text-lg sm:text-xl font-extrabold text-[#0B1220] mt-0.5">
            {locale === 'ar'
              ? 'اختر وضع العرض الأنسب لك: شامل، لصاحب المشروع، لـ HR، أو للمهندسين'
              : 'Switch Lens: Unified View, Client ROI, HR Snapshot, or CTO Deep Dive'}
          </h2>
        </div>

        <!-- Lens Buttons -->
        <div class="flex flex-wrap items-center gap-2" role="tablist" aria-label="Audience Lens">
          <button
            type="button"
            data-lens-btn="all"
            class="lens-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-[#0B1220] text-white cursor-pointer transition-all"
          >
            {locale === 'ar' ? '✨ الوضع الشامل' : '✨ Unified View'}
          </button>
          <button
            type="button"
            data-lens-btn="client"
            class="lens-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-[#F5F7FA] hover:bg-blue-50 text-slate-700 border border-slate-200 cursor-pointer transition-all"
          >
            {locale === 'ar' ? '💼 للعميل وصاحب المشروع' : '💼 Client & Business'}
          </button>
          <button
            type="button"
            data-lens-btn="hr"
            class="lens-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-[#F5F7FA] hover:bg-blue-50 text-slate-700 border border-slate-200 cursor-pointer transition-all"
          >
            {locale === 'ar' ? '🎯 لمسؤولي التوظيف (HR)' : '🎯 HR & Recruiters'}
          </button>
          <button
            type="button"
            data-lens-btn="engineering"
            class="lens-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-[#F5F7FA] hover:bg-blue-50 text-slate-700 border border-slate-200 cursor-pointer transition-all"
          >
            {locale === 'ar' ? '⚙️ للشركات التقنية والمهندسين' : '⚙️ Tech Lead / CTO'}
          </button>
        </div>
      </div>

      <!-- Dynamic Lens Summary Panels -->
      <div class="pt-5">
        <!-- Default / All Panel -->
        <div data-lens-panel="all" class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs sm:text-sm">
          <div class="p-4 rounded-2xl bg-[#F5F7FA] border border-slate-200/80">
            <strong class="text-[#0B1220] block mb-1">
              {locale === 'ar' ? '💼 لأصحاب المشاريع والعملاء:' : '💼 For Clients & Founders:'}
            </strong>
            <span class="text-slate-600">
              {locale === 'ar'
                ? 'ركّز على صندوق «القيمة العملية» في كل بطاقة لمعرفة المشكلة التي يحلها النظام وكيف يوفر وقتك.'
                : 'Focus on the Business Outcome box on each card to see how manual bottlenecks turn into automated products.'}
            </span>
          </div>
          <div class="p-4 rounded-2xl bg-[#F5F7FA] border border-slate-200/80">
            <strong class="text-[#0B1220] block mb-1">
              {locale === 'ar' ? '🎯 لمسؤولي التوظيف (HR):' : '🎯 For HR & Talent Teams:'}
            </strong>
            <span class="text-slate-600">
              {locale === 'ar'
                ? 'اضغط تبويب HR أعلاه لعرض ملخص التقنيات المتقنة، مستوى النضج الإنتاجي، والاختبارات الآلية في 10 ثوانٍ.'
                : 'Click the HR tab above for a 10-second executive matrix of proven stacks, test suites, and production scope.'}
            </span>
          </div>
          <div class="p-4 rounded-2xl bg-[#F5F7FA] border border-slate-200/80">
            <strong class="text-[#0B1220] block mb-1">
              {locale === 'ar' ? '⚙️ للمهندسين والشركات التقنية:' : '⚙️ For CTOs & Senior Engineers:'}
            </strong>
            <span class="text-slate-600">
              {locale === 'ar'
                ? 'كل مشروع يتضمن مخططًا معماريًا، وقصص إصلاح السبب الجذري (RCA)، وجدول أدلة بالملف والسطر.'
                : 'Every case study includes system architecture, root-cause fixes, and a file/line Evidence Manifest.'}
            </span>
          </div>
        </div>

        <!-- Client & Business Panel -->
        <div data-lens-panel="client" class="hidden bg-blue-50/70 rounded-2xl p-5 border border-blue-200 space-y-3">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <h3 class="font-extrabold text-[#0B1220] text-base">
              {locale === 'ar'
                ? '💼 ملخص القيمة لأصحاب المشاريع: ماذا أستطيع أن أبني لك؟'
                : '💼 Client Value Snapshot: What I Can Build & Automate for You'}
            </h3>
            <a href={`/${locale}/contact`} class="px-3.5 py-1.5 rounded-xl bg-[#2663EB] text-white text-xs font-bold">
              {locale === 'ar' ? 'اطلب استشارة لمشروعك ←' : 'Discuss Your Project →'}
            </a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs sm:text-sm">
            <div class="bg-white p-3.5 rounded-xl border border-blue-100">
              <strong class="text-[#2663EB] block mb-1">
                {locale === 'ar' ? '1. أتمتة المهام المرهقة واليدوية' : '1. End-to-End Workflow Automation'}
              </strong>
              <p class="text-slate-600">
                {locale === 'ar'
                  ? 'تحويل العمليات التي تستغرق أيامًا (مثل بناء جداول المدارس أو إنتاج الفيديوهات أو إدارة المتصفحات) إلى ضغطة زر.'
                  : 'Turning multi-day manual workflows (scheduling, video production, browser/device operations) into one-click systems.'}
              </p>
            </div>
            <div class="bg-white p-3.5 rounded-xl border border-blue-100">
              <strong class="text-[#2663EB] block mb-1">
                {locale === 'ar' ? '2. تطبيقات ويب وموبايل متكاملة' : '2. Production Web & Mobile Platforms'}
              </strong>
              <p class="text-slate-600">
                {locale === 'ar'
                  ? 'تطبيقات Flutter ومتاجر React سريعة، تدعم العربية والإنجليزية، وتعمل حتى عند ضعف الإنترنت.'
                  : 'Bilingual Flutter apps and React storefronts with offline resilience and automated cloud media optimization.'}
              </p>
            </div>
            <div class="bg-white p-3.5 rounded-xl border border-blue-100">
              <strong class="text-[#2663EB] block mb-1">
