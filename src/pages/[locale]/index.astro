---
import { getCollection } from "astro:content";
import { SITE_CONFIG } from "../../config/site";
import "../../styles/global.css";
export function getStaticPaths() {
  return ["ar", "en"].map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: "ar" | "en" };
const ar = locale === "ar";
const text = (a: string, e: string) => (ar ? a : e);
const projects = (
  await getCollection("projects", ({ data }) => data.visibility === "published")
).sort((a, b) => a.data.featuredOrder - b.data.featuredOrder);

// Public case-study copy excludes source files, code symbols and repository references.
const publicDescriptions: Record<string, string[][]> = {
  "phone-commander": [
    [
      "أتمتة شاشات الهاتف قد تتعطل بسبب ضغط الذاكرة أو تغيّر أماكن العناصر.",
      "Mobile screen automation can fail under memory pressure or when interface elements move."
    ],
    [
      "محرك أندرويد يجمع الرؤية الحاسوبية والتعرف على النصوص مع إدارة المهام ومزامنة الجلسات وعرض المتابعة في Flutter.",
      "An Android engine combining computer vision and text recognition with task management, session synchronization and a Flutter monitoring interface."
    ],
    [
      "يعتمد تنفيذ الإجراءات على تأكيد بصري أو نصي بدل النقر العشوائي، مع التعافي من الحالات غير المتوقعة وتقليل استهلاك البطارية أثناء الانتظار.",
      "Actions depend on visual or text confirmation instead of blind taps, with recovery from unexpected states and battery-saving behavior during long waits."
    ],
    [
      "مطابقة الصور والتعرف على النصوص وإدارة أولويات المهام.",
      "Image matching, text recognition and task-priority management."
    ],
    [
      "مزامنة الجلسات وعرض الخطوات ونتائج المطابقة لحظيًا.",
      "Session synchronization and live reporting of steps and match scores."
    ]
  ],
  "gmail-options-suite": [
    [
      "تشغيل عدة جلسات متصفح بالتوازي يحتاج إلى منع تداخل بيانات الجلسات وتعارض تحديث الملفات.",
      "Running parallel browser sessions requires preventing shared session state and conflicting file updates."
    ],
    [
      "نظام لتوزيع المهام على جلسات متصفح معزولة، وإغلاق الجلسات بعد كل مهمة، وتنظيم النتائج والتعامل مع الفشل.",
      "A system that allocates tasks to isolated browser sessions, closes sessions after each task, organizes results and handles failures."
    ],
    [
      "يستبدل الجلسة المشتركة بجلسات منفصلة مع حفظ آمن للنتائج أثناء العمل المتوازي.",
      "Replaces shared sessions with isolated execution and safe result storage during concurrent work."
    ],
    [
      "عزل الجلسات وإدارة دورة حياتها وتوزيع المهام المتوازية.",
      "Session isolation, lifecycle management and parallel task allocation."
    ],
    [
      "تحديثات ملفات آمنة وتصنيف النتائج والتعامل مع الأعطال.",
      "Safe file updates, categorized results and failure handling."
    ]
  ],
  "school-timetable": [
    [
      "إعداد جدول يراعي المعلمين والفصول والحصص المتاحة يدويًا يستغرق وقتًا، وتعديل حصة قد يسبب تعارضات متتابعة.",
      "Building a timetable around teachers, classes and availability is time-consuming, and moving one lesson can cause further conflicts."
    ],
    [
      "نظام جدولة باستخدام Google OR-Tools، بواجهة مكتبية تعمل دون اتصال ونسخة ويب، مع فحص قابلية الحل والتحقق من الجدول وإصلاح التعديلات.",
      "A Google OR-Tools scheduling system with an offline desktop interface and a web version, feasibility checks, timetable validation and repair tools."
    ],
    [
      "يوضح أسباب تعذر الجدولة وأثر نقل الحصص قبل اعتماد التعديل، بدل المحاولة والخطأ اليدوي.",
      "Explains infeasible schedules and previews the effect of moving lessons before committing changes, instead of manual trial and error."
    ],
    [
      "توليد جداول بلا تعارض وفق القيود المحددة وفحص مستقل للنتائج.",
      "Constraint-based timetable generation with independent result validation."
    ],
    [
      "تعديل بالسحب والإفلات وتصدير عربي إلى PDF وExcel.",
      "Drag-and-drop repair and Arabic PDF and Excel export."
    ]
  ],
  "enaya-ai-workspace": [
    [
      "ربط خدمات المرضى والأطباء والصيدليات والمعامل يحتاج إلى اتساق البيانات والتعامل مع انقطاع الشبكة وحماية الوصول.",
      "Connecting patients, doctors, pharmacies and laboratories requires consistent data, network-failure handling and access protection."
    ],
    [
      "تطبيقات Flutter مرتبطة بخدمات Supabase، مع تحسين المزامنة بعد عودة الاتصال وإعادة محاولة الطلبات وإدارة تدفق الأحداث بين الخدمات.",
      "Flutter applications connected through Supabase, with improved reconnection synchronization, request retries and event flow across services."
    ],
    [
      "يعيد مزامنة الإجراءات المعلقة عند عودة الاتصال ويتعامل مع أخطاء الشبكة المؤقتة بدل فقد سير العمل.",
      "Synchronizes queued actions after reconnection and handles temporary network errors rather than abandoning the workflow."
    ],
    [
      "حجز العيادات ومتابعة الطوابير وطلبات الصيدلية والمعامل.",
      "Clinic booking, queue tracking, pharmacy requests and laboratory workflows."
    ],
    [
      "مزامنة دون اتصال وإعادة المحاولة ومتابعة عروض الأسعار والإيصالات والنزاعات.",
      "Offline synchronization, retries, and workflows for quotes, receipts and disputes."
    ]
  ],
  "remix-sole-marketplace": [
    [
      "كتالوج كبير من صور المنتجات يحتاج إلى أسماء منظمة وتحميل سريع، دون استنزاف خدمات الصور أو قبول ملفات ضارة.",
      "A large product-photo catalog needs organized titles and fast loading without exhausting image-service quotas or accepting harmful uploads."
    ],
    [
      "متجر أحذية ثنائي اللغة ينظم أسماء المنتجات آليًا ويستخدم كتالوجًا بديلًا وصورًا متجاوبة مع فحص نوع الملفات المرفوعة.",
      "A bilingual footwear storefront with automatic product-title cleanup, a fallback catalog, responsive images and uploaded-file type checks."
    ],
    [
      "ينظم الصور وأسماءها ويجهز أحجام العرض المناسبة بدل إعادة التسمية والتحجيم يدويًا.",
      "Organizes images and titles and prepares suitable display sizes instead of manual renaming and resizing."
    ],
    [
      "تنظيم كتالوج المنتجات وعرض عربي وإنجليزي وصور متجاوبة.",
      "Product-catalog organization, Arabic and English presentation and responsive images."
    ],
    [
      "فحص الملفات وإدارة الكتالوج مع بديل عند تعطل خدمة البيانات.",
      "Upload checks and catalog management with fallback data when the main service is unavailable."
    ]
  ],
  "image-to-animate": [
    [
      "إنتاج فيديو توضيحي يدويًا يتطلب تجهيز الصور وتوقيت الحركة مع الكلام وضبط الصوت، ثم إعادة العمل عند تغيير النص.",
      "Manual explainer-video production requires preparing images, timing motion to speech and balancing audio, then revisiting the work when the script changes."
    ],
    [
      "مسار إنتاج آلي يحول النص إلى تعليق صوتي ومشاهد ورسوم متحركة، ثم يصدر فيديو مع فحوص للصوت والصورة.",
      "An automated pipeline turning scripts into narration, scenes and motion graphics, then exporting video with audio and visual checks."
    ],
    [
      "يربط العناصر بكلمات التعليق ويضبط المزج الصوتي ويفحص المخرجات بدل المزامنة اليدوية إطارًا بإطار.",
      "Connects visual assets to narration words, balances audio and checks outputs instead of manual frame-by-frame synchronization."
    ],
    [
      "توقيت على مستوى الكلمة وإعداد الصور وتحريك المشاهد.",
      "Word-level timing, image preparation and scene animation."
    ],
    [
      "إخراج أفقي ورأسي وفحص الإطارات والصوت وتزامنهما.",
      "Widescreen and vertical output with frame, audio and synchronization checks."
    ]
  ],
  "rok-vision-controller": [
    [
      "تغيّر أبعاد شاشات أندرويد يجعل إحداثيات النقر الثابتة غير دقيقة.",
      "Different Android screen dimensions make fixed tap coordinates unreliable."
    ],
    [
      "متحكم يكيّف مواضع عناصر الواجهة وفق ارتفاع الشاشة ونقاط ارتكاز واضحة، مع دعم الوضع الأفقي ونسخ التطبيق المتعددة.",
      "A controller adapting interface positions to screen height and defined anchor points, with landscape and multiple-app-instance support."
    ],
    [
      "يحوّل مواقع العناصر حسب أبعاد الجهاز بدل إعداد قائمة إحداثيات مستقلة لكل شاشة.",
      "Transforms interface positions for each device instead of maintaining a separate coordinate table for every screen."
    ],
    [
      "تكييف مواقع العناصر باستخدام خمس مناطق ارتكاز للشاشة.",
      "Adapting interface positions using five screen-anchor regions."
    ],
    [
      "تنظيم اتجاه الشاشة واستهداف شبكة الشخصيات مع متابعة دورات التنفيذ.",
      "Landscape normalization, character-grid targeting and execution-cycle monitoring."
    ]
  ]
};
const publicCopy = (slug: string, item: number) => publicDescriptions[slug][item][ar ? 0 : 1];

const name = ar ? SITE_CONFIG.ownerNameAr : SITE_CONFIG.ownerNameEn;
const nav = [
  ["work", text("الأعمال", "Work")],
  ["expertise", text("الخبرات", "Expertise")],
  ["about", text("عنّي", "About")],
  ["contact", text("التواصل", "Contact")],
];
const strengths = [
  [
    text("تطبيقات ويب وموبايل", "Web & mobile apps"),
    text(
      "واجهات واضحة وأنظمة متكاملة، من المتاجر إلى تطبيقات الخدمات الطبية.",
      "Clear interfaces and connected systems, from storefronts to healthcare apps.",
    ),
    "Flutter · React · TypeScript",
  ],
  [
    text("ذكاء اصطناعي وأتمتة", "AI & automation"),
    text(
      "تحويل المهام المتكررة وإنتاج الوسائط إلى خطوات قابلة للتشغيل والفحص.",
      "Turning repeatable tasks and media production into testable workflows.",
    ),
    "Python · FFmpeg · Computer Vision",
  ],
  [
    text("حلول جدولة وأنظمة موثوقة", "Scheduling & reliable systems"),
    text(
      "حل القيود المعقدة، والتحقق من النتائج، والتعافي عند انقطاع الاتصال.",
      "Solving complex constraints, checking outputs, and recovering from network failures.",
    ),
    "OR-Tools · Kotlin · SQLite",
  ],
];
const status: Record<string, string> = {
  production: text("مكتمل وقابل للتشغيل", "Complete & runnable"),
  functional: text("نواة وظيفية عاملة", "Functional core"),
  prototype: text("نموذج أولي", "Prototype"),
  in_progress: text("قيد التطوير", "In progress"),
  concept: text("تصور معماري", "Architecture concept"),
  unknown: text("قيد المراجعة", "Under review"),
};
const title = `${name} | ${text("برمجيات وذكاء اصطناعي وأتمتة", "Software, AI & Automation")}`;
const desc = ar ? SITE_CONFIG.taglineAr : SITE_CONFIG.taglineEn;
const illustration = (slug: string, ar: boolean) => {
  const phone = slug === "phone-commander";
  const labels = phone
    ? ar
      ? ["التقاط الشاشة", "فهم الصورة والنص", "قرار وتنفيذ"]
      : ["Screen capture", "Vision + OCR", "Decide & act"]
    : ar
      ? ["توزيع المهام", "جلسات معزولة", "تصنيف وإغلاق"]
      : ["Allocate tasks", "Isolated sessions", "Route & close"];
  const headline = phone ? "Phone Commander" : "Gmail Options Suite";
  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" role="img" aria-label="${headline}: ${labels.join(" - ")}">
 <defs><linearGradient id="bg" x2="1" y2="1"><stop stop-color="#122745"/><stop offset="1" stop-color="#0b1220"/></linearGradient><linearGradient id="accent" x2="1" y2="1"><stop stop-color="#a3c8ff"/><stop offset="1" stop-color="#5087d0"/></linearGradient></defs>
 <rect width="800" height="500" rx="22" fill="url(#bg)"/>
 <g stroke="#8bb6ef" stroke-opacity=".08"><path d="M0 100H800M0 200H800M0 300H800M0 400H800M100 0V500M200 0V500M300 0V500M400 0V500M500 0V500M600 0V500M700 0V500"/></g>
 <text x="48" y="63" fill="#8fb2e1" font-size="13" letter-spacing="3" font-family="Arial,sans-serif">${phone ? "ANDROID · COMPUTER VISION" : "PYTHON · BROWSER AUTOMATION"}</text>
 <text x="48" y="106" fill="#edf4ff" font-size="32" font-weight="700" font-family="Arial,sans-serif">${headline}</text>
 ${phone ? `<rect x="310" y="150" width="180" height="205" rx="25" fill="#0a111e" stroke="#8db7ef" stroke-width="3"/><rect x="326" y="169" width="148" height="164" rx="12" fill="#142b48"/><path d="M349 193h31m-31 0v26m102-26h-31m31 0v26m-102 87h31m-31 0v-26m102 26h-31m31 0v-26" fill="none" stroke="#a3c8ff" stroke-width="3"/><rect x="363" y="225" width="73" height="40" rx="7" fill="#72c2b5" fill-opacity=".15" stroke="#83cdbf" stroke-dasharray="5 4"/><path d="M375 282h50M384 292h32" stroke="#729ccf" stroke-width="3"/><circle cx="400" cy="344" r="3" fill="#8db7ef"/><path d="M246 245h45m-9-8 9 8-9 8M509 245h45m-9-8 9 8-9 8" fill="none" stroke="#779fd3" stroke-width="3"/><rect x="93" y="213" width="134" height="65" rx="12" fill="#183350" stroke="#476b9a"/><path d="M113 235h70m-70 13h90m-90 13h52" stroke="#9bc3f6" stroke-width="3"/><rect x="573" y="210" width="134" height="74" rx="12" fill="#153337" stroke="#52958c"/><path d="m615 248 15 15 28-32" fill="none" stroke="#8ed7c5" stroke-width="5"/>` : `<rect x="46" y="170" width="166" height="169" rx="17" fill="#101e32" stroke="#587da8"/><rect x="62" y="188" width="134" height="23" rx="5" fill="#244364"/><circle cx="74" cy="199" r="3" fill="#a3c8ff"/><path d="M75 237h100M75 261h100M75 285h70M75 309h86" stroke="#759ac7" stroke-width="5"/><path d="M227 250h51m-9-8 9 8-9 8M523 250h51m-9-8 9 8-9 8" fill="none" stroke="#8db7ef" stroke-width="3"/>${[0, 1, 2].map((i) => `<rect x="300" y="${159 + i * 62}" width="200" height="49" rx="10" fill="#172e4b" stroke="#648fc3"/><circle cx="322" cy="${184 + i * 62}" r="5" fill="#9fc5fa"/><path d="M340 ${178 + i * 62}h110M340 ${190 + i * 62}h73" stroke="#6d94c7" stroke-width="3"/>`).join("")}<rect x="594" y="170" width="160" height="169" rx="17" fill="#132d31" stroke="#5b9e94"/><path d="m620 203 8 8 15-19m-23 49 8 8 15-19m-23 49 8 8 15-19M658 204h70M658 242h70M658 280h52" fill="none" stroke="#8cd4c1" stroke-width="4"/>`}
 ${labels.map((label, i) => `<rect x="${35 + i * 255}" y="384" width="220" height="49" rx="9" fill="#0b1525" stroke="#355477"/><text x="${145 + i * 255}" y="415" text-anchor="middle" direction="${ar ? "rtl" : "ltr"}" fill="#caddf8" font-size="20" font-family="Arial,sans-serif">${label}</text>`).join("")}
 <text x="400" y="470" text-anchor="middle" direction="${ar ? "rtl" : "ltr"}" fill="#8ca8cc" font-size="14" font-family="Arial,sans-serif">${ar ? "رسم توضيحي لطريقة العمل، وليس لقطة من التطبيق" : "Workflow illustration, not an application screenshot"}</text>
 </svg>`.replace(/&/g, "&amp;");
};

const publicCaption = (caption: string) => caption.replace(/`creative_contact_sheet\.png`/g, ar ? "لوحة معاينة المشاهد" : "scene preview sheet").replace(/`([^`]+)`/g, "$1");
const origin = SITE_CONFIG.contact.domain;
const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  inLanguage: locale,
  name: title,
  mainEntity: {
    "@type": "Person",
    name,
    url: origin,
    image: `${origin}/media/profile/ahmed-abdellah.webp`,
    jobTitle: ar ? SITE_CONFIG.roleTitleAr : SITE_CONFIG.roleTitleEn,
  },
};
---

<!doctype html>
<html lang={locale} dir={ar ? "rtl" : "ltr"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={`${origin}/${locale}/`} />
    <link rel="alternate" hreflang="ar" href={`${origin}/ar/`} />
    <link rel="alternate" hreflang="en" href={`${origin}/en/`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${origin}/${locale}/`} />
    <meta
      property="og:image"
      content={`${origin}/media/profile/ahmed-abdellah.webp`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" hreflang="x-default" href={`${origin}/ar/`} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(profileSchema).replace(/</g, "\\u003c")}
    />
  </head>
  <body>
    <a class="skip" href="#main">
      {text("تخطي إلى المحتوى", "Skip to content")}
    </a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="#top">
          <img
            src="/media/profile/ahmed-abdellah-thumb.webp"
            width="38"
            height="38"
            alt=""
          />
          <strong>{name}</strong>
        </a>
        <nav aria-label={text("التنقل الرئيسي", "Main navigation")}>
          {nav.map(([id, label]) => (
            <a href={`#${id}`}>{label}</a>
          ))}
        </nav>
        <a class="language" href={ar ? "/en/" : "/ar/"} lang={ar ? "en" : "ar"}>
          {text("English", "العربية")}
        </a>
      </div>
    </header>
    <main id="main">
      <section id="top" class="hero wrap">
        <div class="hero-copy">
          <p class="eyebrow">
            {text(
              "برمجيات · ذكاء اصطناعي · أتمتة",
              "SOFTWARE · AI · AUTOMATION",
            )}
          </p>
          <p class="intro">{text("أنا احمد عبداللاه", "I’m Ahmed Abdellah")}</p>
          <h1>
            {text("أفكار معقدة.", "Complex ideas.")}
            <br />
            <span>{text("حلول قابلة للاستخدام.", "Usable software.")}</span>
          </h1>
          <p class="lead">
            {text(
              "أصمّم وأبني تطبيقات ويب وموبايل وأنظمة ذكية، من فهم المشكلة إلى واجهة واضحة ونتيجة يمكن فحصها.",
              "I design and build web apps, mobile apps, and intelligent systems, from understanding the problem to a clear interface and a testable result.",
            )}
          </p>
          <div class="actions">
            <a class="button primary" href="#work">
              {text("استكشف أعمالي", "Explore my work")}{" "}
              <span aria-hidden="true">↓</span>
            </a>
            <a class="button secondary" href="#about">
              {text("تعرّف عليّ", "About me")}
            </a>
          </div>
          <div class="hero-note">
            <span class="dot"></span>
            {text(
              "٧ مشاريع في التطبيقات والأتمتة والأنظمة الذكية",
              "7 projects across apps, automation & intelligent systems",
            )}
          </div>
        </div>
        <figure class="portrait">
          <img
            src="/media/profile/ahmed-abdellah.webp"
            alt={name}
            width="800"
            height="800"
            fetchpriority="high"
          />
          <figcaption>
            <span>{text("من الفكرة إلى النظام", "FROM IDEA TO SYSTEM")}</span>
            <strong>Ahmed Abdellah</strong>
          </figcaption>
        </figure>
      </section>
      <section id="work" class="wrap section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">01 / {text("الأعمال", "WORK")}</p>
            <h2>
              {text(
                "كل مشروع يبدأ بمشكلة.",
                "Every project starts with a problem.",
              )}
            </h2>
          </div>
          <p>
            {text(
              "النتيجة أولًا. التفاصيل والصور داخل كل مشروع، من غير ما تخرج من الصفحة.",
              "The result comes first. Open any project for details and screenshots without leaving this page.",
            )}
          </p>
        </div>
        <div class="project-list">
          {projects.map(({ data: p }, i) => {
            const photo = p.screenshots[0];
            return (
              <article class="project" id={`project-${p.slug}`}>
                <div class="project-cover">
                  {photo ? (
                    <img
                      src={photo.src}
                      alt={ar ? photo.altAr : photo.altEn}
                      width={photo.width}
                      height={photo.height}
                      loading="lazy"
                    />
                  ) : (
                    <figure class="illustration-figure">
                      {" "}
                      <img
                        class="workflow-illustration"
                        src={`data:image/svg+xml;charset=utf-8,${encodeURIComponent(illustration(p.slug, ar))}`}
                        alt={
                          text(
                            "رسم توضيحي لطريقة عمل ",
                            "Workflow illustration for ",
                          ) +
                          (ar ? p.titleAr : p.titleEn) +
                          text(
                            "، وليس لقطة من التطبيق",
                            ", not an app screenshot",
                          )
                        }
                        width="800"
