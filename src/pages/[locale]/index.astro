  <!-- Interactive Script for Audience Lens Switching & In-Card Media Toggle -->
  <script is:inline>
    function initHomeInteractions() {
      const lensBtns = document.querySelectorAll('[data-lens-btn]');
      const lensPanels = document.querySelectorAll('[data-lens-panel]');
      const jumpLinks = document.querySelectorAll('[data-jump-lens]');

      function activateLens(lens) {
        document.body.setAttribute('data-audience-lens', lens);
        lensBtns.forEach((btn) => {
          const isMatch = btn.getAttribute('data-lens-btn') === lens;
          btn.classList.toggle('bg-[#0B1220]', isMatch);
          btn.classList.toggle('text-white', isMatch);
          btn.classList.toggle('bg-[#F5F7FA]', !isMatch);
          btn.classList.toggle('text-slate-700', !isMatch);
        });
        lensPanels.forEach((panel) => {
          const isMatch = panel.getAttribute('data-lens-panel') === lens;
          panel.classList.toggle('hidden', !isMatch);
        });
      }

      lensBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          activateLens(btn.getAttribute('data-lens-btn') || 'all');
        });
      });

      jumpLinks.forEach((link) => {
        link.addEventListener('click', () => {
          const targetLens = link.getAttribute('data-jump-lens');
          if (targetLens) activateLens(targetLens);
        });
      });

      // In-card media preview switcher (Screenshot <-> Architecture Diagram)
      document.querySelectorAll('[data-switch-target]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const targetId = btn.getAttribute('data-switch-target');
          const newSrc = btn.getAttribute('data-switch-src');
          const imgEl = targetId ? document.getElementById(targetId) : null;
          if (imgEl && newSrc) {
            imgEl.setAttribute('src', newSrc);
            const parent = btn.parentElement;
            parent?.querySelectorAll('.card-media-btn').forEach((sib) => {
              const active = sib === btn;
              sib.classList.toggle('bg-[#2663EB]', active);
              sib.classList.toggle('text-white', active);
              sib.classList.toggle('bg-[#0B1220]/85', !active);
              sib.classList.toggle('text-slate-300', !active);
            });
          }
        });
      });
    }

    initHomeInteractions();
    document.addEventListener('astro:after-swap', initHomeInteractions);
  </script>
