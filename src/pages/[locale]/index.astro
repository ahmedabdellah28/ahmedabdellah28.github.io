---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CTA from '../../components/CTA.astro';
import { SITE_CONFIG, UI_LABELS } from '../../config/site';

export function getStaticPaths() {
  return [{ params: { locale: 'ar' } }, { params: { locale: 'en' } }];
}

const { locale } = Astro.params as { locale: 'ar' | 'en' };
const t = UI_LABELS[locale];

// Strictly filter published projects only
const allPublished = (await getCollection('projects', ({ data }) => data.visibility === 'published')).sort(
  (a, b) => a.data.featuredOrder - b.data.featuredOrder
);

// 3 Flagship Featured Projects right after Hero (§5.C)
const featuredProjects = allPublished.filter((p) => p.data.featured).slice(0, 3);

// D. What I Build / Expertise (4 clear groups with supporting project links)
const expertiseGroups = [
  {
    titleAr: 'تطبيقات وتجارب رقمية متكاملة',
    titleEn: 'Digital Applications & Product Experiences',
    valueAr: 'بناء تطبيقات ويب وموبايل وسطح مكتب سريعة، تدعم العربية والإنجليزية، وتمنح المستخدم النهائي تجربة واضحة بلا تعقيد.',
    valueEn: 'Building fast web, mobile, and desktop applications with native Arabic/English support and intuitive user journeys.',
    exampleLabelAr: 'مثال مطبق: متجر سول للأحذية (SOLE) ومنظومة عناية الطبية',
    exampleLabelEn: 'Proven in: SOLE Footwear Marketplace & Enaya Healthcare Platform',
    exampleHref: `/${locale}/projects/remix-sole-marketplace`,
  },
  {
    titleAr: 'الذكاء الاصطناعي ومحركات الأتمتة',
    titleEn: 'AI Workflows & Intelligent Automation',
    valueAr: 'تحويل العمليات اليدوية التي تستغرق ساعات أو أيامًا (مثل إنتاج الفيديو أو الرصد البصري على الشاشات) إلى خطوط إنتاج آلية منضبطة.',
    valueEn: 'Transforming multi-hour manual workflows (video production, visual screen tasks, multi-slot browser flows) into deterministic pipelines.',
    exampleLabelAr: 'مثال مطبق: محرك AION Studio لإنتاج الموشن جرافيك',
    exampleLabelEn: 'Proven in: AION Studio Automated Motion Graphics Engine',
    exampleHref: `/${locale}/projects/image-to-animate`,
  },
  {
    titleAr: 'الأنظمة الحتمية وحل القيود المعقدة',
    titleEn: 'Constraint Systems & Mathematical Scheduling',
    valueAr: 'صياغة القواعد المتشابكة رياضيًا لإنتاج حلول خالية من التضارب مع شرح الأسباب والبدائل للمستخدم بوضوح عند التعديل اليدوي.',
    valueEn: 'Modeling complex operational rules mathematically to produce conflict-free schedules with explainable interactive repair.',
    exampleLabelAr: 'مثال مطبق: نظام الجدول المدرسي الذكي',
    exampleLabelEn: 'Proven in: Smart School Timetable System',
    exampleHref: `/${locale}/projects/school-timetable`,
  },
  {
    titleAr: 'الأداء، الاعتمادية، وتحصين الأمان',
    titleEn: 'Performance, Offline Resilience & Security',
    valueAr: 'حماية العمليات من الضياع عند انقطاع الإنترنت، وتصفير استنزاف ذاكرة المعالج في المهام المستمرة، وفحص الملفات المرفوعة من البايت الأول.',
    valueEn: 'Preventing data loss during network drops, eliminating memory churn in continuous loops, and verifying binary file uploads.',
    exampleLabelAr: 'مثال مطبق: Phone Commander وواجهة أمان متجر سول',
    exampleLabelEn: 'Proven in: Phone Commander & SOLE Security Gate',
    exampleHref: `/${locale}/projects/phone-commander`,
  },
];

// E. Problem Solving / Engineering Highlights (3 verified stories: Problem -> Decision -> Verified Outcome)
const engineeringStories = [
  {
    badgeAr: 'إصلاح موثق بالدليل · Verified Fix',
    badgeEn: 'Verified Fix · Code & RCA Proven',
    badgeStyle: 'bg-emerald-500/15 text-emerald-300 border-emerald-400/30',
    projectTitleAr: 'AION Studio — إنتاج الموشن جرافيك',
    projectTitleEn: 'AION Studio Motion Engine',
    href: `/${locale}/projects/image-to-animate#engineering-deep-dive`,
    titleAr: 'منع تشوه النصوص العربية وتداخل المؤثرات الصوتية فوق صوت المعلق',
    titleEn: 'Eliminating Arabic Caption Ghosting & Overlapping Audio Cues',
    problemAr: 'كانت النصوص العربية تظهر باهتة أثناء فتح البطاقات، مع تداخل عشرات المؤثرات الصوتية فوق صوت الراوي.',
    problemEn: 'Arabic captions lagged behind card reveal animations, while redundant sound effects drowned out voice narration.',
    decisionAr: 'مزامنة زمن كشف النص مع البطاقة داخل المترجم الرسومي، وتوجيه الصوت عبر محرك خلط يخفض المؤثرات تلقائيًا أثناء الكلام (RMS Voice Ducking).',
    decisionEn: 'Synchronized text-card reveal windows in the compiler and routed audio through an RMS envelope voice-ducking mixer.',
    outcomeAr: 'اجتياز بوابة الفحص الآلي بانحراف صوت/صورة أقل من 0.35 ثانية وصفر بتر لصوت الراوي.',
    outcomeEn: 'Passed automated QA verification with <0.35s A/V drift and zero narration clipping.',
  },
  {
    badgeAr: 'إصلاح موثق بالدليل · Verified Fix',
    badgeEn: 'Verified Fix · Call-Chain Audit',
    badgeStyle: 'bg-emerald-500/15 text-emerald-300 border-emerald-400/30',
    projectTitleAr: 'نظام الجدول المدرسي الذكي',
    projectTitleEn: 'Smart School Timetable System',
    href: `/${locale}/projects/school-timetable#engineering-deep-dive`,
    titleAr: 'تحويل التعديل اليدوي للجدول من استبدال صامت إلى إصلاح ذكي قابل للتفسير',
    titleEn: 'Turning Silent Schedule Overwrites into Explainable Smart Repair',
    problemAr: 'سحب حصة إلى موعد مشغول كان يستبدل الجدول في قاعدة البيانات دون توضيح الحصص الأخرى التي تحركت أو احترام الحصص المثبتة.',
    problemEn: 'Dragging a lesson onto an occupied slot previously overwrote SQLite entries without showing displaced lessons or respecting pinned slots.',
    decisionAr: 'توحيد المسار عبر أمر نقل موحد يعرض جدول الحصص المزاحة وسبب نقل كل حصة قبل الاعتماد، مع حفظ حالة التثبيت في قاعدة البيانات.',
    decisionEn: 'Unified the drag-and-drop pipeline to present a causal displacement diff table before saving, while persisting pinned lesson locks in SQLite.',
    outcomeAr: 'شفافية كاملة لمدير المدرسة قبل حفظ أي تعديل، مع إمكانية التراجع الفوري وصفر فقدان للبيانات.',
    outcomeEn: '100% pre-commit visibility into ripple effects with instant rollback safety.',
  },
  {
    badgeAr: 'تصميم وقائي · Preventive Design',
    badgeEn: 'Preventive Design · Unit-Test Proven',
    badgeStyle: 'bg-blue-500/15 text-blue-300 border-blue-400/30',
    projectTitleAr: 'متجر سول للأحذية (SOLE)',
    projectTitleEn: 'SOLE Footwear Marketplace',
    href: `/${locale}/projects/remix-sole-marketplace#engineering-deep-dive`,
    titleAr: 'حماية المتجر من الملفات الخبيثة المنتحلة واستهلاك حصص الصور السحابية',
    titleEn: 'Blocking Spoofed File Uploads & Protecting Cloud Media Quotas',
    problemAr: 'الاعتماد على امتداد الصورة فقط يسمح برفع ملفات برمجية خبيثة متنكرة كصور، كما أن فحص السحابة مع كل زائر يبطئ المتجر.',
    problemEn: 'Trusting file extensions allows disguised SVG/EXE uploads, while scanning cloud folders on every visitor request exhausts API quotas.',
    decisionAr: 'فحص البايتات الثنائية الأولى (Magic Bytes) لكل صورة مرفوعة، وفصل زيارات العملاء لتقرأ من قاعدة البيانات والنسخة الاحتياطية فقط.',
    decisionEn: 'Implemented binary Magic-Byte header verification on uploads and isolated visitor traffic to database/static fallback reads.',
    outcomeAr: 'صد 100% للملفات المزيفة في اختبارات الأمان الآلية وعرض 506 منتجًا بسرعة عالية دون استهلاك حصة الـ API.',
    outcomeEn: '100% automated test rejection of spoofed files and zero live Cloudinary Admin API scans on customer visits.',
  },
];

// F. About / Approach
const approachSteps = [
  {
    step: '01',
    titleAr: 'فهم المشكلة والقيود الواقعية أولًا',
    titleEn: 'Start From the Problem & Real Constraints',
    bodyAr: 'أبدأ بتحديد أين تضيع ساعات العمل أو أين يفشل النظام في الواقع (مثل انقطاع الشبكة، أو بيانات الإدخال غير المنظمة، أو تعارض القيود) قبل اختيار الأداة.',
    bodyEn: 'I begin by identifying where manual time is lost or where edge cases break in reality (network drops, messy inputs, conflicting rules) before choosing tools.',
  },
  {
    step: '02',
    titleAr: 'تصميم معماري يعزل الأخطاء ويحمي البيانات',
    titleEn: 'Design Boundaries That Isolate Faults',
    bodyAr: 'أقسم النظام إلى مراحل واضحة بعقود بيانات محددة؛ بحيث إذا تعثرت خطوة واحدة يسهل تشخيصها وإعادتها دون إتلاف المخرجات المعتمدة.',
    bodyEn: 'Systems are structured around clear data contracts and isolated execution scopes so partial failures never corrupt approved data.',
  },
  {
    step: '03',
    titleAr: 'التحقق المستقل والقياس الفعلي',
    titleEn: 'Verify Output Independently & Measure',
    bodyAr: 'أبني أدوات فحص واختبارات آلية تتحقق من النتيجة النهائية (سواء كانت جدولًا مدرسيًا، أو فيديو مرندرًا، أو واجهة متجر) قبل اعتبار العمل مكتملًا.',
    bodyEn: 'Automated validators and test suites verify the final artifact — whether a timetable, rendered video, or API response — before shipping.',
  },
];

const pageTitle =
  locale === 'ar'
    ? `${SITE_CONFIG.ownerNameAr} — ${SITE_CONFIG.roleTitleAr}`
    : `${SITE_CONFIG.ownerNameEn} — ${SITE_CONFIG.roleTitleEn}`;
const pageDesc = locale === 'ar' ? SITE_CONFIG.heroSubheadingAr : SITE_CONFIG.heroSubheadingEn;
---

<BaseLayout title={pageTitle} description={pageDesc} locale={locale} currentPath={`/${locale}/`}>
  <!-- B. HERO / ABOVE THE FOLD (Clean, Human, Value-First + Studio Portrait) -->
  <section class="relative border-b border-white/10 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <!-- Text Column (7 Cols) -->
        <div class="lg:col-span-7 space-y-5">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/[0.06] border border-white/15 text-xs font-semibold text-blue-300">
            <span class="w-2 h-2 rounded-full bg-amber-400" aria-hidden="true"></span>
            <span>
              {locale === 'ar' ? SITE_CONFIG.roleTitleAr : SITE_CONFIG.roleTitleEn}
            </span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white leading-[1.18]">
            {locale === 'ar' ? SITE_CONFIG.heroHeadingAr : SITE_CONFIG.heroHeadingEn}
          </h1>

          <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl">
            {locale === 'ar' ? SITE_CONFIG.heroSubheadingAr : SITE_CONFIG.heroSubheadingEn}
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-3.5">
            <a
              href="#featured-work"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm shadow-lg shadow-blue-600/25 transition-colors min-h-[46px]"
            >
              <span>{t.heroPrimaryCta}</span>
            </a>
            <a
              href={`/${locale}/expertise`}
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white/[0.06] hover:bg-white/10 text-slate-100 font-semibold text-sm border border-white/15 transition-colors min-h-[46px]"
            >
              <span>{t.heroSecondaryCta}</span>
            </a>
          </div>

          <!-- Concise Real Proof Highlights (Understandable in 5 Seconds) -->
          <div class="pt-5 grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs">
            <div class="p-3 rounded-xl bg-white/[0.04] border border-white/10">
              <strong class="text-white block text-sm">7 {locale === 'ar' ? 'مشاريع حقيقية' : 'Real Systems'}</strong>
              <span class="text-slate-400">
                {locale === 'ar' ? 'مفحوصة وموثقة بالكود' : 'Documented with code proof'}
              </span>
            </div>
            <div class="p-3 rounded-xl bg-white/[0.04] border border-white/10">
              <strong class="text-white block text-sm">Web · Mobile · AI</strong>
              <span class="text-slate-400">
                {locale === 'ar' ? 'تطبيقات ومحركات أتمتة' : 'Full-stack & automation'}
              </span>
            </div>
            <div class="col-span-2 sm:col-span-1 p-3 rounded-xl bg-white/[0.04] border border-white/10">
              <strong class="text-amber-300 block text-sm">
                {locale === 'ar' ? 'عربي / English' : 'Arabic & English'}
              </strong>
              <span class="text-slate-400">
                {locale === 'ar' ? 'واجهات وتقارير RTL أصلية' : 'Native RTL & bilingual UX'}
              </span>
            </div>
          </div>
        </div>

        <!-- Studio Portrait Column (5 Cols — Matches Fixed Background Gradient) -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="relative w-full max-w-[330px] sm:max-w-[370px]">
            <div
              class="absolute -inset-2 rounded-[28px] bg-gradient-to-tr from-blue-600/40 via-transparent to-amber-500/35 blur-xl opacity-80"
              aria-hidden="true"
            ></div>

            <div class="relative rounded-3xl glass-panel-elevated p-2.5 shadow-2xl overflow-hidden">
              <div class="relative rounded-2xl overflow-hidden aspect-square bg-[#050914]">
                <img
                  src="/media/profile/ahmed-abdellah.webp"
                  alt={
                    locale === 'ar'
                      ? 'أحمد عبد الله — مهندس برمجيات ومعماري أنظمة ذكية'
                      : 'Ahmed Abdellah — Software Engineer & Systems Architect'
                  }
                  width="800"
                  height="800"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  class="w-full h-full object-cover object-top"
                />
                <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-[#050914] via-[#050914]/70 to-transparent"></div>

                <div class="absolute bottom-3.5 inset-x-4 flex items-end justify-between gap-2">
                  <div>
                    <span class="block font-extrabold text-white text-base leading-tight">
                      {locale === 'ar' ? SITE_CONFIG.ownerNameAr : SITE_CONFIG.ownerNameEn}
                    </span>
                    <span class="text-xs text-blue-300">
                      {locale === 'ar' ? 'برمجة · أتمتة · ذكاء اصطناعي' : 'Software · Automation · AI'}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- C. FEATURED WORK — IMMEDIATELY AFTER HERO (3 Strong, Diverse Projects) -->
  <section id="featured-work" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
      <div class="max-w-2xl">
        <span class="font-mono text-xs uppercase tracking-wider text-amber-400 font-bold">
          {locale === 'ar' ? 'أبرز الأعمال المختارة' : 'Selected Flagship Projects'}
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">
          {t.featuredSectionTitle}
        </h2>
        <p class="text-sm sm:text-base text-slate-300 mt-2 leading-relaxed">
          {t.featuredSectionSub}
        </p>
      </div>
      <a
        href={`/${locale}/projects`}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white/[0.08] hover:bg-blue-600 text-white text-xs sm:text-sm font-semibold border border-white/15 transition-colors shrink-0 min-h-[42px]"
      >
        <span>{t.viewAllProjects}</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
      {featuredProjects.map((entry, idx) => (
        <ProjectCard project={entry.data} locale={locale} index={idx} />
      ))}
    </div>

    <div class="mt-10 text-center">
      <a
        href={`/${locale}/projects`}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white/[0.06] hover:bg-blue-600 text-white text-sm font-semibold border border-white/15 transition-colors min-h-[44px]"
      >
        <span>
          {locale === 'ar'
            ? 'تصفح جميع المشاريع السبعة مع البحث والتصفية ←'
            : 'Browse All 7 Projects with Search & Filtering →'}
        </span>
      </a>
    </div>
  </section>

  <!-- D. WHAT I BUILD / EXPERTISE (4 Understandable Value Groups) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-3xl mb-10">
      <span class="font-mono text-xs uppercase tracking-wider text-blue-400 font-bold">
        {locale === 'ar' ? 'ماذا أبني؟' : 'What I Build'}
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">
        {locale === 'ar'
          ? 'مجالات الخبرة والقيمة التي أقدمها'
          : 'Core Capabilities & Practical Engineering Value'}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {expertiseGroups.map((grp, idx) => (
        <div
          style={`--reveal-delay: ${idx * 60}ms`}
          class="reveal-item interactive-card glass-panel rounded-2xl p-6 sm:p-7 flex flex-col justify-between gap-4"
        >
          <div>
            <h3 class="text-lg sm:text-xl font-bold text-white mb-2">
              {locale === 'ar' ? grp.titleAr : grp.titleEn}
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              {locale === 'ar' ? grp.valueAr : grp.valueEn}
            </p>
          </div>
          <div class="pt-3 border-t border-white/10 flex items-center justify-between gap-2 text-xs">
            <a href={grp.exampleHref} class="text-amber-300 hover:text-amber-200 font-semibold hover:underline">
              {locale === 'ar' ? grp.exampleLabelAr : grp.exampleLabelEn}
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- E. PROBLEM SOLVING / ENGINEERING HIGHLIGHTS (3 Verified Stories) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
      <div class="max-w-3xl">
        <span class="font-mono text-xs uppercase tracking-wider text-amber-400 font-bold">
          {locale === 'ar' ? 'نماذج من حل المشكلات الهندسية' : 'Engineering Problem-Solving Highlights'}
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">
          {locale === 'ar'
            ? 'مشكلات حقيقية واجهتها وكيف عالجتها بالدليل'
            : 'Real Engineering Bottlenecks & Verified Solutions'}
        </h2>
        <p class="text-sm text-slate-300 mt-2">
          {locale === 'ar'
            ? 'أمثلة موثقة من الكود المصدري توضح طريقة التعامل مع الأعطال المعقدة وتصميم الحواجز الوقائية.'
            : 'Documented examples from source repositories showing root-cause fixes and preventive architectural choices.'}
        </p>
      </div>
      <a
        href={`/${locale}/expertise`}
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/[0.06] hover:bg-blue-600 text-white text-xs font-semibold border border-white/15 transition-colors shrink-0"
      >
        <span>{locale === 'ar' ? 'مصفوفة الخبرات والأدلة الكاملة' : 'Full Expertise & Proof Matrix'}</span>
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {engineeringStories.map((st, idx) => (
        <article
          style={`--reveal-delay: ${idx * 70}ms`}
          class="reveal-item interactive-card glass-panel rounded-2xl p-6 flex flex-col justify-between gap-5"
        >
          <div class="space-y-4">
            <div class="flex items-center justify-between gap-2 flex-wrap">
              <span class:list={['px-2.5 py-1 rounded-full text-[11px] font-semibold border', st.badgeStyle]}>
                {locale === 'ar' ? st.badgeAr : st.badgeEn}
              </span>
              <span class="text-xs font-mono text-slate-400">
                {locale === 'ar' ? st.projectTitleAr : st.projectTitleEn}
              </span>
            </div>

            <h3 class="text-base sm:text-lg font-bold text-white leading-snug">
              {locale === 'ar' ? st.titleAr : st.titleEn}
            </h3>

            <div class="space-y-2.5 text-xs sm:text-sm">
              <div class="p-3 rounded-xl bg-rose-950/30 border border-rose-500/20">
                <strong class="text-rose-300 block mb-0.5">{locale === 'ar' ? 'المشكلة:' : 'Problem:'}</strong>
                <span class="text-slate-200">{locale === 'ar' ? st.problemAr : st.problemEn}</span>
              </div>
              <div class="p-3 rounded-xl bg-blue-950/30 border border-blue-500/20">
                <strong class="text-blue-300 block mb-0.5">{locale === 'ar' ? 'القرار الهندسي:' : 'Engineering Decision:'}</strong>
                <span class="text-slate-200">{locale === 'ar' ? st.decisionAr : st.decisionEn}</span>
              </div>
              <div class="p-3 rounded-xl bg-emerald-950/30 border border-emerald-500/20">
                <strong class="text-emerald-300 block mb-0.5">{locale === 'ar' ? 'النتيجة الموثقة:' : 'Verified Outcome:'}</strong>
                <span class="text-slate-200">{locale === 'ar' ? st.outcomeAr : st.outcomeEn}</span>
              </div>
            </div>
          </div>

          <a
            href={st.href}
            class="inline-flex items-center justify-between px-4 py-2 rounded-xl bg-white/[0.05] hover:bg-blue-600 text-xs font-semibold text-white border border-white/10 transition-colors"
          >
            <span>{locale === 'ar' ? 'اقرأ التفاصيل والدليل في دراسة الحالة' : 'Read Case Study & Code Proof'}</span>
            <span>{locale === 'ar' ? '←' : '→'}</span>
          </a>
        </article>
      ))}
    </div>
  </section>

  <!-- F. ABOUT / APPROACH -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="glass-panel rounded-3xl p-7 sm:p-10">
      <div class="max-w-3xl mb-8">
        <span class="font-mono text-xs uppercase tracking-wider text-blue-400 font-bold">
          {locale === 'ar' ? 'منهجية العمل' : 'Working Approach'}
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">
          {locale === 'ar'
            ? 'كيف أعمل على بناء الأنظمة وحل المشكلات؟'
            : 'How I Approach Complex Engineering Problems'}
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {approachSteps.map((step, idx) => (
          <div
            style={`--reveal-delay: ${idx * 70}ms`}
            class="reveal-item bg-white/[0.04] rounded-2xl p-6 border border-white/10"
          >
            <span class="font-mono text-xs font-bold px-2.5 py-1 rounded-lg bg-blue-600/25 text-amber-300 border border-amber-400/30">
              {step.step}
            </span>
            <h3 class="text-lg font-bold text-white mt-4 mb-2">
              {locale === 'ar' ? step.titleAr : step.titleEn}
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              {locale === 'ar' ? step.bodyAr : step.bodyEn}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- G. CONTACT CTA -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
    <CTA locale={locale} />
  </div>
</BaseLayout>
