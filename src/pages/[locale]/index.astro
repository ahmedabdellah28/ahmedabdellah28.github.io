---
import { getCollection } from "astro:content";
import { SITE_CONFIG } from "../../config/site";
import "../../styles/global.css";
export function getStaticPaths() {
  return ["ar", "en"].map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: "ar" | "en" };
const ar = locale === "ar";
const text = (a: string, e: string) => (ar ? a : e);
const projects = (
  await getCollection("projects", ({ data }) => data.visibility === "published")
).sort((a, b) => a.data.featuredOrder - b.data.featuredOrder);
const name = ar ? SITE_CONFIG.ownerNameAr : SITE_CONFIG.ownerNameEn;
const nav = [
  ["work", text("الأعمال", "Work")],
  ["expertise", text("الخبرات", "Expertise")],
  ["about", text("عنّي", "About")],
  ["contact", text("التواصل", "Contact")],
];
const strengths = [
  [
    text("تطبيقات ويب وموبايل", "Web & mobile apps"),
    text(
      "واجهات واضحة وأنظمة متكاملة، من المتاجر إلى تطبيقات الخدمات الطبية.",
      "Clear interfaces and connected systems, from storefronts to healthcare apps.",
    ),
    "Flutter · React · TypeScript",
  ],
  [
    text("ذكاء اصطناعي وأتمتة", "AI & automation"),
    text(
      "تحويل المهام المتكررة وإنتاج الوسائط إلى خطوات قابلة للتشغيل والفحص.",
      "Turning repeatable tasks and media production into testable workflows.",
    ),
    "Python · FFmpeg · Computer Vision",
  ],
  [
    text("حلول جدولة وأنظمة موثوقة", "Scheduling & reliable systems"),
    text(
      "حل القيود المعقدة، والتحقق من النتائج، والتعافي عند انقطاع الاتصال.",
      "Solving complex constraints, checking outputs, and recovering from network failures.",
    ),
    "OR-Tools · Kotlin · SQLite",
  ],
];
const status: Record<string, string> = {
  production: text("مكتمل وقابل للتشغيل", "Complete & runnable"),
  functional: text("نواة وظيفية عاملة", "Functional core"),
  prototype: text("نموذج أولي", "Prototype"),
  in_progress: text("قيد التطوير", "In progress"),
  concept: text("تصور معماري", "Architecture concept"),
  unknown: text("قيد المراجعة", "Under review"),
};
const title = `${name} | ${text("برمجيات وذكاء اصطناعي وأتمتة", "Software, AI & Automation")}`;
const desc = ar ? SITE_CONFIG.taglineAr : SITE_CONFIG.taglineEn;
const origin = SITE_CONFIG.contact.domain;
const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  inLanguage: locale,
  name: title,
  mainEntity: {
    "@type": "Person",
    name,
    url: origin,
    image: `${origin}/media/profile/ahmed-abdellah.webp`,
    jobTitle: ar ? SITE_CONFIG.roleTitleAr : SITE_CONFIG.roleTitleEn,
    sameAs: [SITE_CONFIG.contact.github],
  },
};
---

<!doctype html>
<html lang={locale} dir={ar ? "rtl" : "ltr"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={`${origin}/${locale}/`} />
    <link rel="alternate" hreflang="ar" href={`${origin}/ar/`} />
    <link rel="alternate" hreflang="en" href={`${origin}/en/`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${origin}/${locale}/`} />
    <meta
      property="og:image"
      content={`${origin}/media/profile/ahmed-abdellah.webp`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" hreflang="x-default" href={`${origin}/ar/`} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(profileSchema).replace(/</g, "\\u003c")}
    />
  </head>
  <body>
    <a class="skip" href="#main">
      {text("تخطي إلى المحتوى", "Skip to content")}
    </a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="#top">
          <img
            src="/media/profile/ahmed-abdellah-thumb.webp"
            width="38"
            height="38"
            alt=""
          />
          <strong>{name}</strong>
        </a>
        <nav aria-label={text("التنقل الرئيسي", "Main navigation")}>
          {nav.map(([id, label]) => (
            <a href={`#${id}`}>{label}</a>
          ))}
        </nav>
        <a class="language" href={ar ? "/en/" : "/ar/"} lang={ar ? "en" : "ar"}>
          {text("English", "العربية")}
        </a>
      </div>
    </header>
    <main id="main">
      <section id="top" class="hero wrap">
        <div class="hero-copy">
          <p class="eyebrow">
            {text(
              "برمجيات · ذكاء اصطناعي · أتمتة",
              "SOFTWARE · AI · AUTOMATION",
            )}
          </p>
          <p class="intro">{text("أنا احمد عبداللاه", "I’m Ahmed Abdellah")}</p>
          <h1>
            {text("أفكار معقدة.", "Complex ideas.")}
            <br />
            <span>{text("حلول قابلة للاستخدام.", "Usable software.")}</span>
          </h1>
          <p class="lead">
            {text(
              "أصمّم وأبني تطبيقات ويب وموبايل وأنظمة ذكية، من فهم المشكلة إلى واجهة واضحة ونتيجة يمكن فحصها.",
              "I design and build web apps, mobile apps, and intelligent systems, from understanding the problem to a clear interface and a testable result.",
            )}
          </p>
          <div class="actions">
            <a class="button primary" href="#work">
              {text("استكشف أعمالي", "Explore my work")}{" "}
              <span aria-hidden="true">↓</span>
            </a>
            <a class="button secondary" href="#about">
              {text("تعرّف عليّ", "About me")}
            </a>
          </div>
          <div class="hero-note">
            <span class="dot"></span>
            {text(
              "٧ مشاريع في التطبيقات والأتمتة والأنظمة الذكية",
              "7 projects across apps, automation & intelligent systems",
            )}
          </div>
        </div>
        <figure class="portrait">
          <img
            src="/media/profile/ahmed-abdellah.webp"
            alt={name}
            width="800"
            height="800"
            fetchpriority="high"
          />
          <figcaption>
            <span>{text("من الفكرة إلى النظام", "FROM IDEA TO SYSTEM")}</span>
            <strong>Ahmed Abdellah</strong>
          </figcaption>
        </figure>
      </section>
      <section id="work" class="wrap section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">01 / {text("الأعمال", "WORK")}</p>
            <h2>
              {text(
                "كل مشروع يبدأ بمشكلة.",
                "Every project starts with a problem.",
              )}
            </h2>
          </div>
          <p>
            {text(
              "النتيجة أولًا. التفاصيل والصور والأدلة داخل كل مشروع، من غير ما تخرج من الصفحة.",
              "The result comes first. Open any project for details, screenshots, and evidence without leaving this page.",
            )}
          </p>
        </div>
        <div class="project-list">
          {projects.map(({ data: p }, i) => {
            const photo = p.screenshots[0];
            return (
              <article class="project" id={`project-${p.slug}`}>
                <div class="project-cover">
                  {photo ? (
                    <img
                      src={photo.src}
                      alt={ar ? photo.altAr : photo.altEn}
                      width={photo.width}
                      height={photo.height}
                      loading="lazy"
                    />
                  ) : (
                    <div class="engine-cover" aria-hidden="true">
                      <span>{p.category.includes("API") ? "{ }" : "⌘"}</span>
                      <small>{text("محرك أتمتة", "AUTOMATION ENGINE")}</small>
                    </div>
                  )}
                </div>
                <div class="project-copy">
                  <div class="project-meta">
                    <span class="project-number">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <span>{ar ? p.humanCategoryAr : p.humanCategoryEn}</span>
                    <span class="status">{status[p.status]}</span>
                  </div>
                  <h3>{ar ? p.titleAr : p.titleEn}</h3>
                  <p class="value">
                    {ar ? p.valuePropositionAr : p.valuePropositionEn}
                  </p>
                  <div class="project-outcome">
                    <span>{text("من نتائج المشروع", "PROJECT RESULT")}</span>
                    <p>
                      <strong dir="auto">{p.results[0].metric}</strong>{" "}
                      {ar ? p.results[0].labelAr : p.results[0].labelEn}
                    </p>
                  </div>
                  <p class="tech-preview" dir="ltr">
                    {p.technologies.slice(0, 4).join(" · ")}
                  </p>
                </div>
                <details class="project-details">
                  <summary>
                    <span>
                      {text(
                        "تفاصيل المشروع والصور والأدلة",
                        "Project details, screenshots & evidence",
                      )}
                    </span>
                    <span class="plus" aria-hidden="true">
                      +
                    </span>
                  </summary>
                  <div class="detail-body">
                    <div class="detail-grid">
                      <div>
                        <h4>{text("المشكلة", "The problem")}</h4>
                        <p>{p.problem[locale]}</p>
                      </div>
                      <div>
                        <h4>{text("الحل", "The solution")}</h4>
                        <p>{p.solution[locale]}</p>
                      </div>
                      <div>
                        <h4>{text("الدور والجمهور", "Role & audience")}</h4>
                        <p>{p.role[locale]}</p>
                        <p>{p.audience[locale]}</p>
                      </div>
                      <div>
                        <h4>
                          {text(
                            "الأثر مقارنة بالعمل اليدوي",
                            "Manual vs. automated",
                          )}
                        </h4>
                        <p>{p.manualVsAutomated[locale]}</p>
                      </div>
                    </div>
                    <h4>
                      {text("القدرات المنفّذة", "Implemented capabilities")}
                    </h4>
                    <ul class="capabilities">
                      {p.capabilities.map((c) => (
                        <li>{c[locale]}</li>
                      ))}
                    </ul>
                    <div class="metrics">
                      {p.results.map((r) => (
                        <div>
                          <strong dir="auto">{r.metric}</strong>
                          <p>{ar ? r.labelAr : r.labelEn}</p>
                          <small>
                            {text("مرجع المشروع: ", "Project reference: ")}
                            <bdi>{r.sourceRef}</bdi>
                          </small>
                        </div>
                      ))}
                    </div>
                    {p.screenshots.length > 0 && (
                      <div class="gallery">
                        {p.screenshots.map((s) => (
                          <figure>
                            <a
                              href={s.src}
                              target="_blank"
                              rel="noopener noreferrer"
                              aria-label={
                                text(
                                  "فتح الصورة بالحجم الكامل: ",
                                  "Open full-size image: ",
                                ) + (ar ? s.altAr : s.altEn)
                              }
                            >
                              <img
                                src={s.src}
                                alt={ar ? s.altAr : s.altEn}
                                width={s.width}
                                height={s.height}
                                loading="lazy"
                              />
                            </a>
                            <figcaption>
                              {ar ? s.captionAr : s.captionEn}
                            </figcaption>
                          </figure>
                        ))}
                      </div>
                    )}
                    <details class="technical">
                      <summary>
                        {text(
                          "التفاصيل الهندسية والمراجع",
                          "Engineering details & references",
                        )}
                      </summary>
                      <div class="technical-body">
                        <h4>{text("التقنيات", "Technologies")}</h4>
                        <p dir="ltr">{p.technologies.join(" · ")}</p>
                        <h4>{text("بنية النظام", "System architecture")}</h4>
                        <p>
                          {ar
                            ? p.architecture.overviewAr
                            : p.architecture.overviewEn}
                        </p>
                        <ol>
                          {p.architecture.pipelineSteps.map((s) => (
                            <li>
                              <strong>{ar ? s.titleAr : s.titleEn}</strong>
                              <p>{ar ? s.detailAr : s.detailEn}</p>
                            </li>
                          ))}
                        </ol>
                        <p>
                          {ar
                            ? p.architecture.systemBoundariesAr
                            : p.architecture.systemBoundariesEn}
                        </p>
                        <h4>
                          {text("التحديات والقرارات", "Challenges & decisions")}
                        </h4>
                        {p.challenges.map((c) => (
                          <div class="challenge">
                            <span class="evidence-state">
                              {c.type === "verified_fix"
                                ? text("إصلاح موثق بالمشروع", "Documented fix")
                                : c.type === "preventive_design"
                                  ? text("تصميم وقائي", "Preventive design")
                                  : c.type === "possible_risk"
                                    ? text(
                                        "خطر مرصود، وليس إصلاحًا مثبتًا",
                                        "Identified risk, not a verified fix",
                                      )
                                    : text("قيد المراجعة", "Under review")}
                            </span>
                            <h5>{ar ? c.titleAr : c.titleEn}</h5>
                            <p>{ar ? c.problemAr : c.problemEn}</p>
                            <p>{ar ? c.whyImportantAr : c.whyImportantEn}</p>
                            <p>{ar ? c.solutionAr : c.solutionEn}</p>
                            <p>{ar ? c.impactAr : c.impactEn}</p>
                            <p>{ar ? c.lessonAr : c.lessonEn}</p>
                            <small>
                              <bdi>{c.proofRef}</bdi>
                            </small>
                          </div>
                        ))}
                        <h4>
                          {text(
                            "مراجع الأدلة في المشروع",
                            "Project evidence references",
                          )}
                        </h4>
                        <p class="evidence-note">
                          {text(
                            "المراجع التالية محفوظة من ملف المشروع الأصلي. هي إحالات إلى الكود والاختبارات، وليست تدقيقًا مستقلًا جديدًا.",
                            "These references are preserved from the original project records. They point to source code and tests, not a new independent audit.",
                          )}
                        </p>
                        <ul class="evidence-list">
                          {p.evidence
                            .filter((e) => e.visibility === "public")
                            .map((e) => (
                              <li>
                                <strong>{ar ? e.claimAr : e.claimEn}</strong>
                                <small>
                                  {e.verificationStatus === "verified" &&
                                  e.relationType === "EXTRACTED"
                                    ? text(
                                        "موثق في سجل المشروع",
                                        "Documented in project record",
                                      )
                                    : text(
                                        "استنتاج أو غير متحقق منه",
                                        "Inferred or unverified",
                                      )}{" "}
                                  · {e.confidence}
                                </small>
                                <code>
                                  {e.evidencePath} : {e.lineOrSymbol}
                                </code>
                              </li>
                            ))}
                        </ul>
                      </div>
                    </details>
                  </div>
                </details>
              </article>
            );
          })}
        </div>
      </section>
      <section id="expertise" class="wrap section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">02 / {text("الخبرات", "EXPERTISE")}</p>
            <h2>{text("ما الذي أستطيع بناءه؟", "What can I build?")}</h2>
          </div>
        </div>
        <div class="strengths">
          {strengths.map(([h, p, tech], i) => (
            <article>
              <span class="project-number">0{i + 1}</span>
              <h3>{h}</h3>
              <p>{p}</p>
              <small dir="ltr">{tech}</small>
            </article>
          ))}
        </div>
      </section>
      <section id="about" class="wrap section about">
        <div>
          <p class="eyebrow">03 / {text("عنّي", "ABOUT")}</p>
          <h2>
            {text(
              "أهتم بما وراء الواجهة.",
              "Good software goes beyond the interface.",
            )}
          </h2>
        </div>
        <div>
          <p class="about-lead">
            {text(
              "أنا احمد عبداللاه، مهندس برمجيات أعمل على الربط بين حل المشكلة التقنية وتجربة المستخدم النهائية.",
              "I’m Ahmed Abdellah, a software engineer connecting technical problem-solving with the experience people actually use.",
            )}
          </p>
          <p>
            {text(
              "تشمل أعمالي إنتاج الوسائط بالذكاء الاصطناعي، وجدولة الحصص، والرؤية الحاسوبية على أندرويد، وتطبيقات الرعاية الصحية والتجارة الإلكترونية. أركز على وضوح تدفق البيانات، وعزل الأعطال، والتحقق من المخرجات بدلًا من الاكتفاء بأن النظام يعمل مرة واحدة.",
              "My projects span AI media production, school timetabling, Android computer vision, healthcare apps, and e-commerce. I focus on clear data flow, fault isolation, and output validation rather than a system that only works once.",
            )}
          </p>
          <div class="principles">
            <span>{text("فهم المشكلة", "Understand")}</span>
            <span>{text("بناء الحل", "Build")}</span>
            <span>{text("التحقق من النتيجة", "Validate")}</span>
          </div>
        </div>
      </section>
      <section id="contact" class="wrap section">
        <div class="contact-panel">
          <p class="eyebrow">04 / {text("لنكمل الحديث", "LET’S CONNECT")}</p>
          <h2>
            {text("لديك فكرة تحتاج إلى تنفيذ؟", "Have an idea to build?")}
          </h2>
          <p>
            {text(
              "يمكنك الاطلاع على حسابي ومشاريعي على GitHub.",
              "Explore my profile and repositories on GitHub.",
            )}
          </p>
          <a
            class="button primary"
            href={SITE_CONFIG.contact.github}
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    </main>
    <footer class="wrap">
      <span>© {name}</span>
      <a href="#top">{text("العودة للأعلى", "Back to top")} ↑</a>
      <a href={ar ? "/en/" : "/ar/"}>{text("English", "العربية")}</a>
    </footer>
    <script is:inline>
      // Deep links from the previous multi-page version open the matching project.
      function revealProject() {
        let id;
        try {
          id = decodeURIComponent(location.hash.slice(1));
        } catch {
          return;
        }
        const target = document.getElementById(id);
        if (target?.classList.contains("project")) {
          const details = target.querySelector("details");
          if (details) details.open = true;
          requestAnimationFrame(() => target.scrollIntoView());
        }
      }
      revealProject();
      window.addEventListener("hashchange", revealProject);
    </script>
  </body>
</html>
<style is:global>
  body {
    margin: 0;
    background: #080d18;
    color: #f4f6fb;
    line-height: 1.8;
  }
  * {
    box-sizing: border-box;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  img {
    max-width: 100%;
    display: block;
  }
  p,
  h1,
  h2,
  h3,
  h4,
  h5,
  figure {
    margin: 0;
  }
  p + p {
    margin-top: 12px;
  }
  .wrap {
    width: min(1160px, calc(100% - 64px));
    margin-inline: auto;
  }
  section,
  article[id] {
    scroll-margin-top: 112px;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: #080d18ed;
    backdrop-filter: blur(18px);
    border-bottom: 1px solid #ffffff12;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 82px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    white-space: nowrap;
  }
  .brand img {
    border-radius: 50%;
    object-fit: cover;
  }
  .brand strong {
    font-size: 16px;
  }
  nav {
    display: flex;
    gap: 28px;
    font-size: 14px;
    color: #b9c5d8;
  }
  nav a:hover,
  footer a:hover {
    color: #7fb5ff;
  }
  .language {
    border: 1px solid #ffffff28;
    padding: 6px 15px;
    border-radius: 9px;
    font-size: 13px;
  }
  .hero {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: center;
    gap: 72px;
    padding-block: 88px 100px;
    min-height: 720px;
  }
  .eyebrow {
    font-size: 12px;
    letter-spacing: 0.12em;
    font-weight: 700;
    color: #83b7fd;
  }
  .intro {
    margin-top: 23px;
    font-size: 20px;
    color: #cbd6e7;
  }
  h1 {
    font-size: clamp(38px, 4.8vw, 65px);
    line-height: 1.3;
    letter-spacing: -0.035em;
    margin: 12px 0 22px;
    font-weight: 800;
  }
  h1 span {
    color: #87b8ff;
  }
  .lead {
    font-size: 17px;
    color: #b4c2d7;
    max-width: 580px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 25px;
    min-height: 49px;
    border-radius: 10px;
    padding: 10px 23px;
    font-weight: 650;
    font-size: 14px;
  }
  .primary {
    background: #a3c8ff;
    color: #0c1a30;
  }
  .primary:hover {
    background: #c0daff;
  }
  .secondary {
    border: 1px solid #ffffff30;
    color: #d3deee;
  }
  .hero-note {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 12px;
    color: #8fa2bd;
    margin-top: 27px;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #7eb0f5;
    flex-shrink: 0;
  }
  .portrait {
    border-radius: 24px;
    overflow: hidden;
    background: #132139;
