---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkillProof from '../../components/SkillProof.astro';
import CTA from '../../components/CTA.astro';
import { ENGINEERING_STRENGTHS } from '../../config/skills';

export function getStaticPaths() {
  return [{ params: { locale: 'ar' } }, { params: { locale: 'en' } }];
}

const { locale } = Astro.params as { locale: 'ar' | 'en' };
const published = await getCollection('projects', ({ data }) => data.visibility === 'published');

const projectTitlesMap: Record<string, { ar: string; en: string }> = {};
for (const p of published) {
  projectTitlesMap[p.data.slug] = { ar: p.data.titleAr, en: p.data.titleEn };
}

const pageTitle =
  locale === 'ar'
    ? 'مصفوفة الخبرات والأدلة التقنية — مهارات مثبتة بالكود'
    : 'Skills & Evidence Matrix — Capabilities Proven by Source Code';
const pageDesc =
  locale === 'ar'
    ? 'كل مهارة في هذه المصفوفة مستنتجة من قرارات وحلول برمجية موثقة بالملف والسطر عبر 7 مشاريع حقيقية.'
    : 'Every engineering capability in this matrix is backed by concrete architectural decisions, tests, and file/line references across 7 codebases.';
---

<BaseLayout title={pageTitle} description={pageDesc} locale={locale} currentPath={`/${locale}/expertise`}>
  <section class="bg-[#0B1220] text-white border-b border-[#182438] py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="font-mono text-xs uppercase tracking-wider text-[#18B8A7]">
        {locale === 'ar' ? 'الدليل قبل الادعاء · 6 مجالات هندسية' : 'Evidence Before Claim · 6 Core Domains'}
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold mt-2">
        {locale === 'ar' ? 'مصفوفة الخبرات والأدلة التقنية' : 'Engineering Expertise & Proof Matrix'}
      </h1>
      <p class="text-sm sm:text-base text-slate-300 mt-3 max-w-3xl leading-relaxed">
        {locale === 'ar'
          ? 'بدلًا من سرد قوائم شعارات عامة، توثق هذه الصفحة القدرات الهندسية التي يثبتها الكود المصدري فعليًا: ماذا تعني لصاحب العمل، وكيف نُفذت تقنيًا، وأي المشاريع والملفات تبرهن عليها.'
          : 'Rather than listing unverified buzzwords, this matrix links every capability to its business value, technical implementation, supporting projects, and exact source-code evidence.'}
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
    {ENGINEERING_STRENGTHS.map((strength) => (
      <SkillProof strength={strength} locale={locale} projectTitlesMap={projectTitlesMap} />
    ))}
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <CTA locale={locale} />
  </div>
</BaseLayout>
