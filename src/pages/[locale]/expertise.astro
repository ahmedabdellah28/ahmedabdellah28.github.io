---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkillProof from '../../components/SkillProof.astro';
import CTA from '../../components/CTA.astro';
import { ENGINEERING_STRENGTHS } from '../../config/skills';

export function getStaticPaths() {
  return [{ params: { locale: 'ar' } }, { params: { locale: 'en' } }];
}

const { locale } = Astro.params as { locale: 'ar' | 'en' };
const published = await getCollection('projects', ({ data }) => data.visibility === 'published');

const projectTitlesMap: Record<string, { ar: string; en: string }> = {};
for (const p of published) {
  projectTitlesMap[p.data.slug] = { ar: p.data.titleAr, en: p.data.titleEn };
}

const pageTitle =
  locale === 'ar'
    ? 'الخبرات والقدرات الهندسية — احمد عبداللاه'
    : 'Engineering Expertise & Capabilities — Ahmed Abdellah';
const pageDesc =
  locale === 'ar'
    ? 'مصفوفة الخبرات الهندسية المرتبطة بالمشاريع الحقيقية والأدلة البرمجية عبر 7 أنظمة.'
    : 'Engineering capabilities backed by concrete architectural decisions, tests, and source-code evidence across 7 codebases.';
---

<BaseLayout title={pageTitle} description={pageDesc} locale={locale} currentPath={`/${locale}/expertise`}>
  <section class="border-b border-white/10 py-12 sm:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="font-mono text-xs uppercase tracking-wider text-amber-400">
        {locale === 'ar' ? 'الخبرات الهندسية الموثقة · 6 مجالات' : 'Verified Engineering Domains · 6 Areas'}
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white mt-2">
        {locale === 'ar' ? 'الخبرات والأدلة التقنية' : 'Engineering Expertise & Proof Matrix'}
      </h1>
      <p class="text-sm sm:text-base text-slate-300 mt-3 max-w-3xl leading-relaxed">
        {locale === 'ar'
          ? 'بدلًا من سرد قوائم تقنيات عامة، توثق هذه الصفحة القدرات الهندسية التي يثبتها الكود المصدري فعليًا: ماذا تعني لصاحب العمل، وكيف نُفذت تقنيًا، وأي المشاريع تبرهن عليها.'
          : 'Rather than listing unverified buzzwords, this matrix links every capability to its practical business value, technical implementation, and supporting projects.'}
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
    {ENGINEERING_STRENGTHS.map((strength) => (
      <SkillProof strength={strength} locale={locale} projectTitlesMap={projectTitlesMap} />
    ))}
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <CTA locale={locale} />
  </div>
</BaseLayout>
