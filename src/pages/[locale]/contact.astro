---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../../config/site';

export function getStaticPaths() {
  return [{ params: { locale: 'ar' } }, { params: { locale: 'en' } }];
}

const { locale } = Astro.params as { locale: 'ar' | 'en' };
const verifiedEmail = SITE_CONFIG.contact.emailStatus === 'verified' ? SITE_CONFIG.contact.email : null;
const formEndpoint = SITE_CONFIG.contact.formEndpoint;

const pageTitle =
  locale === 'ar'
    ? 'التواصل ومناقشة المشاريع — احمد عبداللاه'
    : 'Contact & Project Brief — Ahmed Abdellah';
const pageDesc =
  locale === 'ar'
    ? 'تواصل مع احمد عبداللاه عبر القنوات الرسمية المتحققة وجهّز ملخص مشروعك أو متطلباتك الهندسية.'
    : 'Connect with Ahmed Abdellah via verified channels and prepare a structured project or engineering brief.';
---

<BaseLayout title={pageTitle} description={pageDesc} locale={locale} currentPath={`/${locale}/contact`}>
  <section class="border-b border-white/10 py-12 sm:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="font-mono text-xs uppercase tracking-wider text-amber-400">
        {locale === 'ar' ? 'تواصل مباشر' : 'Direct Contact'}
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white mt-2">
        {locale === 'ar' ? 'ناقش معي مشروعك أو احتياجك الهندسي' : 'Discuss Your Project or Engineering Role'}
      </h1>
      <p class="text-sm sm:text-base text-slate-300 mt-3 max-w-3xl leading-relaxed">
        {locale === 'ar'
          ? 'يمكنك التواصل عبر حساب GitHub الرسمي الموثق أدناه، واستخدام أداة تحضير الملخص السريع لتنسيق تفاصيل مشروعك ونسخها مباشرة.'
          : 'Connect via the verified GitHub profile below, and use the quick brief formatter to structure and copy your project requirements.'}
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Left Column: Verified Channels Only -->
    <div class="space-y-6">
      <div class="glass-panel rounded-2xl p-6 space-y-4">
        <h2 class="text-lg font-bold text-white">
          {locale === 'ar' ? 'القنوات الرسمية المتاحة' : 'Verified Contact Channels'}
        </h2>

        <ul class="space-y-3 text-sm">
          <li class="p-4 rounded-xl bg-white/[0.04] border border-white/10 flex flex-col gap-1.5">
            <span class="text-xs font-mono text-amber-300">GitHub (Verified):</span>
            <a
              href={SITE_CONFIG.contact.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-blue-400 font-mono font-semibold hover:underline break-all"
            >
              {SITE_CONFIG.contact.github}
            </a>
          </li>

          {verifiedEmail && (
            <li class="p-4 rounded-xl bg-white/[0.04] border border-white/10 flex flex-col gap-1.5">
              <span class="text-xs font-mono text-amber-300">
                {locale === 'ar' ? 'البريد الإلكتروني:' : 'Direct Email:'}
              </span>
              <a
                href={`mailto:${verifiedEmail}`}
                class="text-blue-400 font-mono font-semibold hover:underline break-all"
              >
                {verifiedEmail}
              </a>
            </li>
          )}

          {SITE_CONFIG.contact.linkedin && (
            <li class="p-4 rounded-xl bg-white/[0.04] border border-white/10 flex flex-col gap-1.5">
              <span class="text-xs font-mono text-amber-300">LinkedIn:</span>
              <a
                href={SITE_CONFIG.contact.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="text-blue-400 font-mono font-semibold hover:underline break-all"
              >
                {SITE_CONFIG.contact.linkedin}
              </a>
            </li>
          )}
        </ul>
      </div>

      <div class="glass-panel rounded-2xl p-6 space-y-3">
        <span class="font-mono text-xs uppercase tracking-wider text-amber-400">
          {locale === 'ar' ? 'مجالات التعاون' : 'Collaboration Scope'}
        </span>
        <ul class="space-y-2 text-xs sm:text-sm text-slate-300">
          <li>• {locale === 'ar' ? 'بناء خطوط إنتاج وأتمتة بالذكاء الاصطناعي' : 'AI Production & Media Automation Pipelines'}</li>
          <li>• {locale === 'ar' ? 'أنظمة الجدولة والاستمثال الرياضي (OR-Tools CP-SAT)' : 'Mathematical Scheduling & Constraint Solvers'}</li>
          <li>• {locale === 'ar' ? 'الرؤية الحاسوبية وأتمتة الهواتف والمتصفحات' : 'Computer Vision (ZNCC/OCR) & Device Automation'}</li>
          <li>• {locale === 'ar' ? 'تطبيقات Flutter وReact/TypeScript المحصنة أمنيًا' : 'Hardened Flutter & Full-Stack TypeScript Apps'}</li>
        </ul>
      </div>
    </div>

    <!-- Right Column: Local Project Brief Formatter (Honest UX: never pretends to submit without a verified endpoint) -->
    <div class="lg:col-span-2 glass-panel rounded-2xl p-6 sm:p-8">
      <div class="mb-6">
        <span class="font-mono text-xs uppercase tracking-wider text-blue-400 font-bold">
          {locale === 'ar' ? 'مُنسق ملخص المشروع السريع' : 'Quick Project Brief Formatter'}
        </span>
        <h2 class="text-xl sm:text-2xl font-extrabold text-white mt-1">
          {locale === 'ar'
            ? 'جهّز ملخصًا واضحًا لمشروعك لنسخه ومشاركته'
            : 'Prepare a Structured Technical Brief to Copy & Share'}
        </h2>
        <p class="text-xs sm:text-sm text-slate-300 mt-1">
          {locale === 'ar'
            ? 'تساعدك هذه الأداة على ترتيب فكرتك أو متطلباتك التقنية في رسالة منظمة جاهزة للنسخ بضغطة زر.'
            : 'This local helper structures your requirements into a clean brief ready to copy in one click.'}
        </p>
      </div>

      <form
        id="static-contact-form"
        action={formEndpoint || undefined}
        method={formEndpoint ? 'POST' : undefined}
        class="space-y-4"
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="brief-type" class="block text-xs font-bold text-slate-200 mb-1.5">
              {locale === 'ar' ? 'نوع التعاون المطلوب' : 'Engagement Type'}
            </label>
            <select id="brief-type" name="engagement_type" class="w-full px-3.5 py-2.5 rounded-xl border border-white/15 text-sm bg-[#050914]/85 text-white">
              <option value={locale === 'ar' ? 'بناء نظام أو مشروع جديد' : 'Build a New System / Product'}>
                {locale === 'ar' ? 'بناء نظام أو مشروع جديد' : 'Build a New System / Product'}
              </option>
              <option value={locale === 'ar' ? 'أتمتة عملية يدوية معقدة' : 'Automate a Complex Manual Workflow'}>
                {locale === 'ar' ? 'أتمتة عملية يدوية معقدة' : 'Automate a Complex Manual Workflow'}
              </option>
              <option value={locale === 'ar' ? 'تدقيق معماري أو إصلاح أعطال حرجة' : 'Architectural Audit & Remediation'}>
                {locale === 'ar' ? 'تدقيق معماري أو إصلاح أعطال حرجة' : 'Architectural Audit & Remediation'}
              </option>
              <option value={locale === 'ar' ? 'فرصة توظيف / دور هندسي' : 'Engineering Role / Hiring Opportunity'}>
                {locale === 'ar' ? 'فرصة توظيف / دور هندسي' : 'Engineering Role / Hiring Opportunity'}
              </option>
            </select>
          </div>

          <div>
            <label for="brief-ref" class="block text-xs font-bold text-slate-200 mb-1.5">
              {locale === 'ar' ? 'أقرب مشروع مشابه في البورتفوليو' : 'Closest Reference Project'}
            </label>
            <select id="brief-ref" name="reference_project" class="w-full px-3.5 py-2.5 rounded-xl border border-white/15 text-sm bg-[#050914]/85 text-white">
              <option value="AION Studio (AI & Motion Graphics)">AION Studio (AI & Motion Graphics)</option>
              <option value="Smart School Timetable (CP-SAT Solver)">Smart School Timetable (CP-SAT Solver)</option>
              <option value="SOLE Marketplace (Full-Stack & Security)">SOLE Marketplace (Full-Stack & Security)</option>
              <option value="Enaya Platform (Flutter Monorepo)">Enaya Platform (Flutter Monorepo)</option>
              <option value="Phone Commander (Mobile Vision ZNCC)">Phone Commander (Mobile Vision ZNCC)</option>
              <option value="Multi-Slot Browser Automation Suite">Multi-Slot Browser Automation Suite</option>
            </select>
          </div>
        </div>

        <div>
          <label for="brief-goal" class="block text-xs font-bold text-slate-200 mb-1.5">
            {locale === 'ar' ? 'وصف مختصر للمشكلة أو الهدف' : 'Brief Description of Problem or Goal'}
          </label>
          <textarea
            id="brief-goal"
            name="message"
            rows="3"
            placeholder={
              locale === 'ar'
                ? 'اكتب باختصار ما الذي تريد بناءه أو أتمتته...'
                : 'Briefly describe what you want to build, optimize, or automate...'
            }
            class="w-full px-3.5 py-2.5 rounded-xl border border-white/15 text-sm bg-[#050914]/85 text-white placeholder:text-slate-500"
          ></textarea>
        </div>

        <div class="pt-2 space-y-3">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <span class="text-xs font-mono font-semibold text-slate-300">
              {locale === 'ar' ? 'الرسالة الجاهزة للنسخ:' : 'Formatted Brief Preview:'}
            </span>
            <div class="flex items-center gap-2.5 flex-wrap">
              <button
                id="copy-brief-btn"
                type="button"
                class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold transition-colors cursor-pointer min-h-[40px]"
              >
                {locale === 'ar' ? 'نسخ الملخص إلى الحافظة' : 'Copy Brief to Clipboard'}
              </button>
              {verifiedEmail && (
                <a
                  id="mailto-brief-btn"
                  href={`mailto:${verifiedEmail}`}
                  class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-white/[0.08] hover:bg-white/15 text-white text-xs font-semibold border border-white/15 transition-colors min-h-[40px]"
                >
                  <span>{locale === 'ar' ? 'فتح في تطبيق البريد' : 'Open in Email App'}</span>
                </a>
              )}
              <a
                href={SITE_CONFIG.contact.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-white/[0.08] hover:bg-white/15 text-white text-xs font-semibold border border-white/15 transition-colors min-h-[40px]"
              >
                <span>{locale === 'ar' ? 'زيارة حساب GitHub' : 'Open GitHub Profile'}</span>
              </a>
            </div>
          </div>

          <pre
            id="brief-preview"
            dir={locale === 'ar' ? 'rtl' : 'ltr'}
            style={`direction: ${locale === 'ar' ? 'rtl' : 'ltr'}; unicode-bidi: plaintext;`}
            class="p-4 rounded-xl bg-[#050914] text-amber-300 font-sans text-xs sm:text-sm whitespace-pre-wrap leading-relaxed border border-white/10 text-start"
          ></pre>
        </div>
      </form>
    </div>
  </section>

  <script is:inline define:vars={{ locale, verifiedEmail }}>
    const typeEl = document.getElementById('brief-type');
    const refEl = document.getElementById('brief-ref');
    const goalEl = document.getElementById('brief-goal');
    const previewEl = document.getElementById('brief-preview');
    const copyBtn = document.getElementById('copy-brief-btn');
    const mailtoBtn = document.getElementById('mailto-brief-btn');

    function updatePreview() {
      const tVal = typeEl?.value || '';
      const rVal = refEl?.value || '';
      const gVal = (goalEl?.value || '').trim() || (locale === 'ar' ? '[أضف تفاصيل الهدف هنا]' : '[Add goal details here]');

      let bodyText = '';
      let subjectText = '';
      if (locale === 'ar') {
        subjectText = `استفسار هندسي: ${tVal}`;
        bodyText = `مرحبًا أحمد،\nاطلعت على البورتفوليو الهندسي وأرغب في مناقشة:\n- نوع التعاون: ${tVal}\n- المشروع المرجعي الأقرب: ${rVal}\n- الهدف / المشكلة: ${gVal}`;
      } else {
        subjectText = `Engineering Inquiry: ${tVal}`;
        bodyText = `Hello Ahmed,\nI reviewed your engineering portfolio and would like to discuss:\n- Engagement Type: ${tVal}\n- Reference Case Study: ${rVal}\n- Goal / Problem Statement: ${gVal}`;
      }

      if (previewEl) {
        previewEl.textContent = bodyText;
      }
      if (mailtoBtn && verifiedEmail) {
        mailtoBtn.setAttribute(
          'href',
          `mailto:${verifiedEmail}?subject=${encodeURIComponent(subjectText)}&body=${encodeURIComponent(bodyText)}`
        );
      }
    }

    typeEl?.addEventListener('change', updatePreview);
    refEl?.addEventListener('change', updatePreview);
    goalEl?.addEventListener('input', updatePreview);
    updatePreview();

    copyBtn?.addEventListener('click', async () => {
      if (!previewEl?.textContent) return;
      try {
        await navigator.clipboard.writeText(previewEl.textContent);
        const orig = copyBtn.textContent;
        copyBtn.textContent = locale === 'ar' ? '✓ تم النسخ بنجاح' : '✓ Copied to Clipboard';
        setTimeout(() => {
          copyBtn.textContent = orig;
        }, 2000);
      } catch {}
    });
  </script>
</BaseLayout>
