---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTA from '../../components/CTA.astro';
import { SITE_CONFIG } from '../../config/site';

export function getStaticPaths() {
  return [{ params: { locale: 'ar' } }, { params: { locale: 'en' } }];
}

const { locale } = Astro.params as { locale: 'ar' | 'en' };

const pageTitle =
  locale === 'ar'
    ? 'عنّي ومنهجية العمل — أحمد عبد الله'
    : 'About & Engineering Methodology — Ahmed Abdellah';
const pageDesc =
  locale === 'ar'
    ? 'نبذة مهنية صادقة مبنية على القواسم المشتركة المثبتة عبر المشاريع وطريقة العمل من فهم المشكلة إلى التحقق والقياس.'
    : 'An engineering profile grounded in verified codebase patterns and a disciplined methodology from problem discovery to verification.';

const principles = [
  {
    titleAr: '1. التحقق المستقل وعدم الثقة العمياء بالمخرجات',
    titleEn: '1. Zero-Trust Independent Output Verification',
    descAr:
      'في نظام الجدول المدرسي بنينا مدققًا منفصلًا عن محرك الحل الرياضي، وفي محرك الموشن جرافيك بنينا بوابة فحص جودة تتحقق من الإطارات والصوت بعد الرندر. النظام الموثوق يفحص مخرجاته بنفسه.',
    descEn:
      'In the School Timetable solver, an independent validator audits solver outputs; in AION Studio, a post-render QA gate inspects frame contrast and A/V drift. Reliable systems validate their own outputs.',
  },
  {
    titleAr: '2. عزل الفشل وحماية الحالة المعتمدة',
    titleEn: '2. Fault Isolation & Safe Recovery Boundaries',
    descAr:
      'سواء عبر عزل كل تشغيل في مجلد مستقل، أو تدمير سياق الجلسة بالكامل بين مهام المتصفح، أو إعادة جدولة العمليات الفاشلة فقط عند عودة الشبكة — التصميم الجيد يمنع خطأً واحدًا من إفساد النظام.',
    descEn:
      'Whether isolating video renders inside per-run folders, tearing down browser contexts per slot, or draining offline queues safely — good architecture contains faults within strict boundaries.',
  },
  {
    titleAr: '3. تحويل الخوارزميات المعقدة إلى واجهات قابلة للتفسير',
    titleEn: '3. Making Complex Algorithms Explainable to Users',
    descAr:
      'المستخدم لا يحتاج قراءة معادلات رياضية، بل يحتاج شاشة واضحة تخبره: «تم نقل هذه الحصة لتفريغ الفترة للأستاذ أحمد»، أو سجل عمليات حي يوضح الخطوة الحالية.',
    descEn:
      'End users should not have to decipher linear constraints or correlation matrices; they need clear causal explanations and transparent progress feedback.',
  },
  {
    titleAr: '4. الأمان وسلامة البيانات من البايت الأول',
    titleEn: '4. Security & Data Integrity from the First Byte',
    descAr:
      'التحقق من البايتات الثنائية (Magic Bytes) للصور المرفوعة، ومنع حقن الفلاتر في الاستعلامات، وتدقيق سياسات الصلاحيات (RLS)، وعزل الخوارزميات خلف بوابات ترخيص على الخادم.',
    descEn:
      'Inspecting binary Magic Bytes on file uploads, blocking query filter injection, auditing multi-tenant RLS policies, and isolating proprietary solver logic.',
  },
];
---

<BaseLayout title={pageTitle} description={pageDesc} locale={locale} currentPath={`/${locale}/about`}>
  <section class="border-b border-white/10 py-12 sm:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="font-mono text-xs uppercase tracking-wider text-amber-400">
        {locale === 'ar' ? 'الهوية الهندسية وطريقة العمل' : 'Engineering Identity & Approach'}
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white mt-2">
        {locale === 'ar' ? 'أحمد عبد الله — نبذة ومنهجية بناء الأنظمة' : 'Ahmed Abdellah — About & Engineering Approach'}
      </h1>
      <p class="text-base sm:text-lg text-slate-300 mt-3 max-w-3xl leading-relaxed">
        {locale === 'ar' ? SITE_CONFIG.taglineAr : SITE_CONFIG.taglineEn}
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-12">
    <!-- Portrait + Core Engineering Bio Card -->
    <div class="glass-panel-elevated rounded-3xl p-6 sm:p-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-4 flex justify-center">
        <div class="relative w-full max-w-[280px] rounded-2xl overflow-hidden bg-[#050914] border border-white/15 shadow-xl">
          <img
            src="/media/profile/ahmed-abdellah.webp"
            alt={locale === 'ar' ? 'أحمد عبد الله' : 'Ahmed Abdellah'}
            width="800"
            height="800"
            loading="eager"
            class="w-full h-auto object-cover"
          />
          <div class="p-4 bg-[#050914]/90 text-white border-t border-white/10">
            <strong class="block text-base">{locale === 'ar' ? SITE_CONFIG.ownerNameAr : SITE_CONFIG.ownerNameEn}</strong>
            <span class="text-xs text-blue-300">
              {locale === 'ar' ? SITE_CONFIG.roleTitleAr : SITE_CONFIG.roleTitleEn}
            </span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-8 space-y-5">
        <span class="inline-block font-mono text-xs uppercase tracking-wider text-amber-300 font-bold">
          {locale === 'ar' ? 'سيرة هندسية مبنية على أعمال حقيقية' : 'Profile Grounded in Real Systems'}
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white">
          {locale === 'ar'
            ? 'الربط بين النواة الخوارزمية وتجربة المستخدم النهائية'
            : 'Bridging Algorithmic Cores with Usable Product Experiences'}
        </h2>
        <p class="text-sm sm:text-base text-slate-200 leading-relaxed">
          {locale === 'ar'
            ? 'أركز في عملي على بناء أنظمة برمجية متكاملة تبدأ من حل المشكلة الخوارزمية المعقدة وتنتهي بواجهة استخدام واضحة وموثوقة: من مترجمات إنتاج الفيديو بالذكاء الاصطناعي (AION Studio) ومحركات جدولة الحصص المدرسية (CP-SAT)، إلى محركات الرؤية الحاسوبية على أندرويد (Phone Commander)، ومنظومات تطبيقات الرعاية الصحية (Enaya)، ومتاجر الويب المحصنة أمنيًا (SOLE).'
            : 'My work focuses on end-to-end systems that pair deep algorithmic problem-solving with clean, dependable user interfaces: from AI motion-graphics compilers (AION Studio) and mathematical timetable solvers (CP-SAT), to on-device Android computer vision (Phone Commander), multi-app Flutter healthcare platforms (Enaya), and hardened React/Express storefronts (SOLE).'}
        </p>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          {locale === 'ar'
            ? 'بدلًا من الاكتفاء بنماذج أولية نظرية، أصمّم الأنظمة لتتحمل ظروف التشغيل الواقعية: تشخيص السبب الجذري للأعطال، وضع عقود بيانات صارمة بين المراحل، وبناء آليات تعافٍ تلقائي تحمي بيانات المستخدم.'
            : 'Rather than fragile prototypes, I engineer systems for messy real-world conditions: forensic root-cause analysis, strict stage contracts, and automated recovery mechanisms that protect user data.'}
        </p>
      </div>
    </div>

    <!-- 4 Engineering Principles -->
    <div>
      <h2 class="text-2xl font-extrabold text-white mb-6">
        {locale === 'ar' ? 'أربعة مبادئ أساسية في طريقتي الهندسية' : 'Four Guiding Engineering Principles'}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {principles.map((p, idx) => (
          <div
            style={`--reveal-delay: ${idx * 60}ms`}
            class="reveal-item glass-panel rounded-2xl p-6 sm:p-7"
          >
            <h3 class="text-lg font-bold text-white mb-2.5">
              {locale === 'ar' ? p.titleAr : p.titleEn}
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              {locale === 'ar' ? p.descAr : p.descEn}
            </p>
          </div>
        ))}
      </div>
    </div>

    <CTA locale={locale} />
  </section>
</BaseLayout>
