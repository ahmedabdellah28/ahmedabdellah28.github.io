---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectGallery from '../../../components/ProjectGallery.astro';
import ArchitectureDiagram from '../../../components/ArchitectureDiagram.astro';
import ChallengeTimeline from '../../../components/ChallengeTimeline.astro';
import EvidenceBadge from '../../../components/EvidenceBadge.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import CTA from '../../../components/CTA.astro';
import { UI_LABELS } from '../../../config/site';

export async function getStaticPaths() {
  // Strictly generate routes ONLY for published projects (draft and private are never exposed)
  const publishedProjects = await getCollection('projects', ({ data }) => data.visibility === 'published');
  const locales: Array<'ar' | 'en'> = ['ar', 'en'];

  return locales.flatMap((locale) =>
    publishedProjects.map((entry) => ({
      params: { locale, slug: entry.data.slug },
      props: { project: entry.data, allPublished: publishedProjects.map((p) => p.data) },
    }))
  );
}

const { locale, slug } = Astro.params as { locale: 'ar' | 'en'; slug: string };
const { project, allPublished } = Astro.props;
const t = UI_LABELS[locale];

const title = locale === 'ar' ? project.titleAr : project.titleEn;
const summary = locale === 'ar' ? project.summaryAr : project.summaryEn;
const valueProp = locale === 'ar' ? project.valuePropositionAr : project.valuePropositionEn;

const relatedProjects = allPublished
  .filter((p) => p.slug !== project.slug)
  .sort((a, b) => {
    const overlapA = a.category.filter((c) => project.category.includes(c)).length;
    const overlapB = b.category.filter((c) => project.category.includes(c)).length;
    return overlapB - overlapA;
  })
  .slice(0, 2);

const publicEvidence = project.evidence.filter((ev) => ev.visibility === 'public');

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: title,
  description: summary,
  programmingLanguage: project.technologies,
  applicationCategory: project.category.join(', '),
};
---

<BaseLayout
  title={`${title} — ${locale === 'ar' ? 'دراسة حالة هندسية' : 'Engineering Case Study'}`}
  description={summary}
  locale={locale}
  currentPath={`/${locale}/projects/${slug}`}
  structuredData={structuredData}
>
  <!-- Case Study Hero Header -->
  <section class="relative bg-[#0B1220] text-[#F5F7FA] border-b border-[#182438] py-12 sm:py-16 overflow-hidden">
    <div
      class="pointer-events-none absolute -top-24 end-0 w-[420px] h-[420px] rounded-full bg-[#2663EB]/15 blur-[120px]"
      aria-hidden="true"
    ></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-6 text-xs font-mono text-slate-400 flex items-center gap-2 flex-wrap">
        <a href={`/${locale}/`} class="hover:text-white transition-colors">{t.navHome}</a>
        <span>/</span>
        <a href={`/${locale}/projects`} class="hover:text-white transition-colors">{t.navProjects}</a>
        <span>/</span>
        <span class="text-[#18B8A7]">{project.slug}</span>
      </nav>

      <!-- Top Meta Badges -->
      <div class="flex items-center gap-2.5 flex-wrap mb-4">
        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-emerald-950 text-[#18B8A7] border border-[#18B8A7]/40">
          {t.statusLabels[project.status]}
        </span>
        {project.category.map((cat) => (
          <span class="px-2.5 py-1 rounded-md bg-[#182438] text-slate-200 font-mono text-xs uppercase border border-slate-700">
            {cat}
          </span>
        ))}
        <span class="px-2.5 py-1 rounded-md bg-[#182438] text-[#93C5FD] font-mono text-xs border border-[#2663EB]/40">
          {project.graphStats.nodes.toLocaleString()} {locale === 'ar' ? 'عقدة برمجية' : 'AST Nodes'} · {project.graphStats.edges.toLocaleString()} {locale === 'ar' ? 'علاقة' : 'Edges'}
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight max-w-4xl">
        {title}
      </h1>

      <p class="text-base sm:text-lg text-slate-300 mt-4 max-w-3xl leading-relaxed">
        {valueProp}
      </p>

      <!-- Verified Results Strip -->
      <div class="mt-10 grid grid-cols-2 lg:grid-cols-4 gap-4">
        {project.results.map((res) => (
          <div class="bg-[#182438]/90 rounded-2xl p-4 sm:p-5 border border-slate-700/80">
            <div class="font-mono text-xl sm:text-2xl font-extrabold text-[#18B8A7]">{res.metric}</div>
            <div class="text-xs sm:text-sm text-slate-200 mt-1 leading-snug">
              {locale === 'ar' ? res.labelAr : res.labelEn}
            </div>
            <div class="text-[11px] font-mono text-slate-400 mt-2 truncate" title={res.sourceRef}>
              {res.sourceRef}
            </div>
          </div>
        ))}
      </div>

      <!-- 3-Audience Executive Digest (Client / HR / CTO) -->
      <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-[#182438]/60 rounded-2xl p-4 border border-blue-500/30">
          <span class="text-xs font-mono font-bold text-[#60A5FA] block mb-1">
            {locale === 'ar' ? '💼 ملخص العميل (10 ثوانٍ)' : '💼 Client 10-Second Summary'}
          </span>
          <p class="text-xs text-slate-200 leading-relaxed">
            {project.manualVsAutomated[locale]}
          </p>
        </div>

        <div class="bg-[#182438]/60 rounded-2xl p-4 border border-emerald-500/30">
          <span class="text-xs font-mono font-bold text-[#18B8A7] block mb-1">
            {locale === 'ar' ? '🎯 ملخص مسؤولي التوظيف (HR)' : '🎯 HR & Recruiter Snapshot'}
          </span>
          <p class="text-xs text-slate-200 leading-relaxed">
            <strong>{locale === 'ar' ? 'الدور: ' : 'Role: '}</strong>{project.role[locale]}<br />
            <strong>{locale === 'ar' ? 'التقنيات: ' : 'Stack: '}</strong>{project.technologies.slice(0, 5).join(' · ')}
          </p>
        </div>

        <div class="bg-[#182438]/60 rounded-2xl p-4 border border-amber-500/30">
          <span class="text-xs font-mono font-bold text-amber-300 block mb-1">
            {locale === 'ar' ? '⚙️ ملخص المدير التقني (CTO)' : '⚙️ CTO & Engineering Proof'}
          </span>
          <p class="text-xs text-slate-200 leading-relaxed">
            {locale === 'ar'
              ? `${publicEvidence.length} أدلة كود مصدرية موثقة بالسطر والملف · ${project.challenges.length} قصص تحدٍ وإصلاح سبب جذري.`
              : `${publicEvidence.length} file/line verified code claims · ${project.challenges.length} documented root-cause & architecture challenges.`}
          </p>
        </div>
      </div>

      <!-- Dual-Layer Navigation Bar (Overview vs Engineering Deep Dive) -->
      <div class="mt-8 pt-6 border-t border-slate-800 flex items-center gap-3 flex-wrap">
        <a
          href="#client-overview"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#2663EB] text-white font-semibold text-xs sm:text-sm shadow-xs"
        >
          <span>1. {t.clientOverviewTab}</span>
        </a>
        <a
          href="#visual-proof"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#182438] hover:bg-slate-800 text-slate-200 font-semibold text-xs sm:text-sm border border-slate-700 transition-colors"
        >
          <span>2. {locale === 'ar' ? 'الوسائط والمخططات التفاعلية' : 'Interactive Visuals & Diagrams'}</span>
        </a>
        <a
          href="#engineering-deep-dive"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#182438] hover:bg-slate-800 text-[#18B8A7] font-semibold text-xs sm:text-sm border border-[#18B8A7]/40 transition-colors"
        >
          <span>3. {t.engineeringDeepDiveTab}</span>
        </a>
        <a
          href="#evidence-manifest"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#182438] hover:bg-slate-800 text-slate-200 font-semibold text-xs sm:text-sm border border-slate-700 transition-colors"
        >
          <span>4. {t.evidenceTitle} ({publicEvidence.length})</span>
        </a>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    <!-- LAYER 1: Client Overview & Practical Business Value -->
    <section id="client-overview" class="scroll-mt-24 space-y-8">
      <div class="border-b border-slate-200 pb-4">
        <span class="font-mono text-xs uppercase tracking-wider text-[#2663EB] font-bold">
          {locale === 'ar' ? 'الطبقة الأولى · مسار القيمة السريع لصاحب العمل' : 'Layer 01 · Client & Product Value Overview'}
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0B1220] mt-1">
          {t.clientOverviewTab}
        </h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- The Problem -->
        <div class="reveal-item spotlight-card bg-white rounded-3xl p-6 border border-slate-200 shadow-2xs">
          <h3 class="text-sm font-bold uppercase tracking-wider text-rose-700 mb-2">
            {locale === 'ar' ? 'المشكلة الواقعية' : 'The Core Problem'}
          </h3>
          <p class="text-sm sm:text-base text-slate-700 leading-relaxed">
            {project.problem[locale]}
          </p>
        </div>

        <!-- The Solution -->
        <div class="reveal-item spotlight-card bg-white rounded-3xl p-6 border border-slate-200 shadow-2xs">
          <h3 class="text-sm font-bold uppercase tracking-wider text-[#2663EB] mb-2">
            {locale === 'ar' ? 'الحل الذي يقدمه النظام' : 'The Engineered Solution'}
          </h3>
          <p class="text-sm sm:text-base text-slate-700 leading-relaxed">
            {project.solution[locale]}
          </p>
        </div>

        <!-- Why Better Than Manual Work -->
        <div class="reveal-item spotlight-card bg-white rounded-3xl p-6 border border-slate-200 shadow-2xs">
          <h3 class="text-sm font-bold uppercase tracking-wider text-emerald-700 mb-2">
            {locale === 'ar' ? 'الفرق عن الحل اليدوي التقليدي' : 'Manual vs. Automated Advantage'}
          </h3>
          <p class="text-sm sm:text-base text-slate-700 leading-relaxed">
            {project.manualVsAutomated[locale]}
          </p>
        </div>
      </div>

      <!-- Target Audience & Core Capabilities -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="reveal-item bg-[#0B1220] text-white rounded-3xl p-6 border border-[#182438] flex flex-col justify-between">
          <div>
            <span class="font-mono text-xs uppercase tracking-wider text-[#18B8A7]">
              {locale === 'ar' ? 'المستفيدون والدور الهندسي' : 'Target Beneficiary & Role'}
            </span>
            <h3 class="text-lg font-bold mt-2 mb-2">
              {locale === 'ar' ? 'من يستفيد من هذا النظام؟' : 'Who Benefits'}
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed mb-6">
              {project.audience[locale]}
            </p>
          </div>
          <div class="pt-4 border-t border-slate-800">
            <span class="block text-xs font-mono text-slate-400 mb-1">
              {locale === 'ar' ? 'الدور في المشروع:' : 'Personal Role:'}
            </span>
            <span class="text-xs sm:text-sm font-semibold text-[#18B8A7]">
              {project.role[locale]}
            </span>
          </div>
        </div>

        <div class="reveal-item lg:col-span-2 bg-white rounded-3xl p-6 border border-slate-200 shadow-2xs">
          <h3 class="text-lg font-bold text-[#0B1220] mb-4">
            {t.capabilitiesTitle}
          </h3>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {project.capabilities.map((cap, i) => (
              <li class="flex items-start gap-3 p-3.5 rounded-2xl bg-[#F5F7FA] border border-slate-200/70">
                <span class="w-6 h-6 rounded-lg bg-[#2663EB] text-white font-mono text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">
                  0{i + 1}
                </span>
                <span class="text-sm text-slate-700 leading-relaxed">{cap[locale]}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Visual Proof & Architecture Gallery -->
    <section id="visual-proof" class="scroll-mt-24 space-y-6">
      <div class="border-b border-slate-200 pb-4 flex items-end justify-between flex-wrap gap-2">
        <div>
          <span class="font-mono text-xs uppercase tracking-wider text-[#2663EB] font-bold">
            {locale === 'ar' ? 'إثباتات بصرية ومخططات معمارية (اضغط للتكبير)' : 'Visual Proof & Architectural Diagrams (Click to Zoom)'}
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0B1220] mt-1">
            {locale === 'ar' ? 'شاشات النظام الفعلية ومخطط تدفق العمليات' : 'System Screenshots & Pipeline Architecture'}
          </h2>
        </div>
      </div>

      <ProjectGallery screenshots={project.screenshots} locale={locale} />
    </section>

    <!-- LAYER 2: Engineering Deep Dive -->
    <section id="engineering-deep-dive" class="scroll-mt-24 space-y-10">
      <div class="border-b border-slate-200 pb-4">
        <span class="font-mono text-xs uppercase tracking-wider text-[#18B8A7] bg-[#0B1220] px-2.5 py-1 rounded">
          {locale === 'ar' ? 'الطبقة الثانية · التعمق الهندسي لمديري التقنية والمهندسين' : 'Layer 02 · Engineering Deep Dive for Technical Reviewers'}
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0B1220] mt-2">
          {t.engineeringDeepDiveTab}
        </h2>
      </div>

      <!-- Architecture Breakdown -->
      <ArchitectureDiagram
        overviewAr={project.architecture.overviewAr}
        overviewEn={project.architecture.overviewEn}
        pipelineSteps={project.architecture.pipelineSteps}
        systemBoundariesAr={project.architecture.systemBoundariesAr}
        systemBoundariesEn={project.architecture.systemBoundariesEn}
        locale={locale}
      />

      <!-- Verified Technology Stack & Proven Skills -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="reveal-item bg-white rounded-3xl p-6 border border-slate-200">
          <h3 class="text-base font-bold text-[#0B1220] mb-3">
            {locale === 'ar' ? 'التقنيات المستخدمة فعليًا في الكود' : 'Verified Technologies in Source'}
          </h3>
          <div class="flex flex-wrap gap-2">
            {project.technologies.map((tech) => (
              <span class="px-3 py-1.5 rounded-xl bg-[#F5F7FA] text-[#0B1220] font-mono text-xs font-semibold border border-slate-200">
                {tech}
              </span>
            ))}
          </div>
        </div>

        <div class="reveal-item bg-white rounded-3xl p-6 border border-slate-200">
          <h3 class="text-base font-bold text-[#0B1220] mb-3">
            {locale === 'ar' ? 'القدرات الهندسية التي يثبتها هذا المشروع' : 'Engineering Capabilities Proven'}
          </h3>
          <div class="flex flex-wrap gap-2">
            {project.skillsProven.map((sk) => (
              <span class="px-3 py-1.5 rounded-xl bg-blue-50 text-[#2663EB] text-xs font-semibold border border-blue-200">
                {sk}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Challenge Stories -->
      <div class="space-y-6">
        <h3 class="text-xl sm:text-2xl font-extrabold text-[#0B1220]">
          {t.challengesTitle}
        </h3>
        <ChallengeTimeline challenges={project.challenges} locale={locale} />
      </div>
    </section>

    <!-- Traceable Code Evidence Manifest -->
    <section id="evidence-manifest" class="scroll-mt-24 space-y-6">
      <div class="border-b border-slate-200 pb-4">
        <span class="font-mono text-xs uppercase tracking-wider text-[#2663EB] font-bold">
          {locale === 'ar' ? 'سجل الإثباتات المرجعية · Graph-First Evidence' : 'Traceable Source Verification · Evidence Manifest'}
        </span>
        <h2 class="text-2xl font-extrabold text-[#0B1220] mt-1">
          {t.evidenceTitle}
        </h2>
        <p class="text-sm text-slate-600 mt-1">
          {locale === 'ar'
            ? 'كل حقيقة هندسية في هذه الصفحة مرتبطة بالملف والسطر أو الرمز البرمجي الذي يثبتها.'
            : 'Every engineering claim on this page is mapped to the exact repository file, line range, or commit hash that proves it.'}
        </p>
      </div>

      <div class="bg-[#0B1220] text-slate-200 rounded-3xl border border-[#182438] overflow-hidden shadow-md">
        <div class="overflow-x-auto">
          <table class="w-full text-start border-collapse text-xs sm:text-sm">
            <thead>
              <tr class="bg-[#182438] text-slate-300 font-mono text-xs border-b border-slate-700">
                <th class="py-3.5 px-4 text-start">{locale === 'ar' ? 'المعرّف والنوع' : 'Claim & Relation'}</th>
                <th class="py-3.5 px-4 text-start">{locale === 'ar' ? 'الادعاء الهندسي الموثق' : 'Verified Engineering Claim'}</th>
                <th class="py-3.5 px-4 text-start">{locale === 'ar' ? 'مسار الملف / الدليل' : 'Evidence Path'}</th>
                <th class="py-3.5 px-4 text-start">{locale === 'ar' ? 'السطر أو الرمز' : 'Line / Symbol'}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/80">
              {publicEvidence.map((ev) => (
                <tr class="hover:bg-[#182438]/50 transition-colors">
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <EvidenceBadge
                      claimId={ev.claimId}
                      relationType={ev.relationType}
                      verificationStatus={ev.verificationStatus}
                      confidence={ev.confidence}
                      locale={locale}
                    />
                  </td>
                  <td class="py-3.5 px-4 text-slate-200 leading-relaxed max-w-md">
                    {locale === 'ar' ? ev.claimAr : ev.claimEn}
                  </td>
                  <td class="py-3.5 px-4 font-mono text-xs text-[#93C5FD]">
                    <code>{ev.evidencePath}</code>
                  </td>
                  <td class="py-3.5 px-4 font-mono text-xs text-[#18B8A7]">
                    <code>{ev.lineOrSymbol}</code>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Project-Specific CTA -->
    <CTA
      locale={locale}
      heading={
        locale === 'ar'
          ? `هل تحتاج نظامًا بمستوى «${project.titleAr.split('—')[0].trim()}»؟`
          : `Need an architecture like "${project.titleEn.split('—')[0].trim()}"?`
      }
      body={
        locale === 'ar'
          ? 'سواء كنت تحتاج أتمتة خط إنتاج، أو محرك استمثال رياضي، أو تطبيق ويب/موبايل عالي الاعتمادية — دعنا نناقش تفاصيل مشروعك.'
          : 'Whether you need a deterministic automation pipeline, mathematical solver, computer-vision engine, or hardened web/mobile product — let us discuss your requirements.'
      }
    />

    <!-- Related Case Studies -->
    {relatedProjects.length > 0 && (
      <section class="pt-6 border-t border-slate-200 space-y-6">
        <h2 class="text-xl sm:text-2xl font-extrabold text-[#0B1220]">
          {locale === 'ar' ? 'دراسات حالة أخرى ذات صلة' : 'Related Engineering Case Studies'}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-7">
          {relatedProjects.map((rel, idx) => (
            <ProjectCard project={rel} locale={locale} index={idx} />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
