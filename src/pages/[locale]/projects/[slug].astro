---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectGallery from '../../../components/ProjectGallery.astro';
import ArchitectureDiagram from '../../../components/ArchitectureDiagram.astro';
import ChallengeTimeline from '../../../components/ChallengeTimeline.astro';
import EvidenceBadge from '../../../components/EvidenceBadge.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import CTA from '../../../components/CTA.astro';
import { UI_LABELS } from '../../../config/site';

export async function getStaticPaths() {
  const publishedProjects = await getCollection('projects', ({ data }) => data.visibility === 'published');
  const locales: Array<'ar' | 'en'> = ['ar', 'en'];

  return locales.flatMap((locale) =>
    publishedProjects.map((entry) => ({
      params: { locale, slug: entry.data.slug },
      props: { project: entry.data, allPublished: publishedProjects.map((p) => p.data) },
    }))
  );
}

const { locale, slug } = Astro.params as { locale: 'ar' | 'en'; slug: string };
const { project, allPublished } = Astro.props;
const t = UI_LABELS[locale];

const title = locale === 'ar' ? project.titleAr : project.titleEn;
const summary = locale === 'ar' ? project.summaryAr : project.summaryEn;
const valueProp = locale === 'ar' ? project.valuePropositionAr : project.valuePropositionEn;
const humanCat =
  locale === 'ar'
    ? project.humanCategoryAr || project.category.join(' · ')
    : project.humanCategoryEn || project.category.join(' · ');
const struggle =
  locale === 'ar'
    ? project.struggleAr || project.problem.ar
    : project.struggleEn || project.problem.en;
const triumph =
  locale === 'ar'
    ? project.triumphAr || project.solution.ar
    : project.triumphEn || project.solution.en;
const heroMedia = project.screenshots[0];
const heroMediaAlt = heroMedia ? (locale === 'ar' ? heroMedia.altAr : heroMedia.altEn) : title;
const heroMediaCap = heroMedia ? (locale === 'ar' ? heroMedia.captionAr : heroMedia.captionEn) : '';

const relatedProjects = allPublished
  .filter((p) => p.slug !== project.slug)
  .sort((a, b) => {
    const overlapA = a.category.filter((c) => project.category.includes(c)).length;
    const overlapB = b.category.filter((c) => project.category.includes(c)).length;
    return overlapB - overlapA;
  })
  .slice(0, 2);

const publicEvidence = project.evidence.filter((ev) => ev.visibility === 'public');

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: title,
  description: summary,
  programmingLanguage: project.technologies,
  applicationCategory: project.category.join(', '),
};
---

<BaseLayout
  title={`${title} — ${locale === 'ar' ? 'قصة المشروع والنتيجة' : 'Case Study & Impact'}`}
  description={summary}
  locale={locale}
  currentPath={`/${locale}/projects/${slug}`}
  structuredData={structuredData}
>
  <!-- 1. HERO: Title, Struggle vs. Breakthrough Banner, Key Metrics, and Primary Large Visual -->
  <section class="border-b border-white/10 py-10 sm:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-7">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="text-xs text-slate-300 flex items-center gap-2 flex-wrap">
        <a href={`/${locale}/`} class="hover:text-white transition-colors font-semibold">{t.navHome}</a>
        <span>/</span>
        <a href={`/${locale}/projects`} class="hover:text-white transition-colors font-semibold">{t.navProjects}</a>
        <span>/</span>
        <span class="text-amber-300 font-bold">{title}</span>
      </nav>

      <div class="max-w-4xl space-y-4">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-400/40">
            {t.statusLabels[project.status]}
          </span>
          <span class="px-3 py-1 rounded-lg bg-blue-500/15 text-blue-300 text-xs font-bold border border-blue-400/25">
            {humanCat}
          </span>
          <span class="px-3 py-1 rounded-lg bg-white/[0.05] text-slate-200 text-xs border border-white/10">
            <strong class="text-amber-300">{locale === 'ar' ? 'الدور: ' : 'Role: '}</strong>
            {project.role[locale]}
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
          {title}
        </h1>

        <p class="text-base sm:text-lg text-slate-200 leading-relaxed">
          {valueProp}
        </p>
      </div>

      <!-- High-Impact Struggle vs. Breakthrough Comparison Banner -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-5 rounded-2xl bg-rose-950/45 border border-rose-500/30">
          <span class="inline-block px-2.5 py-1 rounded-lg bg-rose-500/20 text-rose-300 text-xs font-extrabold mb-2">
            {locale === 'ar' ? '🔥 المعاناة قبل بناء النظام' : '🔥 The Struggle Before This System'}
          </span>
          <p class="text-sm sm:text-base text-slate-100 leading-relaxed font-medium">
            {struggle}
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-emerald-950/45 border border-emerald-500/30">
          <span class="inline-block px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 text-xs font-extrabold mb-2">
            {locale === 'ar' ? '⚡ النقلة والنتيجة الحاسمة' : '⚡ The Breakthrough & Outcome'}
          </span>
          <p class="text-sm sm:text-base text-white leading-relaxed font-semibold">
            {triumph}
          </p>
        </div>
      </div>

      <!-- 4 Concrete Result Metrics (Clean, Client-Focused, Zero Raw File Paths) -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5">
        {project.results.map((res) => (
          <div class="glass-panel rounded-2xl p-4 sm:p-5 border border-white/10">
            <div class="text-xl sm:text-2xl font-extrabold text-amber-300">{res.metric}</div>
            <div class="text-xs sm:text-sm text-slate-200 mt-1 font-medium leading-snug">
              {locale === 'ar' ? res.labelAr : res.labelEn}
            </div>
          </div>
        ))}
      </div>

      <!-- Primary Featured Visual Immediately Visible in Hero -->
      {heroMedia && (
        <figure class="glass-panel-elevated rounded-2xl overflow-hidden shadow-2xl">
          <div class="px-5 py-3 bg-white/[0.04] border-b border-white/10 flex items-center justify-between gap-2 flex-wrap">
            <span class="text-xs text-amber-300 font-bold">
              {heroMedia.kind === 'real_screenshot'
                ? (locale === 'ar' ? 'واجهة النظام الفعلية' : 'Live System Interface')
                : heroMedia.kind === 'illustrative_demo'
                  ? (locale === 'ar' ? 'واجهات التطبيق' : 'App Screens')
                  : (locale === 'ar' ? 'مخطط عمل النظام' : 'System Workflow Diagram')}
            </span>
            <button
              type="button"
              data-lightbox-src={heroMedia.src}
              data-lightbox-alt={heroMediaAlt}
              data-lightbox-caption={heroMediaCap}
              data-lightbox-badge={title}
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold transition-colors cursor-pointer"
            >
              <span>{locale === 'ar' ? 'تكبير بالحجم الكامل' : 'Expand Fullscreen'}</span>
            </button>
          </div>
          <div class="p-3 sm:p-6 flex items-center justify-center bg-[#040812]/85">
            <img
              src={heroMedia.src}
              alt={heroMediaAlt}
              width={heroMedia.width}
              height={heroMedia.height}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="max-h-[520px] w-auto rounded-xl border border-white/10 object-contain"
            />
          </div>
          {heroMediaCap && (
            <figcaption class="px-6 py-3.5 bg-white/[0.03] border-t border-white/10 text-xs sm:text-sm text-slate-200">
              {heroMediaCap}
            </figcaption>
          )}
        </figure>
      )}
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-14">
    <!-- 2. VISUAL WALKTHROUGH (Additional Screenshots & Workflow Diagrams Right After Hero) -->
    {project.screenshots.length > 1 && (
      <section id="visual-walkthrough" class="scroll-mt-24 space-y-6">
        <div class="border-b border-white/10 pb-4">
          <span class="text-xs uppercase tracking-wider text-amber-400 font-bold">
            {locale === 'ar' ? 'صور النظام ومخطط العمل' : 'System Views & Workflow Diagrams'}
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">
            {locale === 'ar' ? 'شاهد واجهات النظام وكيف يعمل خطوة بخطوة' : 'Explore System Screens & Step-by-Step Workflow'}
          </h2>
        </div>

        <ProjectGallery screenshots={project.screenshots.slice(1)} locale={locale} />
      </section>
    )}

    <!-- 3. THE STRUGGLE IN DETAIL & WHAT THE SYSTEM DELIVERS -->
    <section id="challenge-solution" class="scroll-mt-24 space-y-8">
      <div class="border-b border-white/10 pb-4">
        <span class="text-xs uppercase tracking-wider text-blue-400 font-bold">
          {locale === 'ar' ? 'القصة الكاملة والقيمة العملية' : 'Full Story & Practical Value'}
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">
          {locale === 'ar' ? 'كيف كان الوضع قبل النظام وكيف تغير بعده؟' : 'What Changed Before & After Building This System?'}
        </h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="glass-panel rounded-2xl p-6 border-t-2 border-t-rose-500/60">
          <h3 class="text-sm font-extrabold uppercase tracking-wider text-rose-300 mb-2">
            {locale === 'ar' ? '1. حجم المعاناة والتحدي السابق' : '1. The Operational Struggle'}
          </h3>
          <p class="text-sm sm:text-base text-slate-200 leading-relaxed">
            {project.problem[locale]}
          </p>
        </div>

        <div class="glass-panel rounded-2xl p-6 border-t-2 border-t-blue-500/60">
          <h3 class="text-sm font-extrabold uppercase tracking-wider text-blue-300 mb-2">
            {locale === 'ar' ? '2. كيف يعمل الحل الذي بنيناه؟' : '2. How Our Solution Works'}
          </h3>
          <p class="text-sm sm:text-base text-slate-200 leading-relaxed">
            {project.solution[locale]}
          </p>
        </div>

        <div class="glass-panel rounded-2xl p-6 border-t-2 border-t-emerald-500/60">
          <h3 class="text-sm font-extrabold uppercase tracking-wider text-emerald-300 mb-2">
            {locale === 'ar' ? '3. الفارق مقابل العمل اليدوي التقليدي' : '3. Manual vs. Automated Impact'}
          </h3>
          <p class="text-sm sm:text-base text-slate-200 leading-relaxed">
            {project.manualVsAutomated[locale]}
          </p>
        </div>
      </div>

      <!-- Capabilities & Target Beneficiary -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="glass-panel rounded-2xl p-6 flex flex-col justify-between">
          <div>
            <span class="text-xs uppercase tracking-wider text-amber-300 font-bold">
              {locale === 'ar' ? 'المستفيدون من النظام' : 'Target Beneficiaries'}
            </span>
            <h3 class="text-lg font-extrabold text-white mt-1.5 mb-2">
              {locale === 'ar' ? 'لمن صُمم هذا الحل؟' : 'Who Benefits From This?'}
            </h3>
            <p class="text-sm text-slate-200 leading-relaxed">
              {project.audience[locale]}
            </p>
          </div>
          <div class="pt-4 mt-6 border-t border-white/10">
            <span class="block text-xs font-bold text-slate-300 mb-2">
              {locale === 'ar' ? 'التقنيات المستخدمة:' : 'Built With:'}
            </span>
            <div class="flex flex-wrap gap-1.5">
              {project.technologies.map((tech) => (
                <span class="px-2.5 py-1 rounded-md bg-white/[0.06] text-slate-200 font-mono text-xs border border-white/10">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>

        <div class="lg:col-span-2 glass-panel rounded-2xl p-6">
          <h3 class="text-lg font-extrabold text-white mb-4">
            {locale === 'ar' ? 'أهم المزايا والقدرات التي يقدمها النظام' : 'Key Capabilities Delivered'}
          </h3>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {project.capabilities.map((cap, i) => (
              <li class="flex items-start gap-3 p-3.5 rounded-xl bg-white/[0.04] border border-white/10">
                <span class="w-6 h-6 rounded-md bg-blue-600 text-white font-mono text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">
                  {i + 1}
                </span>
                <span class="text-sm text-slate-200 leading-relaxed">{cap[locale]}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 4. TOUGHEST CRISES WE FACED & SOLVED IN THIS PROJECT -->
    <section id="engineering-deep-dive" class="scroll-mt-24 space-y-8">
      <div class="border-b border-white/10 pb-4">
        <span class="text-xs uppercase tracking-wider text-amber-300 font-bold">
          {locale === 'ar' ? 'معارك تقنية حسمناها داخل المشروع' : 'Real Obstacles Overcome in This Project'}
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">
          {locale === 'ar'
            ? 'أصعب العقبات التي واجهتنا أثناء التنفيذ وكيف تغلبنا عليها'
            : 'Critical Bottlenecks Faced & How We Engineered Around Them'}
        </h2>
      </div>

      <ChallengeTimeline challenges={project.challenges} locale={locale} />

      <!-- Architecture Breakdown -->
      <ArchitectureDiagram
        overviewAr={project.architecture.overviewAr}
        overviewEn={project.architecture.overviewEn}
        pipelineSteps={project.architecture.pipelineSteps}
        systemBoundariesAr={project.architecture.systemBoundariesAr}
        systemBoundariesEn={project.architecture.systemBoundariesEn}
        locale={locale}
      />

      <!-- Closed-by-default Deep Code Evidence Drawer for Engineers & CTOs -->
      <details class="glass-panel rounded-2xl overflow-hidden group">
        <summary class="px-6 py-4 cursor-pointer flex items-center justify-between gap-4 bg-white/[0.04] hover:bg-white/[0.07] transition-colors">
          <div>
            <span class="text-xs uppercase tracking-wider text-blue-400 font-bold block">
              {locale === 'ar' ? 'للمهندسين والشركات التقنية (اختياري)' : 'For Engineers & Technical Reviewers (Optional)'}
            </span>
            <strong class="text-base sm:text-lg font-bold text-white">
              {locale === 'ar'
                ? `اضغط لعرض جدول الأدلة البرمجية والملفات المصدرية (${publicEvidence.length} دليل موثق)`
                : `Click to Expand Source Code Evidence Manifest (${publicEvidence.length} Verified Proofs)`}
            </strong>
          </div>
          <span class="text-xs font-bold text-amber-300 px-3 py-1.5 rounded-lg bg-white/[0.06] border border-white/10 shrink-0">
            {locale === 'ar' ? 'عرض الأدلة البرمجية ↓' : 'Show Code Proofs ↓'}
          </span>
        </summary>

        <div class="p-6 space-y-4 border-t border-white/10">
          <p class="text-xs sm:text-sm text-slate-300">
            {locale === 'ar'
              ? 'يربط هذا الجدول كل قدرة هندسية في المشروع بالملف أو الاختبار الذي يثبتها داخل الكود المصدري.'
              : 'This manifest links each technical claim in this project to the verifying source file or unit test.'}
          </p>

          <div class="overflow-x-auto rounded-xl border border-white/10">
            <table class="w-full text-start border-collapse text-xs sm:text-sm">
              <thead>
                <tr class="bg-white/[0.06] text-slate-200 font-mono text-xs border-b border-white/10">
                  <th class="py-3.5 px-4 text-start">{locale === 'ar' ? 'الحالة' : 'Status'}</th>
                  <th class="py-3.5 px-4 text-start">{locale === 'ar' ? 'الإثبات الهندسي' : 'Verified Claim'}</th>
                  <th class="py-3.5 px-4 text-start">{locale === 'ar' ? 'الملف المرجعي' : 'Reference File'}</th>
                  <th class="py-3.5 px-4 text-start">{locale === 'ar' ? 'الدالة / السطر' : 'Location / Symbol'}</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/10">
                {publicEvidence.map((ev) => (
                  <tr class="hover:bg-white/[0.03] transition-colors">
                    <td class="py-3.5 px-4 whitespace-nowrap">
                      <EvidenceBadge
                        claimId={ev.claimId}
                        relationType={ev.relationType}
                        verificationStatus={ev.verificationStatus}
                        confidence={ev.confidence}
                        locale={locale}
                      />
                    </td>
                    <td class="py-3.5 px-4 text-slate-200 leading-relaxed max-w-md">
                      {locale === 'ar' ? ev.claimAr : ev.claimEn}
                    </td>
                    <td class="py-3.5 px-4 font-mono text-xs text-blue-300">
                      <code>{ev.evidencePath}</code>
                    </td>
                    <td class="py-3.5 px-4 font-mono text-xs text-emerald-300">
                      <code>{ev.lineOrSymbol}</code>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </details>
    </section>

    <!-- Project-Specific CTA -->
    <CTA
      locale={locale}
      heading={
        locale === 'ar'
          ? `هل تواجه معاناة مشابهة وتحتاج نظامًا بمستوى «${title}»؟`
          : `Facing a similar bottleneck and need a system like "${title}"?`
      }
      body={
        locale === 'ar'
          ? 'تواصل معي مباشرة لنناقش المشكلة التي تواجهك وكيف نحولها إلى نظام آلي سريع ومستقر.'
          : 'Reach out directly to discuss your operational bottleneck and how we can turn it into a fast, reliable software system.'
      }
    />

    <!-- Related Case Studies -->
    {relatedProjects.length > 0 && (
      <section class="pt-6 border-t border-white/10 space-y-6">
        <h2 class="text-xl sm:text-2xl font-extrabold text-white">
          {locale === 'ar' ? 'مشاريع أخرى قد تهمك' : 'Other Projects You May Like'}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-7">
          {relatedProjects.map((rel, idx) => (
            <ProjectCard project={rel} locale={locale} index={idx} />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
