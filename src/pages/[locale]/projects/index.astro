---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import CTA from '../../../components/CTA.astro';
import { UI_LABELS } from '../../../config/site';

export function getStaticPaths() {
  return [{ params: { locale: 'ar' } }, { params: { locale: 'en' } }];
}

const { locale } = Astro.params as { locale: 'ar' | 'en' };
const t = UI_LABELS[locale];

// Strictly filter published projects only (never expose draft or private)
const projects = (await getCollection('projects', ({ data }) => data.visibility === 'published')).sort(
  (a, b) => a.data.featuredOrder - b.data.featuredOrder
);

const allCategories = Array.from(new Set(projects.flatMap((p) => p.data.category)));
const allStatuses = Array.from(new Set(projects.map((p) => p.data.status)));

const categoryHumanLabels: Record<string, { ar: string; en: string }> = {
  AI: { ar: 'ذكاء اصطناعي (AI)', en: 'Artificial Intelligence (AI)' },
  Automation: { ar: 'أتمتة ذكية (Automation)', en: 'Smart Automation' },
  Web: { ar: 'تطبيقات ومنصات ويب (Web)', en: 'Web Platforms & Apps' },
  Mobile: { ar: 'تطبيقات موبايل (Mobile)', en: 'Mobile Applications' },
  Desktop: { ar: 'أنظمة سطح مكتب (Desktop)', en: 'Desktop Systems' },
  Algorithm: { ar: 'خوارزميات وحل قيود (Algorithm)', en: 'Algorithms & Scheduling' },
  API: { ar: 'خدمات وواجهات خلفية (Backend/API)', en: 'Backend & APIs' },
  CLI: { ar: 'أدوات تشغيل سريعة (CLI)', en: 'CLI Tools' },
};

const pageTitle =
  locale === 'ar'
    ? 'جميع الأعمال والمشاريع السبعة — احمد عبداللاه'
    : 'All 7 Projects & Case Studies — Ahmed Abdellah';
const pageDesc =
  locale === 'ar'
    ? 'استعرض جميع المشاريع والأنظمة السبعة: المعاناة قبل الحل، النقلة والنتيجة الحاسمة، مع بحث وتصفية فورية.'
    : 'Explore all 7 software systems: the struggle before the solution, the breakthrough, and measurable results with instant search.';
---

<BaseLayout title={pageTitle} description={pageDesc} locale={locale} currentPath={`/${locale}/projects`}>
  <section class="border-b border-white/10 py-10 sm:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs uppercase tracking-wider text-amber-400 font-bold">
        {locale === 'ar' ? 'معرض الأعمال الكامل · 7 أنظمة حقيقية' : 'Complete Portfolio · 7 Real Systems'}
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white mt-2">
        {locale === 'ar'
          ? 'المشاريع السبعة: من المعاناة والتعقيد إلى أنظمة تعمل بكفاءة'
          : 'All 7 Projects: From Operational Pain to High-Impact Systems'}
      </h1>
      <p class="text-sm sm:text-base text-slate-300 mt-3 max-w-3xl leading-relaxed">
        {locale === 'ar'
          ? 'تصفح جميع الأنظمة التي طورتها، أو ابحث مباشرة باسم المشروع أو نوع المشكلة أو التقنية.'
          : 'Browse every system I built, or filter immediately by domain, status, or keyword.'}
      </p>
    </div>
  </section>

  <!-- Interactive Filter & Search Controls -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="glass-panel rounded-2xl p-5 mb-8 space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Search Input -->
        <div>
          <label for="project-search" class="block text-xs font-bold text-slate-200 mb-1.5">
            {locale === 'ar' ? 'بحث سريع (اسم المشروع، المشكلة، التقنية)' : 'Quick Search (Project, Problem, Tech)'}
          </label>
          <input
            id="project-search"
            type="search"
            placeholder={locale === 'ar' ? 'ابحث هنا... مثل: جدول، فيديو، متجر، طبي، هاتف' : 'Search... e.g. timetable, video, store, medical, phone'}
            class="w-full px-3.5 py-2.5 rounded-xl border border-white/15 text-sm bg-[#050914]/80 text-white placeholder:text-slate-400 focus:border-blue-400"
          />
        </div>

        <!-- Category Filter -->
        <div>
          <label for="category-filter" class="block text-xs font-bold text-slate-200 mb-1.5">
            {locale === 'ar' ? 'نوع النظام' : 'System Domain'}
          </label>
          <select
            id="category-filter"
            class="w-full px-3.5 py-2.5 rounded-xl border border-white/15 text-sm bg-[#050914]/80 text-white focus:border-blue-400"
          >
            <option value="all">{locale === 'ar' ? 'جميع المجالات (7 مشاريع)' : 'All Domains (7 Projects)'}</option>
            {allCategories.map((cat) => (
              <option value={cat}>
                {categoryHumanLabels[cat] ? categoryHumanLabels[cat][locale] : cat}
              </option>
            ))}
          </select>
        </div>

        <!-- Status Filter -->
        <div>
          <label for="status-filter" class="block text-xs font-bold text-slate-200 mb-1.5">
            {locale === 'ar' ? 'حالة النظام' : 'System Status'}
          </label>
          <select
            id="status-filter"
            class="w-full px-3.5 py-2.5 rounded-xl border border-white/15 text-sm bg-[#050914]/80 text-white focus:border-blue-400"
          >
            <option value="all">{locale === 'ar' ? 'جميع الحالات' : 'All Statuses'}</option>
            {allStatuses.map((st) => (
              <option value={st}>{t.statusLabels[st]}</option>
            ))}
          </select>
        </div>
      </div>

      <div class="flex items-center justify-between text-xs text-slate-300 pt-2 border-t border-white/10">
        <span id="results-count" aria-live="polite" class="font-semibold">
          {locale === 'ar'
            ? `يعرض ${projects.length} من ${projects.length} مشاريع`
            : `Showing ${projects.length} of ${projects.length} projects`}
        </span>
        <button
          id="reset-filters"
          type="button"
          class="font-bold text-amber-300 hover:underline cursor-pointer"
        >
          {locale === 'ar' ? 'عرض الكل (إعادة ضبط)' : 'Show All (Reset)'}
        </button>
      </div>
    </div>

    <!-- Projects Grid -->
    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
      {projects.map((entry, idx) => (
        <div
          class="project-item flex"
          data-categories={entry.data.category.join(',').toLowerCase()}
          data-status={entry.data.status.toLowerCase()}
          data-search={`${entry.data.titleAr} ${entry.data.titleEn} ${entry.data.humanCategoryAr || ''} ${entry.data.humanCategoryEn || ''} ${entry.data.struggleAr || ''} ${entry.data.struggleEn || ''} ${entry.data.triumphAr || ''} ${entry.data.triumphEn || ''} ${entry.data.summaryAr} ${entry.data.summaryEn} ${entry.data.technologies.join(' ')}`.toLowerCase()}
        >
          <ProjectCard project={entry.data} locale={locale} index={idx} />
        </div>
      ))}
    </div>

    <!-- Empty Filter State -->
    <div id="empty-state" class="hidden text-center py-12 glass-panel rounded-2xl mt-6">
      <p class="text-base font-bold text-white">
        {locale === 'ar' ? 'لا توجد مشاريع تطابق البحث الحالي.' : 'No projects match the current search.'}
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <CTA locale={locale} />
  </div>

  <script is:inline define:vars={{ totalCount: projects.length, locale }}>
    const searchInput = document.getElementById('project-search');
    const catSelect = document.getElementById('category-filter');
    const statusSelect = document.getElementById('status-filter');
    const resetBtn = document.getElementById('reset-filters');
    const countLabel = document.getElementById('results-count');
    const emptyState = document.getElementById('empty-state');
    const items = Array.from(document.querySelectorAll('.project-item'));

    function applyFilters() {
      const q = (searchInput?.value || '').trim().toLowerCase();
      const cat = (catSelect?.value || 'all').toLowerCase();
      const st = (statusSelect?.value || 'all').toLowerCase();

      let visible = 0;
      items.forEach((el) => {
        const elCats = (el.getAttribute('data-categories') || '').split(',');
        const elSt = el.getAttribute('data-status') || '';
        const elSearch = el.getAttribute('data-search') || '';

        const matchQ = !q || elSearch.includes(q);
        const matchCat = cat === 'all' || elCats.includes(cat);
        const matchSt = st === 'all' || elSt === st;

        if (matchQ && matchCat && matchSt) {
          el.classList.remove('hidden');
          visible++;
        } else {
          el.classList.add('hidden');
        }
      });

      if (countLabel) {
        countLabel.textContent =
          locale === 'ar'
            ? `يعرض ${visible} من ${totalCount} مشاريع`
            : `Showing ${visible} of ${totalCount} projects`;
      }
      if (emptyState) {
        emptyState.classList.toggle('hidden', visible > 0);
      }
    }

    searchInput?.addEventListener('input', applyFilters);
    catSelect?.addEventListener('change', applyFilters);
    statusSelect?.addEventListener('change', applyFilters);
    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (catSelect) catSelect.value = 'all';
      if (statusSelect) statusSelect.value = 'all';
      applyFilters();
    });
  </script>
</BaseLayout>
