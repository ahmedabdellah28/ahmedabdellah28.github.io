---
import '../styles/global.css';
import { SITE_CONFIG } from '../config/site';
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{SITE_CONFIG.ownerNameAr} — البورتفوليو الهندسي</title>
    <meta http-equiv="refresh" content="0;url=/ar/" />
    <link rel="canonical" href="https://ahmedabdellah28.github.io/ar/" />
    <link rel="alternate" hreflang="ar" href="https://ahmedabdellah28.github.io/ar/" />
    <link rel="alternate" hreflang="en" href="https://ahmedabdellah28.github.io/en/" />
    <meta property="og:title" content={`${SITE_CONFIG.ownerNameAr} — البورتفوليو الهندسي`} />
    <meta property="og:description" content={SITE_CONFIG.taglineAr} />
    <meta property="og:url" content="https://ahmedabdellah28.github.io/" />
    <meta property="og:type" content="website" />
  </head>
  <body class="min-h-screen bg-[#0B1220] text-[#F5F7FA] flex items-center justify-center p-6">
    <div class="max-w-md w-full bg-[#182438] border border-slate-700 rounded-2xl p-8 text-center space-y-5">
      <h1 class="text-xl font-bold text-white">{SITE_CONFIG.ownerNameAr}</h1>
      <p class="text-sm text-slate-300">{SITE_CONFIG.taglineAr}</p>
      <div class="flex items-center justify-center gap-3 pt-2">
        <a href="/ar/" class="px-5 py-2.5 rounded-xl bg-[#2663EB] text-white font-semibold text-sm">
          العربية (الرئيسية)
        </a>
        <a href="/en/" class="px-5 py-2.5 rounded-xl bg-[#0B1220] text-slate-200 border border-slate-700 font-semibold text-sm">
          English
        </a>
      </div>
    </div>
  </body>
</html>
