---
import { UI_LABELS } from '../config/site';

interface Props {
  locale: 'ar' | 'en';
  heading?: string;
  body?: string;
  primaryBtnText?: string;
  primaryHref?: string;
  secondaryBtnText?: string;
  secondaryHref?: string;
}

const {
  locale,
  heading,
  body,
  primaryBtnText,
  primaryHref,
  secondaryBtnText,
  secondaryHref,
} = Astro.props;

const t = UI_LABELS[locale];
---

<section class="glass-panel-elevated relative overflow-hidden text-white rounded-3xl p-8 sm:p-12 shadow-xl">
  <div
    class="pointer-events-none absolute -top-24 -start-24 w-72 h-72 rounded-full bg-blue-600/20 blur-3xl"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -bottom-24 -end-24 w-72 h-72 rounded-full bg-amber-500/15 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="relative max-w-3xl mx-auto text-center space-y-5">
    <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/[0.06] border border-white/15 text-amber-300 font-mono text-xs">
      {locale === 'ar' ? 'متاح لمناقشة المشاريع والفرص الهندسية' : 'Open for Projects & Engineering Opportunities'}
    </span>

    <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
      {heading || t.ctaProjectHeading}
    </h2>

    <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
      {body || t.ctaProjectBody}
    </p>

    <div class="pt-3 flex flex-wrap items-center justify-center gap-3.5">
      <a
        href={primaryHref || `/${locale}/contact`}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm shadow-sm transition-colors min-h-[44px]"
      >
        <span>{primaryBtnText || t.ctaProjectBtn}</span>
      </a>
      <a
        href={secondaryHref || `/${locale}/projects`}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white/[0.06] hover:bg-white/10 text-slate-200 font-semibold text-sm border border-white/15 transition-colors min-h-[44px]"
      >
        <span>{secondaryBtnText || t.viewAllProjects}</span>
      </a>
    </div>
  </div>
</section>
