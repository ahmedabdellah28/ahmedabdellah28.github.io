---
import { UI_LABELS } from '../config/site';

interface Props {
  locale: 'ar' | 'en';
  heading?: string;
  body?: string;
  primaryBtnText?: string;
  primaryHref?: string;
  secondaryBtnText?: string;
  secondaryHref?: string;
}

const {
  locale,
  heading,
  body,
  primaryBtnText,
  primaryHref,
  secondaryBtnText,
  secondaryHref,
} = Astro.props;

const t = UI_LABELS[locale];
---

<section class="bg-gradient-to-br from-[#0B1220] via-[#182438] to-[#0B1220] text-white rounded-3xl p-8 sm:p-12 border border-slate-800 shadow-lg">
  <div class="max-w-3xl mx-auto text-center space-y-5">
    <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#2663EB]/20 border border-[#2663EB]/40 text-[#18B8A7] font-mono text-xs">
      {locale === 'ar' ? 'جاهز لمناقشة الأنظمة والمشاريع' : 'Available for Architecture & Engineering Discussions'}
    </span>

    <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
      {heading || t.ctaProjectHeading}
    </h2>

    <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
      {body || t.ctaProjectBody}
    </p>

    <div class="pt-3 flex flex-wrap items-center justify-center gap-3.5">
      <a
        href={primaryHref || `/${locale}/contact`}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#2663EB] hover:bg-blue-600 text-white font-semibold text-sm shadow-sm transition-colors"
      >
        <span>{primaryBtnText || t.ctaProjectBtn}</span>
      </a>
      <a
        href={secondaryHref || `/${locale}/expertise`}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#182438] hover:bg-slate-800 text-slate-200 font-semibold text-sm border border-slate-700 transition-colors"
      >
        <span>{secondaryBtnText || t.heroSecondaryCta}</span>
      </a>
    </div>
  </div>
</section>
