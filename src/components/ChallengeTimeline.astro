---
import { UI_LABELS } from '../config/site';

interface ChallengeItem {
  id: string;
  type: 'verified_fix' | 'preventive_design' | 'possible_risk' | 'unverified_story';
  titleAr: string;
  titleEn: string;
  problemAr: string;
  problemEn: string;
  whyImportantAr: string;
  whyImportantEn: string;
  solutionAr: string;
  solutionEn: string;
  proofRef: string;
  impactAr: string;
  impactEn: string;
  lessonAr: string;
  lessonEn: string;
}

interface Props {
  challenges: ChallengeItem[];
  locale: 'ar' | 'en';
}

const { challenges, locale } = Astro.props;
const t = UI_LABELS[locale];

const badgeColors = {
  verified_fix: 'bg-emerald-500/15 text-emerald-300 border-emerald-400/40',
  preventive_design: 'bg-blue-500/15 text-blue-300 border-blue-400/40',
  possible_risk: 'bg-amber-500/15 text-amber-300 border-amber-400/40',
  unverified_story: 'bg-slate-500/15 text-slate-300 border-slate-400/40',
};
---

<div class="space-y-6">
  {challenges.map((ch, idx) => (
    <article class="glass-panel rounded-2xl p-6 sm:p-7">
      <div class="flex items-center justify-between gap-3 flex-wrap mb-3">
        <span class:list={['px-3 py-1 rounded-full text-xs font-bold border', badgeColors[ch.type]]}>
          {t.challengeTypeLabels[ch.type]}
        </span>
        <span class="text-xs font-bold text-amber-300">
          {locale === 'ar' ? `التحدي #${idx + 1}` : `Challenge #${idx + 1}`}
        </span>
      </div>

      <h3 class="text-lg sm:text-xl font-extrabold text-white mb-5">
        {locale === 'ar' ? ch.titleAr : ch.titleEn}
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
        <div class="p-4 rounded-xl bg-rose-950/40 border border-rose-500/25">
          <h4 class="text-xs font-extrabold uppercase tracking-wider text-rose-300 mb-1.5">
            {locale === 'ar' ? '🔥 المعاناة والأزمة الواقعية' : '🔥 The Real Struggle'}
          </h4>
          <p class="text-sm text-slate-200 leading-relaxed">
            {locale === 'ar' ? ch.problemAr : ch.problemEn}
          </p>
        </div>

        <div class="p-4 rounded-xl bg-amber-950/35 border border-amber-500/25">
          <h4 class="text-xs font-extrabold uppercase tracking-wider text-amber-300 mb-1.5">
            {locale === 'ar' ? '⚠️ خطورة ترك المشكلة' : '⚠️ Business Risk'}
          </h4>
          <p class="text-sm text-slate-200 leading-relaxed">
            {locale === 'ar' ? ch.whyImportantAr : ch.whyImportantEn}
          </p>
        </div>

        <div class="p-4 rounded-xl bg-blue-950/40 border border-blue-500/25">
          <h4 class="text-xs font-extrabold uppercase tracking-wider text-blue-300 mb-1.5">
            {locale === 'ar' ? '⚡ التدخل والحل الحاسم' : '⚡ Breakthrough Solution'}
          </h4>
          <p class="text-sm text-slate-200 leading-relaxed">
            {locale === 'ar' ? ch.solutionAr : ch.solutionEn}
          </p>
        </div>

        <div class="p-4 rounded-xl bg-emerald-950/40 border border-emerald-500/25">
          <h4 class="text-xs font-extrabold uppercase tracking-wider text-emerald-300 mb-1.5">
            {locale === 'ar' ? '✅ النتيجة والأثر الفعلي' : '✅ Concrete Outcome'}
          </h4>
          <p class="text-sm text-slate-100 font-medium leading-relaxed">
            {locale === 'ar' ? ch.impactAr : ch.impactEn}
          </p>
        </div>
      </div>

      <div class="pt-3.5 border-t border-white/10 text-xs sm:text-sm text-slate-200">
        <strong class="text-amber-300">
          {locale === 'ar' ? '💡 الخلاصة العملية: ' : '💡 Key Takeaway: '}
        </strong>
        {locale === 'ar' ? ch.lessonAr : ch.lessonEn}
      </div>
    </article>
  ))}
</div>
