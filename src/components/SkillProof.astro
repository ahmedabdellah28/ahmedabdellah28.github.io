---
import type { EngineeringStrength } from '../config/skills';

interface Props {
  strength: EngineeringStrength;
  locale: 'ar' | 'en';
  projectTitlesMap: Record<string, { ar: string; en: string }>;
}

const { strength, locale, projectTitlesMap } = Astro.props;
---

<article class="reveal-item glass-panel rounded-2xl p-6 sm:p-8 flex flex-col justify-between gap-6">
  <div>
    <div class="flex items-center justify-between gap-2 flex-wrap mb-3">
      <span class="px-2.5 py-1 rounded-md bg-emerald-500/15 text-emerald-300 border border-emerald-400/30 text-xs font-bold">
        {locale === 'ar' ? 'قدرة مطبقة ومثبتة عمليًا' : 'Proven in Real Systems'}
      </span>
      <span class="text-xs font-semibold text-amber-300">
        {locale === 'ar' ? strength.proofTypeAr : strength.proofTypeEn}
      </span>
    </div>

    <h3 class="text-xl font-extrabold text-white mb-4">
      {locale === 'ar' ? strength.titleAr : strength.titleEn}
    </h3>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
      <div class="p-4 rounded-xl bg-blue-950/35 border border-blue-500/25">
        <h4 class="text-xs font-extrabold uppercase tracking-wider text-blue-300 mb-1.5">
          {locale === 'ar' ? '💡 ماذا يستفيد العميل والمشروع؟' : '💡 Practical Value for Clients'}
        </h4>
        <p class="text-sm text-slate-200 leading-relaxed">
          {locale === 'ar' ? strength.clientExplanationAr : strength.clientExplanationEn}
        </p>
      </div>

      <div class="p-4 rounded-xl bg-white/[0.04] text-slate-200 border border-white/10">
        <h4 class="text-xs font-extrabold uppercase tracking-wider text-amber-300 mb-1.5">
          {locale === 'ar' ? '⚙️ كيف نفذناها تقنيًا؟' : '⚙️ How We Engineered It'}
        </h4>
        <p class="text-sm text-slate-300 leading-relaxed">
          {locale === 'ar' ? strength.technicalExplanationAr : strength.technicalExplanationEn}
        </p>
      </div>
    </div>
  </div>

  <div class="pt-4 border-t border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex items-center gap-2 flex-wrap">
      <span class="text-xs font-bold text-slate-300">
        {locale === 'ar' ? 'شاهد التطبيق العملي في:' : 'See applied in:'}
      </span>
      {strength.supportingProjects.map((slug) => {
        const pTitle = projectTitlesMap[slug]
          ? projectTitlesMap[slug][locale]
          : slug;
        return (
          <a
            href={`/${locale}/projects/${slug}`}
            class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-blue-600/20 hover:bg-blue-600 text-blue-300 hover:text-white text-xs font-bold border border-blue-400/30 transition-colors"
          >
            <span>{pTitle}</span>
          </a>
        );
      })}
    </div>

    <details class="text-xs">
      <summary class="cursor-pointer text-slate-400 hover:text-amber-300 font-semibold select-none">
        {locale === 'ar' ? 'عرض المراجع البرمجية (للمهندسين)' : 'Code References (For Engineers)'}
      </summary>
      <div class="mt-2 flex items-center gap-1.5 flex-wrap">
        {strength.evidenceRefs.map((ref) => (
          <code class="text-[11px] font-mono px-2 py-0.5 rounded bg-[#050914] text-slate-300 border border-white/10">
            {ref}
          </code>
        ))}
      </div>
    </details>
  </div>
</article>
