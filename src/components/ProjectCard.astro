---
import { UI_LABELS } from '../config/site';

interface Props {
  project: {
    slug: string;
    titleAr: string;
    titleEn: string;
    valuePropositionAr: string;
    valuePropositionEn: string;
    summaryAr: string;
    summaryEn: string;
    category: string[];
    status: 'production' | 'functional' | 'prototype' | 'in_progress' | 'concept' | 'unknown';
    featured: boolean;
    role?: { ar: string; en: string };
    technologies: string[];
    screenshots: Array<{
      src: string;
      altAr: string;
      altEn: string;
      captionAr?: string;
      captionEn?: string;
      kind: string;
      width: number;
      height: number;
    }>;
    results: Array<{
      metric: string;
      labelAr: string;
      labelEn: string;
    }>;
    evidence: Array<{
      claimId: string;
    }>;
    graphStats?: {
      nodes: number;
      edges: number;
    };
  };
  locale: 'ar' | 'en';
  bentoWide?: boolean;
  index?: number;
}

const { project, locale, bentoWide = false, index = 0 } = Astro.props;
const t = UI_LABELS[locale];
const title = locale === 'ar' ? project.titleAr : project.titleEn;
const valueProp = locale === 'ar' ? project.valuePropositionAr : project.valuePropositionEn;
const summary = locale === 'ar' ? project.summaryAr : project.summaryEn;
const cover = project.screenshots[0];
const secondMedia = project.screenshots[1];
const statusText = t.statusLabels[project.status];
const href = `/${locale}/projects/${project.slug}`;
const revealDelay = `${Math.min(index * 70, 350)}ms`;

const statusBadgeStyles = {
  production: 'bg-emerald-500/20 text-emerald-300 border-emerald-400/40',
  functional: 'bg-blue-500/20 text-blue-300 border-blue-400/40',
  prototype: 'bg-amber-500/20 text-amber-300 border-amber-400/40',
  in_progress: 'bg-purple-500/20 text-purple-300 border-purple-400/40',
  concept: 'bg-slate-500/20 text-slate-300 border-slate-400/40',
  unknown: 'bg-slate-500/20 text-slate-300 border-slate-400/40',
};
---

<article
  style={`--reveal-delay: ${revealDelay}`}
  class:list={[
    'reveal-item spotlight-card group bg-white rounded-3xl border border-slate-200/90 shadow-xs hover:shadow-2xl hover:border-[#2663EB]/60 flex flex-col overflow-hidden',
    bentoWide ? 'lg:col-span-2 lg:grid lg:grid-cols-12' : '',
  ]}
  data-category={project.category.join(',')}
  data-status={project.status}
  data-tech={project.technologies.join(',')}
>
  <!-- Visual Preview Header (With Interactive Lightbox & Media Toggle) -->
  <div
    class:list={[
      'relative overflow-hidden bg-[#0B1220] flex flex-col justify-between',
      bentoWide ? 'lg:col-span-6 min-h-[280px] lg:min-h-full' : 'aspect-[16/10]',
    ]}
  >
    {cover && (
      <img
        id={`card-img-${project.slug}`}
        src={cover.src}
        alt={locale === 'ar' ? cover.altAr : cover.altEn}
        width={cover.width}
        height={cover.height}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover object-top group-hover:scale-[1.03] transition-transform duration-500"
      />
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-[#0B1220] via-[#0B1220]/25 to-[#0B1220]/40 pointer-events-none"></div>

    <!-- Top Floating Badges & Fullscreen Zoom Trigger -->
    <div class="relative z-10 p-3.5 flex items-center justify-between gap-2 flex-wrap">
      <div class="flex items-center gap-1.5 flex-wrap">
        <span class:list={['px-2.5 py-1 rounded-full text-[11px] font-bold border backdrop-blur-md', statusBadgeStyles[project.status]]}>
          {statusText}
        </span>
        <span class="px-2.5 py-1 rounded-full text-[11px] font-mono font-semibold bg-[#0B1220]/85 text-[#18B8A7] border border-[#18B8A7]/40 backdrop-blur-md">
          {project.evidence.length} {locale === 'ar' ? 'أدلة كود' : 'Code Proofs'}
        </span>
      </div>

      {cover && (
        <button
          type="button"
          data-lightbox-src={cover.src}
          data-lightbox-alt={locale === 'ar' ? cover.altAr : cover.altEn}
          data-lightbox-caption={locale === 'ar' ? (cover.captionAr || cover.altAr) : (cover.captionEn || cover.altEn)}
          data-lightbox-badge={title}
          class="px-2.5 py-1 rounded-lg bg-[#0B1220]/85 hover:bg-[#2663EB] text-white text-[11px] font-mono border border-slate-700 backdrop-blur-md transition-colors cursor-pointer flex items-center gap-1"
          title={locale === 'ar' ? 'تكبير الصورة بالحجم الكامل' : 'Zoom full resolution'}
        >
          <svg class="w-3.5 h-3.5 text-[#18B8A7]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16zM11 8v6M8 11h6" />
          </svg>
          <span>{locale === 'ar' ? 'معاينة' : 'Zoom'}</span>
        </button>
      )}
    </div>

    <!-- Bottom Strip: Media Switcher (if >1 visual) + Key Verified Metrics -->
    <div class="relative z-10 p-3.5 space-y-2">
      {secondMedia && (
        <div class="flex items-center gap-1.5">
          <button
            type="button"
            data-switch-target={`card-img-${project.slug}`}
            data-switch-src={cover.src}
            class="card-media-btn px-2 py-0.5 rounded bg-[#2663EB] text-white text-[10px] font-mono font-bold cursor-pointer border border-blue-400/50"
          >
            {locale === 'ar' ? '1. شاشة النظام' : '1. System View'}
          </button>
          <button
            type="button"
            data-switch-target={`card-img-${project.slug}`}
            data-switch-src={secondMedia.src}
            class="card-media-btn px-2 py-0.5 rounded bg-[#0B1220]/85 hover:bg-[#182438] text-slate-300 text-[10px] font-mono cursor-pointer border border-slate-700"
          >
            {locale === 'ar' ? '2. المخطط المعماري' : '2. Architecture'}
          </button>
        </div>
      )}

      <div class="flex items-center gap-2 overflow-x-auto">
        {project.results.slice(0, 2).map((res) => (
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#0B1220]/90 text-white text-xs border border-slate-700/80 backdrop-blur-md">
            <strong class="font-mono text-[#18B8A7]">{res.metric}</strong>
            <span class="text-slate-300 truncate max-w-[165px]">
              {locale === 'ar' ? res.labelAr : res.labelEn}
            </span>
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- Card Body -->
  <div class:list={['p-6 flex-1 flex flex-col justify-between gap-5', bentoWide ? 'lg:col-span-6 lg:p-7' : '']}>
    <div class="space-y-3">
      <!-- Categories & AST Nodes Pill -->
      <div class="flex items-center justify-between gap-2 flex-wrap">
        <div class="flex items-center gap-1.5 flex-wrap">
          {project.category.map((cat) => (
            <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 font-mono text-[11px] font-semibold uppercase tracking-wider">
              {cat}
            </span>
          ))}
        </div>
        {project.graphStats && (
          <span class="lens-badge-engineering text-[11px] font-mono px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 border border-slate-200">
            {project.graphStats.nodes.toLocaleString()} {locale === 'ar' ? 'عقدة AST' : 'AST Nodes'}
          </span>
        )}
      </div>

      <h3 class="text-lg sm:text-xl font-extrabold text-[#0B1220] group-hover:text-[#2663EB] transition-colors leading-snug">
        <a href={href} class="focus-visible:rounded-md">
          {title}
        </a>
      </h3>

      <!-- Client Value Box (Highlighted in Client Lens) -->
      <div class="lens-badge-client p-3 rounded-xl bg-[#F5F7FA] border border-slate-200/80 transition-all">
        <span class="block text-[10px] font-mono uppercase tracking-wider text-[#2663EB] font-bold mb-0.5">
          {locale === 'ar' ? 'القيمة العملية للعميل والمؤسسة' : 'Business & Client Outcome'}
        </span>
        <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
          {valueProp}
        </p>
      </div>

      {bentoWide && (
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          {summary}
        </p>
      )}
    </div>

    <div class="pt-3 border-t border-slate-100 flex flex-col gap-3.5">
      <!-- HR & Tech Stack Strip (Highlighted in HR Lens) -->
      <div class="lens-badge-hr flex items-center gap-1.5 flex-wrap p-1.5 -m-1.5 rounded-xl border border-transparent transition-all">
        {project.technologies.slice(0, bentoWide ? 6 : 4).map((tech) => (
          <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-md bg-white text-[#182438] border border-slate-200 shadow-2xs">
            {tech}
          </span>
        ))}
        {project.technologies.length > (bentoWide ? 6 : 4) && (
          <span class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-slate-100 text-slate-500">
            +{project.technologies.length - (bentoWide ? 6 : 4)}
          </span>
        )}
      </div>

      <!-- Action Link -->
      <a
        href={href}
        class="inline-flex items-center justify-between w-full px-4 py-2.5 rounded-xl bg-[#0B1220] group-hover:bg-[#2663EB] text-white font-semibold text-xs sm:text-sm transition-colors shadow-xs"
      >
        <span>{t.readCaseStudy}</span>
        <svg
          class:list={['w-4 h-4 transition-transform', locale === 'ar' ? 'rotate-180 group-hover:-translate-x-1' : 'group-hover:translate-x-1']}
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </div>
</article>
