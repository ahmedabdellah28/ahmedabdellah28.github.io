---
import { UI_LABELS } from '../config/site';

interface Props {
  project: {
    slug: string;
    titleAr: string;
    titleEn: string;
    valuePropositionAr: string;
    valuePropositionEn: string;
    summaryAr: string;
    summaryEn: string;
    category: string[];
    status: 'production' | 'functional' | 'prototype' | 'in_progress' | 'concept' | 'unknown';
    featured: boolean;
    technologies: string[];
    screenshots: Array<{
      src: string;
      altAr: string;
      altEn: string;
      captionAr?: string;
      captionEn?: string;
      kind: string;
      width: number;
      height: number;
    }>;
    results: Array<{
      metric: string;
      labelAr: string;
      labelEn: string;
    }>;
  };
  locale: 'ar' | 'en';
  index?: number;
}

const { project, locale, index = 0 } = Astro.props;
const t = UI_LABELS[locale];
const title = locale === 'ar' ? project.titleAr : project.titleEn;
const valueProp = locale === 'ar' ? project.valuePropositionAr : project.valuePropositionEn;
const cover = project.screenshots[0];
const secondMedia =
  project.screenshots.find((s, i) => i > 0 && s.kind === 'architecture_diagram') ||
  project.screenshots[1];
const statusText = t.statusLabels[project.status];
const href = `/${locale}/projects/${project.slug}`;
const revealDelay = `${Math.min(index * 60, 240)}ms`;
const imgId = `card-img-${project.slug}`;

const statusBadgeStyles = {
  production: 'bg-emerald-500/20 text-emerald-300 border-emerald-400/40',
  functional: 'bg-blue-500/20 text-blue-300 border-blue-400/40',
  prototype: 'bg-amber-500/20 text-amber-300 border-amber-400/40',
  in_progress: 'bg-purple-500/20 text-purple-300 border-purple-400/40',
  concept: 'bg-slate-500/20 text-slate-300 border-slate-400/40',
  unknown: 'bg-slate-500/20 text-slate-300 border-slate-400/40',
};

const coverAlt = cover ? (locale === 'ar' ? cover.altAr : cover.altEn) : title;
const coverCap = cover ? (locale === 'ar' ? (cover.captionAr || cover.altAr) : (cover.captionEn || cover.altEn)) : title;
const secondAlt = secondMedia ? (locale === 'ar' ? secondMedia.altAr : secondMedia.altEn) : title;
const secondCap = secondMedia ? (locale === 'ar' ? (secondMedia.captionAr || secondMedia.altAr) : (secondMedia.captionEn || secondMedia.altEn)) : title;
---

<article
  style={`--reveal-delay: ${revealDelay}`}
  class="reveal-item interactive-card glass-panel group rounded-2xl flex flex-col overflow-hidden"
  data-category={project.category.join(',')}
  data-status={project.status}
  data-tech={project.technologies.join(',')}
>
  <!-- Visual Header with Synchronized Media Toggle & Zoom -->
  <div class="relative overflow-hidden bg-[#050914] aspect-[16/10] flex flex-col justify-between border-b border-white/10">
    {cover && (
      <img
        id={imgId}
        src={cover.src}
        alt={coverAlt}
        width={cover.width}
        height={cover.height}
        loading="lazy"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover object-top group-hover:scale-[1.02] transition-transform duration-300"
      />
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-[#050914]/90 via-transparent to-[#050914]/55 pointer-events-none"></div>

    <!-- Top Status Badge & Synchronized Lightbox Zoom Button -->
    <div class="relative z-10 p-3.5 flex items-center justify-between gap-2">
      <span class:list={['px-2.5 py-1 rounded-full text-[11px] font-bold border backdrop-blur-md', statusBadgeStyles[project.status]]}>
        {statusText}
      </span>

      {cover && (
        <button
          id={`zoom-${imgId}`}
          type="button"
          data-lightbox-src={cover.src}
          data-lightbox-alt={coverAlt}
          data-lightbox-caption={coverCap}
          data-lightbox-badge={title}
          class="px-2.5 py-1 rounded-lg bg-[#050914]/85 hover:bg-blue-600 text-white text-[11px] font-mono border border-white/15 backdrop-blur-md transition-colors cursor-pointer flex items-center gap-1 min-h-[32px]"
          aria-label={locale === 'ar' ? `تكبير صورة ${title}` : `Zoom image for ${title}`}
        >
          <svg class="w-3.5 h-3.5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16zM11 8v6M8 11h6" />
          </svg>
          <span>{locale === 'ar' ? 'تكبير' : 'Zoom'}</span>
        </button>
      )}
    </div>

    <!-- Bottom Synchronized Media Switcher (Updates img + alt + zoom modal together) -->
    {secondMedia && cover && (
      <div class="relative z-10 p-3 flex items-center gap-1.5">
        <button
          type="button"
          aria-pressed="true"
          data-switch-target={imgId}
          data-switch-src={cover.src}
          data-switch-alt={coverAlt}
          data-switch-caption={coverCap}
          data-switch-width={String(cover.width)}
          data-switch-height={String(cover.height)}
          class="card-media-btn px-2.5 py-1 rounded-lg bg-blue-600 text-white text-[11px] font-mono font-semibold cursor-pointer border border-blue-400 transition-colors"
        >
          {locale === 'ar' ? 'معاينة النظام' : 'System View'}
        </button>
        <button
          type="button"
          aria-pressed="false"
          data-switch-target={imgId}
          data-switch-src={secondMedia.src}
          data-switch-alt={secondAlt}
          data-switch-caption={secondCap}
          data-switch-width={String(secondMedia.width)}
          data-switch-height={String(secondMedia.height)}
          class="card-media-btn px-2.5 py-1 rounded-lg bg-[#050914]/85 hover:bg-white/10 text-slate-300 text-[11px] font-mono cursor-pointer border border-white/15 transition-colors"
        >
          {locale === 'ar' ? 'المخطط المعماري' : 'Architecture'}
        </button>
      </div>
    )}
  </div>

  <!-- Card Body: Clean Title, 1-Sentence Value, 2-4 Tech Tags, & CTA -->
  <div class="p-6 flex-1 flex flex-col justify-between gap-5">
    <div class="space-y-2.5">
      <div class="flex items-center gap-1.5 flex-wrap">
        {project.category.slice(0, 3).map((cat) => (
          <span class="px-2 py-0.5 rounded-md bg-white/[0.06] text-blue-300 font-mono text-[11px] font-semibold uppercase tracking-wider border border-white/10">
            {cat}
          </span>
        ))}
      </div>

      <h3 class="text-lg sm:text-xl font-extrabold text-white group-hover:text-blue-400 transition-colors leading-snug">
        <a href={href} class="focus-visible:rounded-md">
          {title}
        </a>
      </h3>

      <p class="text-sm text-slate-300 leading-relaxed">
        {valueProp}
      </p>
    </div>

    <div class="pt-4 border-t border-white/10 flex flex-col gap-3.5">
      <!-- 2–4 Key Technologies -->
      <div class="flex items-center gap-1.5 flex-wrap">
        {project.technologies.slice(0, 4).map((tech) => (
          <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-md bg-white/[0.05] text-slate-200 border border-white/10">
            {tech}
          </span>
        ))}
      </div>

      <!-- Case Study Link -->
      <a
        href={href}
        class="inline-flex items-center justify-between w-full px-4 py-2.5 rounded-xl bg-white/[0.07] group-hover:bg-blue-600 text-white font-semibold text-xs sm:text-sm border border-white/10 group-hover:border-blue-500 transition-colors min-h-[42px]"
      >
        <span>{t.readCaseStudy}</span>
        <svg
          class:list={['w-4 h-4 transition-transform', locale === 'ar' ? 'rotate-180 group-hover:-translate-x-1' : 'group-hover:translate-x-1']}
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </div>
</article>
