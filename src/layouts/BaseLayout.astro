---
import '../styles/global.css';
import { SITE_CONFIG, SITE_URL, UI_LABELS } from '../config/site';

interface Props {
  title: string;
  description: string;
  locale: 'ar' | 'en';
  currentPath?: string;
  canonicalPath?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  locale,
  currentPath = '',
  canonicalPath,
  structuredData,
} = Astro.props;

const dir = locale === 'ar' ? 'rtl' : 'ltr';
const otherLocale = locale === 'ar' ? 'en' : 'ar';
const t = UI_LABELS[locale];

// Compute language switch URL preserving internal route equivalent
const cleanSubPath = currentPath.replace(/^\/(ar|en)(\/|$)/, '/');
const switchHref = `/${otherLocale}${cleanSubPath.startsWith('/') ? cleanSubPath : '/' + cleanSubPath}`;
const siteOrigin = Astro.site ? Astro.site.origin : SITE_URL;
const canonicalUrl = `${siteOrigin}${canonicalPath || `/${locale}${cleanSubPath}`}`;
const altArUrl = `${siteOrigin}/ar${cleanSubPath}`;
const altEnUrl = `${siteOrigin}/en${cleanSubPath}`;

const navItems = [
  { href: `/${locale}/`, label: t.navHome },
  { href: `/${locale}/projects`, label: t.navProjects },
  { href: `/${locale}/expertise`, label: t.navExpertise },
  { href: `/${locale}/about`, label: t.navAbout },
  { href: `/${locale}/contact`, label: t.navContact },
];

const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  inLanguage: locale,
  name: title,
  description,
  mainEntity: {
    '@type': 'Person',
    name: locale === 'ar' ? SITE_CONFIG.ownerNameAr : SITE_CONFIG.ownerNameEn,
    jobTitle: locale === 'ar' ? SITE_CONFIG.roleTitleAr : SITE_CONFIG.roleTitleEn,
    image: `${siteOrigin}/media/profile/ahmed-abdellah.webp`,
    description: locale === 'ar' ? SITE_CONFIG.taglineAr : SITE_CONFIG.taglineEn,
    url: siteOrigin,
    sameAs: [SITE_CONFIG.contact.github],
    knowsAbout: [
      'Software Architecture',
      'AI Pipeline Engineering',
      'Mathematical Optimization (OR-Tools CP-SAT)',
      'Computer Vision (ZNCC & OCR)',
      'Flutter & Cross-Platform Systems',
      'Full-Stack TypeScript & Web Security',
    ],
  },
};
---

<!doctype html>
<html lang={locale} dir={dir} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="ar" href={altArUrl} />
    <link rel="alternate" hreflang="en" href={altEnUrl} />
    <link rel="alternate" hreflang="x-default" href={altArUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale === 'ar' ? 'ar_AR' : 'en_US'} />
    <meta property="og:image" content={`${siteOrigin}/media/profile/ahmed-abdellah.webp`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteOrigin}/media/profile/ahmed-abdellah.webp`} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData || defaultSchema)} />
    <script is:inline>
      document.documentElement.classList.add('js-enabled');
    </script>
  </head>
  <body class="min-h-screen flex flex-col text-[#F8FAFC] antialiased selection:bg-[#3B82F6] selection:text-white">
    <!-- Fixed Full-Viewport Studio Portrait Gradient Backdrop -->
    <div class="studio-portrait-backdrop" aria-hidden="true"></div>

    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:start-3 focus:z-50 focus:bg-[#3B82F6] focus:text-white focus:px-4 focus:py-2.5 focus:rounded-xl focus:shadow-lg font-bold"
    >
      {locale === 'ar' ? 'تخطي إلى المحتوى الرئيسي' : 'Skip to main content'}
    </a>

    <!-- Top Glassmorphic Navigation Header -->
    <header class="sticky top-0 z-40 bg-[#050914]/85 backdrop-blur-xl border-b border-white/10 text-[#F8FAFC]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3">
        <!-- Brand Identity -->
        <a
          href={`/${locale}/`}
          class="flex items-center gap-3 group focus-visible:rounded-xl"
          aria-label={locale === 'ar' ? SITE_CONFIG.ownerNameAr : SITE_CONFIG.ownerNameEn}
        >
          <div class="relative shrink-0">
            <img
              src="/media/profile/ahmed-abdellah-thumb.webp"
              alt={locale === 'ar' ? 'احمد عبداللاه' : 'Ahmed Abdellah'}
              width="40"
              height="40"
              class="w-10 h-10 rounded-full object-cover border border-blue-400/60 group-hover:border-amber-400 transition-colors shadow-sm"
            />
          </div>
          <div class="flex flex-col">
            <span class="font-extrabold text-sm sm:text-base tracking-tight text-white group-hover:text-blue-400 transition-colors">
              {locale === 'ar' ? SITE_CONFIG.ownerNameAr : SITE_CONFIG.ownerNameEn}
            </span>
            <span class="text-[11px] text-slate-400 hidden sm:inline">
              {locale === 'ar' ? 'تطبيقات · ذكاء اصطناعي · أتمتة' : 'Software · AI · Automation'}
            </span>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <nav
          aria-label={locale === 'ar' ? 'التنقل الرئيسي' : 'Primary Navigation'}
          class="hidden md:flex items-center gap-1 bg-white/[0.04] p-1 rounded-xl border border-white/10"
        >
          {navItems.map((item) => {
            const isActive =
              currentPath === item.href ||
              (item.href !== `/${locale}/` && currentPath.startsWith(item.href));
            return (
              <a
                href={item.href}
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'px-3.5 py-1.5 rounded-lg text-xs lg:text-sm font-semibold transition-colors',
                  isActive
                    ? 'bg-gradient-to-r from-blue-600 to-blue-500 text-white shadow-xs'
                    : 'text-slate-300 hover:text-white hover:bg-white/[0.06]',
                ]}
              >
                {item.label}
              </a>
            );
          })}
        </nav>

        <!-- Actions: Language Switcher & Mobile Menu Button -->
        <div class="flex items-center gap-2">
          <a
            href={switchHref}
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white/[0.06] hover:bg-blue-600 text-white border border-white/15 transition-colors min-h-[40px]"
            aria-label={locale === 'ar' ? 'التبديل إلى الإنجليزية' : 'Switch language to Arabic'}
          >
            <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
            </svg>
            <span>{t.switchLang}</span>
          </a>

          <button
            id="mobile-menu-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="mobile-nav-drawer"
            aria-label={locale === 'ar' ? 'فتح القائمة' : 'Toggle navigation menu'}
            class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-xl bg-white/[0.06] hover:bg-white/10 text-white border border-white/15 transition-colors cursor-pointer"
          >
            <svg id="menu-icon-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Accessible Collapsible Mobile Navigation Drawer -->
      <nav
        id="mobile-nav-drawer"
        aria-label={locale === 'ar' ? 'قائمة الهاتف' : 'Mobile Navigation'}
        class="hidden md:hidden bg-[#070D1D]/98 border-t border-white/10 px-4 py-3 space-y-1"
      >
        {navItems.map((item) => {
          const isActive =
            currentPath === item.href ||
            (item.href !== `/${locale}/` && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'block px-4 py-2.5 rounded-xl text-sm font-semibold transition-colors',
                isActive ? 'bg-blue-600 text-white' : 'text-slate-300 hover:bg-white/[0.06] hover:text-white',
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </nav>
    </header>

    <!-- Main Page Content -->
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <!-- Accessible Global Lightbox Modal (Focus Trap, Escape, Backdrop Click, Focus Restore) -->
    <div
      id="global-lightbox"
      class="fixed inset-0 z-50 hidden bg-[#03060E]/95 backdrop-blur-xl p-4 sm:p-8 flex-col items-center justify-center"
      role="dialog"
      aria-modal="true"
      aria-labelledby="lightbox-badge"
      aria-describedby="lightbox-caption"
      tabindex="-1"
    >
      <div class="w-full max-w-6xl flex items-center justify-between gap-4 mb-3 text-white">
        <span id="lightbox-badge" class="px-3 py-1 rounded-lg bg-white/10 text-amber-300 font-mono text-xs border border-amber-400/30"></span>
        <button
          id="lightbox-close"
          type="button"
          class="px-4 py-2 rounded-xl bg-white/10 hover:bg-rose-600 text-white font-mono text-xs font-bold border border-white/20 transition-colors cursor-pointer min-h-[40px]"
        >
          {locale === 'ar' ? 'إغلاق (ESC) ✕' : 'Close (ESC) ✕'}
        </button>
      </div>

      <div class="relative flex-1 w-full max-w-6xl flex items-center justify-center overflow-hidden rounded-2xl bg-[#050914] border border-white/15 p-2 sm:p-4">
        <img
          id="lightbox-img"
          src="/media/profile/ahmed-abdellah.webp"
          alt="Preview"
          class="max-h-[76vh] max-w-full w-auto h-auto object-contain rounded-lg"
        />
      </div>

      <p id="lightbox-caption" class="mt-3 max-w-4xl text-center text-xs sm:text-sm text-slate-300 leading-relaxed"></p>
    </div>

    <!-- Clean Footer -->
    <footer class="bg-[#040711]/90 backdrop-blur-lg text-slate-300 border-t border-white/10 mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <img
                src="/media/profile/ahmed-abdellah-thumb.webp"
                alt={locale === 'ar' ? SITE_CONFIG.ownerNameAr : SITE_CONFIG.ownerNameEn}
                width="38"
                height="38"
                loading="lazy"
                class="w-9 h-9 rounded-full object-cover border border-blue-400/60"
              />
              <div>
                <span class="font-bold text-white text-base block">
                  {locale === 'ar' ? SITE_CONFIG.ownerNameAr : SITE_CONFIG.ownerNameEn}
                </span>
                <span class="text-xs font-mono text-blue-400">
                  ahmedabdellah28.github.io
                </span>
              </div>
            </div>
            <p class="text-sm text-slate-400 leading-relaxed">
              {locale === 'ar' ? SITE_CONFIG.taglineAr : SITE_CONFIG.taglineEn}
            </p>
          </div>

          <div>
            <h2 class="text-xs font-mono uppercase tracking-wider text-amber-400 mb-3">
              {locale === 'ar' ? 'روابط سريعة' : 'Quick Links'}
            </h2>
            <ul class="space-y-2 text-sm">
              {navItems.map((item) => (
                <li>
                  <a href={item.href} class="text-slate-300 hover:text-white transition-colors">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="space-y-3">
            <h2 class="text-xs font-mono uppercase tracking-wider text-amber-400">
              {locale === 'ar' ? 'الحساب الرسمي على GitHub' : 'Verified GitHub Profile'}
            </h2>
            <a
              href={SITE_CONFIG.contact.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/[0.06] hover:bg-blue-600 text-white text-xs font-mono border border-white/15 transition-colors"
            >
              <span>github.com/ahmedabdellah28</span>
            </a>
            <p class="text-xs text-slate-400 leading-relaxed">
              {locale === 'ar'
                ? 'جميع المشاريع والنتائج الموثقة في هذا الموقع مبنية على كود مصدري واختبارات فعلية.'
                : 'All featured systems and engineering case studies are grounded in real source repositories and tests.'}
            </p>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4">
          <span>
            {locale === 'ar'
              ? '© احمد عبداللاه (ahmedabdellah28.github.io) — جميع الحقوق محفوظة'
              : '© Ahmed Abdellah (ahmedabdellah28.github.io) — All rights reserved'}
          </span>
          <a href={switchHref} class="text-blue-400 hover:underline font-semibold">
            {locale === 'ar' ? 'View in English' : 'النسخة العربية'}
          </a>
        </div>
      </div>
    </footer>

    <!-- Global Interactions: Mobile Menu, Scroll Reveal, Synchronized Media Toggle & Accessible Lightbox -->
    <script is:inline>
      function initPortfolioInteractions() {
        // 1. Mobile Navigation Drawer (Accessible aria-expanded + Escape)
        const menuBtn = document.getElementById('mobile-menu-toggle');
        const menuDrawer = document.getElementById('mobile-nav-drawer');
        const iconOpen = document.getElementById('menu-icon-open');
        const iconClose = document.getElementById('menu-icon-close');

        if (menuBtn && menuDrawer) {
          menuBtn.onclick = () => {
            const expanded = menuBtn.getAttribute('aria-expanded') === 'true';
            const nextState = !expanded;
            menuBtn.setAttribute('aria-expanded', String(nextState));
            menuDrawer.classList.toggle('hidden', !nextState);
            iconOpen?.classList.toggle('hidden', nextState);
            iconClose?.classList.toggle('hidden', !nextState);
          };
        }

        // 2. Modest Scroll-Reveal Observer
        const revealEls = document.querySelectorAll('.reveal-item');
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.06, rootMargin: '0px 0px -20px 0px' }
          );
          revealEls.forEach((el) => io.observe(el));
        } else {
          revealEls.forEach((el) => el.classList.add('is-visible'));
        }

        // 3. Synchronized In-Card Media Preview Switcher (Updates img src, alt, width, height AND Lightbox Zoom trigger!)
        document.querySelectorAll('[data-switch-target]').forEach((btn) => {
          btn.onclick = (e) => {
            e.preventDefault();
            e.stopPropagation();
            const targetId = btn.getAttribute('data-switch-target');
            const newSrc = btn.getAttribute('data-switch-src');
            const newAlt = btn.getAttribute('data-switch-alt');
            const newCap = btn.getAttribute('data-switch-caption');
            const newW = btn.getAttribute('data-switch-width');
            const newH = btn.getAttribute('data-switch-height');

            const imgEl = targetId ? document.getElementById(targetId) : null;
            const zoomBtn = targetId ? document.getElementById(`zoom-${targetId}`) : null;

            if (imgEl && newSrc) {
              imgEl.setAttribute('src', newSrc);
              if (newAlt) imgEl.setAttribute('alt', newAlt);
              if (newW) imgEl.setAttribute('width', newW);
              if (newH) imgEl.setAttribute('height', newH);
            }
            if (zoomBtn && newSrc) {
              zoomBtn.setAttribute('data-lightbox-src', newSrc);
              if (newAlt) zoomBtn.setAttribute('data-lightbox-alt', newAlt);
              if (newCap) zoomBtn.setAttribute('data-lightbox-caption', newCap);
            }

            const parent = btn.parentElement;
            parent?.querySelectorAll('.card-media-btn').forEach((sib) => {
              const active = sib === btn;
              sib.setAttribute('aria-pressed', String(active));
              sib.classList.toggle('bg-blue-600', active);
              sib.classList.toggle('text-white', active);
              sib.classList.toggle('border-blue-400', active);
              sib.classList.toggle('bg-[#050914]/85', !active);
              sib.classList.toggle('text-slate-300', !active);
              sib.classList.toggle('border-white/15', !active);
            });
          };
        });

        // 4. Accessible Lightbox Modal with Focus Management & Keyboard Trap
        const modal = document.getElementById('global-lightbox');
        const modalImg = document.getElementById('lightbox-img');
        const modalCap = document.getElementById('lightbox-caption');
        const modalBadge = document.getElementById('lightbox-badge');
        const closeBtn = document.getElementById('lightbox-close');
        let lastFocusedTrigger = null;

        const openLightbox = (trigger) => {
          if (!modal || !modalImg) return;
          lastFocusedTrigger = trigger;
          const src = trigger.getAttribute('data-lightbox-src');
          const alt = trigger.getAttribute('data-lightbox-alt');
          const caption = trigger.getAttribute('data-lightbox-caption');
          const badge = trigger.getAttribute('data-lightbox-badge');

          modalImg.setAttribute('src', src || '');
          modalImg.setAttribute('alt', alt || 'Preview');
          if (modalCap) modalCap.textContent = caption || alt || '';
          if (modalBadge) modalBadge.textContent = badge || 'Visual Preview';
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          document.body.style.overflow = 'hidden';
          closeBtn?.focus();
        };

        const closeLightbox = () => {
          if (!modal || modal.classList.contains('hidden')) return;
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          document.body.style.overflow = '';
          if (lastFocusedTrigger && typeof lastFocusedTrigger.focus === 'function') {
            lastFocusedTrigger.focus();
          }
        };

        document.querySelectorAll('[data-lightbox-src]').forEach((trigger) => {
          trigger.onclick = () => openLightbox(trigger);
        });

        if (closeBtn) closeBtn.onclick = closeLightbox;
        if (modal) {
          modal.onclick = (e) => {
            if (e.target === modal) closeLightbox();
          };
        }

        document.onkeydown = (e) => {
          if (e.key === 'Escape') {
            closeLightbox();
            if (menuBtn && menuBtn.getAttribute('aria-expanded') === 'true') {
              menuBtn.click();
              menuBtn.focus();
            }
          } else if (e.key === 'Tab' && modal && !modal.classList.contains('hidden')) {
            // Trap focus inside lightbox close button
            e.preventDefault();
            closeBtn?.focus();
          }
        };
      }

      initPortfolioInteractions();
      document.addEventListener('astro:after-swap', initPortfolioInteractions);
    </script>
  </body>
</html>
