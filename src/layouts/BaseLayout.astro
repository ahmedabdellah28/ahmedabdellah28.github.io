---
import '../styles/global.css';
import { SITE_CONFIG, UI_LABELS } from '../config/site';

interface Props {
  title: string;
  description: string;
  locale: 'ar' | 'en';
  currentPath?: string;
  canonicalPath?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  locale,
  currentPath = '',
  canonicalPath,
  structuredData,
} = Astro.props;

const dir = locale === 'ar' ? 'rtl' : 'ltr';
const otherLocale = locale === 'ar' ? 'en' : 'ar';
const t = UI_LABELS[locale];

// Compute language switch URL preserving internal route equivalent
const cleanSubPath = currentPath.replace(/^\/(ar|en)(\/|$)/, '/');
const switchHref = `/${otherLocale}${cleanSubPath.startsWith('/') ? cleanSubPath : '/' + cleanSubPath}`;
const siteOrigin = Astro.site ? Astro.site.origin : 'https://ahmed-abdellah.github.io';
const canonicalUrl = `${siteOrigin}${canonicalPath || `/${locale}${cleanSubPath}`}`;
const altArUrl = `${siteOrigin}/ar${cleanSubPath}`;
const altEnUrl = `${siteOrigin}/en${cleanSubPath}`;

const navItems = [
  { href: `/${locale}/`, label: t.navHome },
  { href: `/${locale}/projects`, label: t.navProjects },
  { href: `/${locale}/expertise`, label: t.navExpertise },
  { href: `/${locale}/about`, label: t.navAbout },
  { href: `/${locale}/contact`, label: t.navContact },
];

const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  inLanguage: locale,
  name: title,
  description,
  mainEntity: {
    '@type': 'Person',
    name: locale === 'ar' ? SITE_CONFIG.ownerNameAr : SITE_CONFIG.ownerNameEn,
    image: `${siteOrigin}/media/profile/ahmed-abdellah.webp`,
    description: locale === 'ar' ? SITE_CONFIG.taglineAr : SITE_CONFIG.taglineEn,
    url: siteOrigin,
    sameAs: [SITE_CONFIG.contact.github],
    knowsAbout: [
      'Software Architecture',
      'AI Pipeline Engineering',
      'Mathematical Optimization (OR-Tools CP-SAT)',
      'Computer Vision (ZNCC & OCR)',
      'Flutter & Cross-Platform Systems',
      'Full-Stack TypeScript & Web Security',
    ],
  },
};
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="ar" href={altArUrl} />
    <link rel="alternate" hreflang="en" href={altEnUrl} />
    <link rel="alternate" hreflang="x-default" href={altArUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale === 'ar' ? 'ar_AR' : 'en_US'} />
    <meta property="og:image" content={`${siteOrigin}/media/profile/ahmed-abdellah.webp`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteOrigin}/media/profile/ahmed-abdellah.webp`} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData || defaultSchema)} />
    <script is:inline>
      document.documentElement.classList.add('js-enabled');
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-[#F5F7FA] text-[#0B1220] antialiased selection:bg-[#2663EB] selection:text-white">
    <!-- Top Reading Progress Indicator -->
    <div
      id="scroll-progress"
      class="fixed top-0 inset-x-0 h-1 bg-gradient-to-r from-[#2663EB] via-[#18B8A7] to-[#60A5FA] z-50 origin-left scale-x-0 transition-transform duration-75"
      aria-hidden="true"
    ></div>

    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:start-3 focus:z-50 focus:bg-[#0B1220] focus:text-white focus:px-4 focus:py-2.5 focus:rounded-lg focus:shadow-lg"
    >
      {locale === 'ar' ? 'تخطي إلى المحتوى الرئيسي' : 'Skip to main content'}
    </a>

    <!-- Top Glassmorphic Navigation Header -->
    <header class="sticky top-0 z-40 bg-[#0B1220]/90 backdrop-blur-xl border-b border-slate-800/80 text-[#F5F7FA] shadow-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-18 flex items-center justify-between gap-4">
        <a
          href={`/${locale}/`}
          class="flex items-center gap-3 group focus-visible:rounded-xl"
          aria-label={locale === 'ar' ? SITE_CONFIG.ownerNameAr : SITE_CONFIG.ownerNameEn}
        >
          <div class="relative shrink-0">
            <img
              src="/media/profile/ahmed-abdellah-thumb.webp"
              alt={locale === 'ar' ? 'صورة أحمد عبد الله' : 'Ahmed Abdellah Portrait'}
              width="42"
              height="42"
              class="w-10 h-10 rounded-full object-cover border-2 border-[#2663EB] group-hover:border-[#18B8A7] transition-colors shadow-sm"
            />
            <span
              class="absolute -bottom-0.5 -end-0.5 w-3 h-3 rounded-full bg-[#18B8A7] ring-2 ring-[#0B1220]"
              title={locale === 'ar' ? 'متاح للمشاريع والأدوار الهندسية' : 'Available for Projects & Engineering Roles'}
            ></span>
          </div>
          <div class="flex flex-col">
            <span class="font-extrabold text-sm sm:text-base tracking-tight text-white group-hover:text-[#18B8A7] transition-colors">
              {locale === 'ar' ? 'أحمد عبد الله' : 'Ahmed Abdellah'}
            </span>
            <span class="text-[11px] font-mono text-slate-400 hidden sm:inline">
              {locale === 'ar' ? 'معماري أنظمة ذكية وأتمتة' : 'Systems Architect & AI Engineer'}
            </span>
          </div>
        </a>

        <nav
          aria-label={locale === 'ar' ? 'التنقل الرئيسي' : 'Primary Navigation'}
          class="hidden md:flex items-center gap-1 bg-[#182438]/70 p-1.5 rounded-2xl border border-slate-800"
        >
          {navItems.map((item) => {
            const isActive =
              currentPath === item.href ||
              (item.href !== `/${locale}/` && currentPath.startsWith(item.href));
            return (
              <a
                href={item.href}
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'px-3.5 py-1.5 rounded-xl text-xs lg:text-sm font-semibold transition-all duration-200',
                  isActive
                    ? 'bg-gradient-to-r from-[#2663EB] to-[#1D4ED8] text-white shadow-xs'
                    : 'text-slate-300 hover:text-white hover:bg-[#0B1220]/50',
                ]}
              >
                {item.label}
              </a>
            );
          })}
        </nav>

        <div class="flex items-center gap-2.5">
          <a
            href={`/${locale}/contact`}
            class="hidden lg:inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold bg-[#18B8A7]/15 hover:bg-[#18B8A7] text-[#18B8A7] hover:text-[#0B1220] border border-[#18B8A7]/40 transition-all"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
            <span>{locale === 'ar' ? 'تواصل الآن' : 'Hire / Discuss'}</span>
          </a>

          <a
            href={switchHref}
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-[#182438] hover:bg-[#2663EB] text-white border border-slate-700 transition-colors"
            aria-label={locale === 'ar' ? 'التبديل إلى الإنجليزية' : 'Switch language to Arabic'}
          >
            <svg class="w-4 h-4 text-[#18B8A7]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
            </svg>
            <span>{t.switchLang}</span>
          </a>
        </div>
      </div>

      <!-- Mobile Horizontal Navigation Bar -->
      <nav
        aria-label={locale === 'ar' ? 'التنقل للهواتف' : 'Mobile Navigation'}
        class="md:hidden flex items-center gap-1.5 overflow-x-auto px-4 py-2 bg-[#182438]/95 border-t border-slate-800 text-xs"
      >
        {navItems.map((item) => {
          const isActive =
            currentPath === item.href ||
            (item.href !== `/${locale}/` && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class:list={[
                'whitespace-nowrap px-3 py-1.5 rounded-lg font-semibold transition-colors',
                isActive ? 'bg-[#2663EB] text-white' : 'text-slate-300 hover:text-white',
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </nav>
    </header>

    <!-- Main Page Content -->
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <!-- Global Interactive Lightbox Modal for Screenshots & Architecture Diagrams -->
    <div
      id="global-lightbox"
      class="fixed inset-0 z-50 hidden bg-[#0B1220]/95 backdrop-blur-xl p-4 sm:p-8 flex-col items-center justify-center"
      role="dialog"
      aria-modal="true"
      aria-label={locale === 'ar' ? 'معاينة الصورة بالحجم الكامل' : 'Full-resolution visual preview'}
    >
      <div class="w-full max-w-6xl flex items-center justify-between gap-4 mb-3 text-white">
        <div class="flex items-center gap-2">
          <span id="lightbox-badge" class="px-2.5 py-1 rounded-md bg-[#182438] text-[#18B8A7] font-mono text-xs border border-[#18B8A7]/30"></span>
        </div>
        <button
          id="lightbox-close"
          type="button"
          class="px-3.5 py-1.5 rounded-xl bg-[#182438] hover:bg-rose-600 text-white font-mono text-xs font-bold border border-slate-700 transition-colors cursor-pointer"
        >
          {locale === 'ar' ? 'إغلاق (ESC) ✕' : 'Close (ESC) ✕'}
        </button>
      </div>

      <div class="relative flex-1 w-full max-w-6xl flex items-center justify-center overflow-hidden rounded-2xl bg-[#070C17] border border-slate-800 p-2 sm:p-4">
        <img
          id="lightbox-img"
          src="/media/profile/ahmed-abdellah.webp"
          alt="Preview"
          class="max-h-[78vh] max-w-full w-auto h-auto object-contain rounded-lg"
        />
      </div>

      <p id="lightbox-caption" class="mt-3 max-w-4xl text-center text-xs sm:text-sm text-slate-300 leading-relaxed"></p>
    </div>

    <!-- Footer -->
    <footer class="bg-[#0B1220] text-slate-300 border-t border-[#182438] mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <img
                src="/media/profile/ahmed-abdellah-thumb.webp"
                alt={locale === 'ar' ? 'أحمد عبد الله' : 'Ahmed Abdellah'}
                width="38"
                height="38"
                loading="lazy"
                class="w-9 h-9 rounded-full object-cover border border-[#18B8A7]"
              />
              <div>
                <span class="font-bold text-white text-base block">
                  {locale === 'ar' ? 'أحمد عبد الله' : 'Ahmed Abdellah'}
                </span>
                <span class="text-xs font-mono text-[#18B8A7]">
                  ahmed-abdellah.github.io
                </span>
              </div>
            </div>
            <p class="text-sm text-slate-400 leading-relaxed">
              {locale === 'ar' ? SITE_CONFIG.taglineAr : SITE_CONFIG.taglineEn}
            </p>
          </div>

          <div>
            <h2 class="text-xs font-mono uppercase tracking-wider text-[#18B8A7] mb-3">
              {locale === 'ar' ? 'خريطة البورتفوليو' : 'Portfolio Navigation'}
            </h2>
            <ul class="space-y-2 text-sm">
              {navItems.map((item) => (
                <li>
                  <a href={item.href} class="text-slate-400 hover:text-white transition-colors">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="bg-[#182438] rounded-2xl p-5 border border-slate-800">
            <h2 class="text-xs font-mono uppercase tracking-wider text-[#18B8A7] mb-2">
              {locale === 'ar' ? 'معيار الصدق والأدلة (Graph-First)' : 'Graph-First Verification Standard'}
            </h2>
            <p class="text-xs text-slate-300 leading-relaxed">
              {locale === 'ar'
                ? 'جميع المشاريع والمهارات والتحديات المعروضة في هذا الموقع مستخرجة وموثقة مباشرةً من الكود المصدري وسجلات Git والاختبارات الآلية دون أرقام مختلقة أو أسرار منشورة.'
                : 'Every project, architectural claim, and challenge story on this site is directly extracted and verified from source files, git commits, and test suites — zero fabricated metrics or exposed secrets.'}
            </p>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4">
          <span>
            {locale === 'ar'
              ? '© أحمد عبد الله — بورتفوليو هندسي مبني بـ Astro SSG وTypeScript وTailwind CSS'
              : '© Ahmed Abdellah — Engineering Portfolio built with Astro SSG, TypeScript & Tailwind CSS'}
          </span>
          <div class="flex items-center gap-4 font-mono">
            <span>7 {locale === 'ar' ? 'مشاريع مفحوصة' : 'Audited Systems'}</span>
            <span>·</span>
            <span>60,137 {locale === 'ar' ? 'عقدة برمجية' : 'AST Nodes'}</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Global 2027 Interactive Choreography Script (Scroll Progress, Reveal, Spotlight & Lightbox) -->
    <script is:inline>
      function initPortfolioInteractions() {
        // 1. Scroll Progress Bar
        const progressBar = document.getElementById('scroll-progress');
        const updateProgress = () => {
          if (!progressBar) return;
          const scrollTop = window.scrollY || document.documentElement.scrollTop;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const pct = docHeight > 0 ? Math.min(1, Math.max(0, scrollTop / docHeight)) : 0;
          progressBar.style.transform = `scaleX(${pct})`;
        };
        window.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();

        // 2. Scroll Reveal Observer
        const revealEls = document.querySelectorAll('.reveal-item');
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.08, rootMargin: '0px 0px -30px 0px' }
          );
          revealEls.forEach((el) => io.observe(el));
        } else {
          revealEls.forEach((el) => el.classList.add('is-visible'));
        }

        // 3. Mouse Spotlight Tracking on Cards
        document.querySelectorAll('.spotlight-card').forEach((card) => {
          card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
            card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
          });
        });

        // 3b. In-Card Media Preview Switcher (Screenshot <-> Architecture Diagram)
        document.querySelectorAll('[data-switch-target]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const targetId = btn.getAttribute('data-switch-target');
            const newSrc = btn.getAttribute('data-switch-src');
            const imgEl = targetId ? document.getElementById(targetId) : null;
            if (imgEl && newSrc) {
              imgEl.setAttribute('src', newSrc);
              const parent = btn.parentElement;
              parent?.querySelectorAll('.card-media-btn').forEach((sib) => {
                const active = sib === btn;
                sib.classList.toggle('bg-[#2663EB]', active);
                sib.classList.toggle('text-white', active);
                sib.classList.toggle('bg-[#0B1220]/85', !active);
                sib.classList.toggle('text-slate-300', !active);
              });
            }
          });
        });

        // 4. Interactive Lightbox Modal
        const modal = document.getElementById('global-lightbox');
        const modalImg = document.getElementById('lightbox-img');
        const modalCap = document.getElementById('lightbox-caption');
        const modalBadge = document.getElementById('lightbox-badge');
        const closeBtn = document.getElementById('lightbox-close');

        const openLightbox = (src, alt, caption, badge) => {
          if (!modal || !modalImg) return;
          modalImg.setAttribute('src', src);
          modalImg.setAttribute('alt', alt || 'Preview');
          if (modalCap) modalCap.textContent = caption || alt || '';
          if (modalBadge) modalBadge.textContent = badge || 'Visual Proof';
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          document.body.style.overflow = 'hidden';
        };

        const closeLightbox = () => {
          if (!modal) return;
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          document.body.style.overflow = '';
        };

        document.querySelectorAll('[data-lightbox-src]').forEach((trigger) => {
          trigger.addEventListener('click', () => {
            openLightbox(
              trigger.getAttribute('data-lightbox-src'),
              trigger.getAttribute('data-lightbox-alt'),
              trigger.getAttribute('data-lightbox-caption'),
              trigger.getAttribute('data-lightbox-badge')
            );
          });
        });

        closeBtn?.addEventListener('click', closeLightbox);
        modal?.addEventListener('click', (e) => {
          if (e.target === modal) closeLightbox();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeLightbox();
        });
      }

      initPortfolioInteractions();
      document.addEventListener('astro:after-swap', initPortfolioInteractions);
    </script>
  </body>
</html>
